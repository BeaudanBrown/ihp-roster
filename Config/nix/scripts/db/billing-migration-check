#!/usr/bin/env bash
set -euo pipefail
umask 077

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    cat <<'EOF'
Usage: billing-migration-check

Rehearses billing revision 1784761930 from its exact historical predecessor
through the shared candidate-pinned IHP migration harness, then verifies
synthetic predecessor-row preservation.
EOF
    exit 0
fi
[[ "$#" -eq 0 ]] || {
    echo "billing-migration-check: no arguments expected" >&2
    exit 64
}

for required_command in git jq migration-rehearsal mktemp test-postgres; do
    command -v "$required_command" >/dev/null 2>&1 || {
        echo "billing-migration-check: required command is unavailable: $required_command" >&2
        exit 69
    }
done

source_repo="$(git rev-parse --show-toplevel 2>/dev/null || true)"
[ -n "$source_repo" ] || {
    echo "billing-migration-check: run from an ihp-roster checkout" >&2
    exit 66
}
source_repo="$(readlink -f "$source_repo")"
billing_introduction="d4e57a2d57dcadd7364bcd57166fe96ba7645bff"
billing_predecessor="f568e0036d1bce54c61b37fda3a3e59516a7d7fc"

if [ "$(git -C "$source_repo" rev-parse "$billing_introduction^")" != "$billing_predecessor" ]; then
    echo "billing-migration-check: pinned billing history is unavailable or inconsistent" >&2
    exit 65
fi
if ! git -C "$source_repo" diff --quiet "$billing_introduction" -- \
    Application/Migration/1784761930.sql; then
    echo "billing-migration-check: billing migration differs from its reviewed introduction" >&2
    exit 65
fi

fixture_root="$(mktemp -d)"
fixture_repo="$fixture_root/repository"
mkdir -p "$fixture_repo/Application/Migration/Rehearsal/1784761930" \
    "$fixture_repo/Config/nix/flake" "$fixture_repo/Config/nix/scripts/db"

cleanup() {
    env -u DATABASE_URL -u PGHOST -u PGPORT -u PGDATABASE -u PGUSER \
        TEST_POSTGRES_MODE=managed \
        TEST_POSTGRES_PROFILE=migration-rehearsal \
        TEST_POSTGRES_REPO_ROOT="$fixture_repo" \
        test-postgres stop >/dev/null 2>&1 || true
    rm -rf "$fixture_root"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

git -C "$source_repo" show "$billing_predecessor:flake.lock" \
    > "$fixture_repo/flake.lock"
cp "$source_repo/Config/nix/scripts/db/test-postgres" \
    "$fixture_repo/Config/nix/scripts/db/test-postgres"
printf '{}\n' > "$fixture_repo/Config/nix/flake/scripts.nix"
ihp_url="$(jq -r '.nodes.ihp.locked.url' "$source_repo/flake.lock")"
ihp_revision="$(jq -r '.nodes.ihp.locked.rev' "$source_repo/flake.lock")"
cat > "$fixture_repo/flake.nix" <<NIX
{
    inputs.ihp.url = "git+${ihp_url}?rev=${ihp_revision}&submodules=1";
    outputs = { self, ihp }: { };
}
NIX
printf '.pi/\n' > "$fixture_repo/.gitignore"
git -C "$source_repo" show "$billing_predecessor:Application/Schema.sql" \
    > "$fixture_repo/Application/Schema.sql"
while IFS= read -r migration_path; do
    case "${migration_path##*/}" in
        [0-9]*.sql)
            mkdir -p "$fixture_repo/$(dirname "$migration_path")"
            git -C "$source_repo" show "$billing_predecessor:$migration_path" \
                > "$fixture_repo/$migration_path"
            ;;
    esac
done < <(git -C "$source_repo" ls-tree -r --name-only "$billing_predecessor" -- Application/Migration)

git -C "$fixture_repo" init -q
git -C "$fixture_repo" config user.name 'Billing Migration Check'
git -C "$fixture_repo" config user.email 'billing-migration-check@example.invalid'
git -C "$fixture_repo" add .
git -C "$fixture_repo" commit -qm 'billing predecessor'
fixture_predecessor="$(git -C "$fixture_repo" rev-parse HEAD)"

# The focused candidate runs with the current checkout's pinned IHP runner.
cp "$source_repo/flake.lock" "$fixture_repo/flake.lock"
cp "$source_repo/Application/Migration/1784761930.sql" \
    "$fixture_repo/Application/Migration/1784761930.sql"
# The focused candidate schema intentionally composes the exact predecessor and
# reviewed migration SQL. This preserves PostgreSQL column ordinals while the
# upgraded side still receives the revision exclusively through IHP migrate.
printf '\n' >> "$fixture_repo/Application/Schema.sql"
cat "$fixture_repo/Application/Migration/1784761930.sql" \
    >> "$fixture_repo/Application/Schema.sql"
cp "$source_repo/Application/Migration/Rehearsal/1784761930/predecessor.sql" \
    "$fixture_repo/Application/Migration/Rehearsal/1784761930/predecessor.sql"
cp "$source_repo/Application/Migration/Rehearsal/1784761930/assert.sql" \
    "$fixture_repo/Application/Migration/Rehearsal/1784761930/assert.sql"
git -C "$fixture_repo" add .
git -C "$fixture_repo" commit -qm 'billing candidate'

(
    cd "$fixture_repo"
    env -u TEST_POSTGRES_MODE -u TEST_DB_SOCKET -u DATABASE_URL -u PGHOST \
        bash "$source_repo/Config/nix/scripts/db/migration-rehearsal" \
            --from-ref "$fixture_predecessor"
)
echo "billing-migration-check: PASS"
