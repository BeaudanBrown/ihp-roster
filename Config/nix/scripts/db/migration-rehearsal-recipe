#!/usr/bin/env bash
set -euo pipefail
umask 077

repo_root="${MIGRATION_REHEARSAL_WORKSPACE:?}"
from_ref="${MIGRATION_REHEARSAL_FROM_REF:?}"
predecessor_commit="${MIGRATION_REHEARSAL_PREDECESSOR_COMMIT:?}"
candidate_commit="${MIGRATION_REHEARSAL_CANDIDATE_COMMIT:?}"
run_dir="${MIGRATION_REHEARSAL_RUN_DIR:?}"
database="${MIGRATION_REHEARSAL_DATABASE:?}"
fresh_database="${MIGRATION_REHEARSAL_FRESH_DATABASE:?}"
socket="${MIGRATION_REHEARSAL_SOCKET:?}"
database_user="${MIGRATION_REHEARSAL_DATABASE_USER:?}"
runner="${MIGRATION_REHEARSAL_RUNNER:?}"
candidate_ihp_source="${MIGRATION_REHEARSAL_CANDIDATE_IHP_SOURCE:?}"
port=5432
setup_log="$run_dir/setup.log"
migrate_log="$run_dir/migrate.log"
fixture_log="$run_dir/fixture.log"
verification_log="$run_dir/verification.log"
metadata_file="$run_dir/metadata.txt"


pg_command() {
    env -u DATABASE_URL -u PGHOST -u PGPORT -u PGDATABASE -u PGUSER \
        -u PGSERVICE -u PGPASSFILE -u PGPASSWORD -u PGOPTIONS \
        "$@" -h "$socket" -p "$port" -U "$database_user"
}

bounded_log() {
    local log_file="$1"
    [ -s "$log_file" ] || return 0
    echo "--- bounded failure log ---" >&2
    tail -c 65536 "$log_file" >&2
    echo >&2
    echo "--- end failure log ---" >&2
}

sanitize_migrate_failure() {
    local runner_status="$1"
    local sqlstate
    sqlstate="$(grep -Eo '(sqlState = |ServerError )"[0-9A-Z]{5}"' "$migrate_log" | head -n 1 | grep -Eo '[0-9A-Z]{5}' || true)"
    {
        printf 'runner_exit_status=%s\n' "$runner_status"
        printf 'server_sqlstate=%s\n' "${sqlstate:-unavailable}"
    } > "$migrate_log.sanitized"
    mv "$migrate_log.sanitized" "$migrate_log"
}

# Materialize predecessor-owned inputs without checking out or mutating either tree.
git show "$predecessor_commit:Application/Schema.sql" > "$run_dir/ApplicationSchema.sql"
git show "$predecessor_commit:flake.lock" > "$run_dir/predecessor-flake.lock"

candidate_ihp_revision="$(jq -r '.nodes.ihp.locked.rev // "unknown"' flake.lock)"
predecessor_ihp_revision="$(jq -r '.nodes.ihp.locked.rev // "unknown"' "$run_dir/predecessor-flake.lock")"
candidate_ihp_lock="$(jq -cS '.nodes.ihp.locked' flake.lock)"
predecessor_ihp_lock="$(jq -cS '.nodes.ihp.locked' "$run_dir/predecessor-flake.lock")"
ihp_schema=""
if [ "$predecessor_ihp_lock" = "$candidate_ihp_lock" ]; then
    ihp_source="$candidate_ihp_source"
else
    if [ "$predecessor_ihp_lock" = "null" ]; then
        echo "migration-rehearsal: predecessor has no locked IHP source" >&2
        exit 65
    fi
    nix_expression="(builtins.fetchTree (builtins.fromJSON $(printf '%s' "$predecessor_ihp_lock" | jq -Rs .))).outPath"
    ihp_source="$(nix eval --raw --impure --expr "$nix_expression" 2>>"$setup_log")" || {
        echo "migration-rehearsal: failed to resolve the exact predecessor IHP source" >&2
        bounded_log "$setup_log"
        exit 1
    }
fi
ihp_schema="$ihp_source/ihp-ide/data/IHPSchema.sql"
[ -f "$ihp_schema" ] || {
    echo "migration-rehearsal: predecessor IHP schema is unavailable: $ihp_schema" >&2
    exit 65
}

mapfile -t predecessor_revisions < <(
    git ls-tree -r --name-only "$predecessor_commit" -- Application/Migration \
        | awk -F/ '$NF ~ /^[0-9]+.*[.]sql$/ { name=$NF; sub(/[^0-9].*$/, "", name); print name + 0 }' \
        | sort -n -u
)
mapfile -t candidate_revisions < <(
    find Application/Migration -maxdepth 1 -type f -name '*.sql' -printf '%f\n' \
        | awk '/^[0-9]+.*[.]sql$/ { name=$0; sub(/[^0-9].*$/, "", name); print name + 0 }' \
        | sort -n -u
)

server_version="$(pg_command psql -d postgres -X -qAt -v ON_ERROR_STOP=1 -c 'SHOW server_version')"

{
    printf 'predecessor_ref=%s\n' "$from_ref"
    printf 'predecessor_commit=%s\n' "$predecessor_commit"
    printf 'candidate_commit=%s\n' "$candidate_commit"
    printf 'postgres_version=%s\n' "$server_version"
    printf 'ihp_revision=%s\n' "$candidate_ihp_revision"
    printf 'predecessor_ihp_revision=%s\n' "$predecessor_ihp_revision"
    printf 'runner=%s\n' "$runner"
    printf 'database=%s\n' "$database"
} | tee "$metadata_file"

if ! pg_command psql -d "$database" -X -q -v ON_ERROR_STOP=1 -f "$ihp_schema" >>"$setup_log" 2>&1 \
    || ! pg_command psql -d "$database" -X -q -v ON_ERROR_STOP=1 -f "$run_dir/ApplicationSchema.sql" >>"$setup_log" 2>&1; then
    echo "migration-rehearsal: failed to load predecessor IHP/application schema" >&2
    bounded_log "$setup_log"
    exit 1
fi

{
    echo 'CREATE TABLE IF NOT EXISTS schema_migrations (revision BIGINT NOT NULL UNIQUE);'
    for revision in "${predecessor_revisions[@]}"; do
        printf 'INSERT INTO schema_migrations (revision) VALUES (%s) ON CONFLICT DO NOTHING;\n' "$revision"
    done
} > "$run_dir/schema-migrations.sql"
if ! pg_command psql -d "$database" -X -q -v ON_ERROR_STOP=1 -f "$run_dir/schema-migrations.sql" >>"$setup_log" 2>&1; then
    echo "migration-rehearsal: failed to reconstruct predecessor migration revisions" >&2
    bounded_log "$setup_log"
    exit 1
fi

mapfile -t before_revisions < <(
    pg_command psql -d "$database" -X -qAt -v ON_ERROR_STOP=1 -c 'SELECT revision FROM schema_migrations ORDER BY revision'
)
pending_revisions=()
for revision in "${candidate_revisions[@]}"; do
    if ! printf '%s\n' "${before_revisions[@]}" | grep -Fxq "$revision"; then
        pending_revisions+=("$revision")
    fi
done
pending_csv="$(IFS=,; echo "${pending_revisions[*]:-}")"
printf 'pending_revisions=%s\n' "${pending_csv:-none}" | tee -a "$metadata_file"

assertion_revisions=()
for revision in "${pending_revisions[@]}"; do
    rehearsal_fixture_dir="Application/Migration/Rehearsal/$revision"
    predecessor_fixture="$rehearsal_fixture_dir/predecessor.sql"
    assertion_fixture="$rehearsal_fixture_dir/assert.sql"
    if [ -e "$predecessor_fixture" ] || [ -e "$assertion_fixture" ]; then
        if [ ! -f "$predecessor_fixture" ] || [ ! -f "$assertion_fixture" ]; then
            echo "migration-rehearsal: revision $revision requires both $predecessor_fixture and $assertion_fixture" >&2
            exit 65
        fi
        if ! pg_command psql -d "$database" -X -q -v ON_ERROR_STOP=1 \
            -f "$predecessor_fixture" >/dev/null 2>"$fixture_log"; then
            printf 'predecessor_fixture=%s\nstatus=failed\n' "$predecessor_fixture" > "$fixture_log"
            echo "migration-rehearsal: predecessor fixture failed: $predecessor_fixture" >&2
            exit 1
        fi
        rm -f "$fixture_log"
        assertion_revisions+=("$revision")
        printf 'predecessor_fixture=%s\n' "$predecessor_fixture" | tee -a "$metadata_file"
    fi
done

migration_url="postgresql:///$database?host=$socket&port=$port&user=$database_user"
: > "$run_dir/migrate.ready"
env -i \
    HOME="${HOME:-/tmp}" \
    LANG="${LANG:-C.UTF-8}" \
    PATH="$PATH" \
    TZ=UTC \
    DATABASE_URL="$migration_url" \
    IHP_MIGRATION_DIR="$repo_root/Application/Migration/" \
    "$runner" >"$migrate_log" 2>&1 &
runner_pid=$!
set +e
wait "$runner_pid"
runner_status=$?
set -e
runner_pid=""
if [ "$runner_status" -ne 0 ]; then
    mapfile -t failed_state_revisions < <(
        pg_command psql -d "$database" -X -qAt -v ON_ERROR_STOP=1 -c 'SELECT revision FROM schema_migrations ORDER BY revision' 2>/dev/null || true
    )
    failed_revision="unknown"
    for revision in "${pending_revisions[@]}"; do
        if ! printf '%s\n' "${failed_state_revisions[@]}" | grep -Fxq "$revision"; then
            failed_revision="$revision"
            break
        fi
    done
    sanitize_migrate_failure "$runner_status"
    echo "migration-rehearsal: FAIL predecessor_ref=$from_ref predecessor_commit=$predecessor_commit candidate_commit=$candidate_commit failed_revision=$failed_revision" >&2
    bounded_log "$migrate_log"
    exit 1
fi
# Successful runner output is intentionally discarded: notices can contain row values.
: > "$migrate_log"

mapfile -t after_revisions < <(
    pg_command psql -d "$database" -X -qAt -v ON_ERROR_STOP=1 -c 'SELECT revision FROM schema_migrations ORDER BY revision'
)
missing_revisions=()
for revision in "${candidate_revisions[@]}"; do
    if ! printf '%s\n' "${after_revisions[@]}" | grep -Fxq "$revision"; then
        missing_revisions+=("$revision")
    fi
done
if [ "${#missing_revisions[@]}" -gt 0 ]; then
    missing_csv="$(IFS=,; echo "${missing_revisions[*]}")"
    echo "migration-rehearsal: FAIL missing_candidate_revisions=$missing_csv" >&2
    exit 1
fi

applied_revisions=()
for revision in "${after_revisions[@]}"; do
    if ! printf '%s\n' "${before_revisions[@]}" | grep -Fxq "$revision"; then
        applied_revisions+=("$revision")
    fi
done
applied_csv="$(IFS=,; echo "${applied_revisions[*]:-}")"
printf 'applied_revisions=%s\n' "${applied_csv:-none}" | tee -a "$metadata_file"

for revision in "${assertion_revisions[@]}"; do
    assertion_fixture="Application/Migration/Rehearsal/$revision/assert.sql"
    if ! pg_command psql -d "$database" -X -q -v ON_ERROR_STOP=1 \
        -f "$assertion_fixture" >/dev/null 2>"$fixture_log"; then
        printf 'assertion_file=%s\nstatus=failed\n' "$assertion_fixture" > "$fixture_log"
        echo "migration-rehearsal: focused assertion failed: $assertion_fixture" >&2
        exit 1
    fi
    rm -f "$fixture_log"
    printf 'assertion_revision=%s assertion_file=%s PASS\n' "$revision" "$assertion_fixture" \
        | tee -a "$metadata_file"
done

candidate_ihp_schema="$candidate_ihp_source/ihp-ide/data/IHPSchema.sql"
if ! pg_command psql -d "$fresh_database" -X -q -v ON_ERROR_STOP=1 \
        -f "$candidate_ihp_schema" >>"$setup_log" 2>&1 \
    || ! pg_command psql -d "$fresh_database" -X -q -v ON_ERROR_STOP=1 \
        -f Application/Schema.sql >>"$setup_log" 2>&1; then
    echo "migration-rehearsal: failed to load fresh candidate IHP/application schema" >&2
    bounded_log "$setup_log"
    exit 1
fi

normalized_schema_dump() {
    local database_name="$1"
    local output_file="$2"
    pg_command pg_dump -d "$database_name" --schema-only --no-owner --no-privileges \
        --exclude-table=schema_migrations 2>>"$verification_log" \
        | LC_ALL=C awk '
            /^\\(un)?restrict / { next }
            /^-- Dumped from database version / { next }
            /^-- Dumped by pg_dump version / { next }
            { print }
        ' > "$output_file"
}

if ! normalized_schema_dump "$fresh_database" "$run_dir/fresh-schema.dump" \
    || ! normalized_schema_dump "$database" "$run_dir/upgraded-schema.dump"; then
    echo "migration-rehearsal: failed to inspect database schemas" >&2
    bounded_log "$verification_log"
    exit 1
fi
if ! diff -U 20 --label candidate-fresh --label migrated-upgrade \
    "$run_dir/fresh-schema.dump" "$run_dir/upgraded-schema.dump" \
    > "$run_dir/schema.diff.full"; then
    head -c 65536 "$run_dir/schema.diff.full" > "$run_dir/schema.diff"
    echo "migration-rehearsal: FAIL schema_convergence=diverged (schema_migrations excluded; pg_dump headers and restrict tokens normalized)" >&2
    bounded_log "$run_dir/schema.diff"
    exit 1
fi
printf 'schema_convergence=pass\n' | tee -a "$metadata_file"
echo "migration-rehearsal: PASS predecessor=$predecessor_commit candidate=$candidate_commit applied=${applied_csv:-none} assertions=${#assertion_revisions[@]}"
