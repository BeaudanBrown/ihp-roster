#!/usr/bin/env bash
set -euo pipefail
# shellcheck source=../lib/workspace.sh
. "${BEPIS_SCRIPTS_ROOT:?}/lib/workspace.sh"
# shellcheck source=../lib/dev-db-maintenance.sh
. "${BEPIS_SCRIPTS_ROOT:?}/lib/dev-db-maintenance.sh"

bepis_workspace_configure
if [ "${BEPIS_DEV_DB_MAINTENANCE_HELD:-0}" != 1 ]; then
    launcher="$(bepis_dev_db_tooling_launcher)"
    exec "$launcher" postgres maintenance-run "$DEVENV_AGENT_STATE_DIR/database-maintenance.lock" \
        "dev-db-maintenance: another reset or seed operation is already running for this workspace" -- \
        env BEPIS_DEV_DB_MAINTENANCE_HELD=1 bash "$0" "$@"
fi
bepis_dev_db_capture_app_state
bash "${BEPIS_SCRIPTS_ROOT:?}/haskell/generated-ensure"
dev-ensure-postgres >/dev/null

if ! connection_output="$(psql -X -h "$PGHOST" -d postgres -At -v ON_ERROR_STOP=1 -c 'SELECT 1' 2>&1)"; then
    echo "dev-db-reset: PostgreSQL connection failed at $PGHOST" >&2
    echo "$connection_output" >&2
    exit 1
fi

make db
bepis_dev_db_wait_for_app_recovery
