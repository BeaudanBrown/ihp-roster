#!/usr/bin/env bash
set -euo pipefail
umask 077

usage() {
    cat <<'EOF'
Usage: migration-rehearsal --from-ref GIT_REF [--keep-failure-artifacts]

Reconstructs the predecessor schema in a uniquely named database owned by the
repository's managed test-postgres instance, runs candidate migrations through
the checkout's pinned IHP migrate binary, executes focused SQL assertions, and
compares the upgraded schema with a fresh candidate schema.

Options:
  --from-ref GIT_REF          Required predecessor commit/ref.
  --keep-failure-artifacts    Retain bounded logs under .pi/tmp on failure.
  -h, --help                  Show this help.

External PostgreSQL modes and database targets are never accepted. The database
is dropped after success, failure, or interruption.
EOF
}

from_ref=""
keep_failure_artifacts=0
while [ "$#" -gt 0 ]; do
    case "$1" in
        --from-ref)
            [ "$#" -ge 2 ] || { echo "migration-rehearsal: --from-ref requires a value" >&2; exit 64; }
            from_ref="$2"
            shift 2
            ;;
        --keep-failure-artifacts)
            keep_failure_artifacts=1
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            echo "migration-rehearsal: unknown argument: $1" >&2
            usage >&2
            exit 64
            ;;
    esac
done

[ -n "$from_ref" ] || { echo "migration-rehearsal: --from-ref is required" >&2; exit 64; }
if [ -n "${TEST_POSTGRES_MODE:-}" ] && [ "$TEST_POSTGRES_MODE" != managed ]; then
    echo "migration-rehearsal: external PostgreSQL mode is forbidden; use managed test-postgres" >&2
    exit 64
fi

for required_command in createdb diff dropdb git head jq migrate nix pg_dump psql readlink tail test-postgres; do
    command -v "$required_command" >/dev/null 2>&1 || {
        echo "migration-rehearsal: required command is unavailable: $required_command" >&2
        exit 69
    }
done

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
[ -n "$repo_root" ] || { echo "migration-rehearsal: run from an ihp-roster checkout" >&2; exit 66; }
repo_root="$(readlink -f "$repo_root")"
cd "$repo_root"

pinned_ihp_json="$(
    nix eval --json --impure --no-write-lock-file --expr '
        let flake = builtins.getFlake (toString ./.); in {
            ihpSource = flake.inputs.ihp.outPath;
            migratePackage = flake.inputs.ihp.packages.${builtins.currentSystem}.migrate.outPath;
        }
    '
)" || {
    echo "migration-rehearsal: failed to resolve the candidate-pinned IHP input" >&2
    exit 69
}
candidate_ihp_source="$(jq -r '.ihpSource' <<<"$pinned_ihp_json")"
expected_runner="$(jq -r '.migratePackage' <<<"$pinned_ihp_json")/bin/migrate"
runner="$(readlink -f "$(command -v migrate)")"
if [ "$runner" != "$expected_runner" ]; then
    echo "migration-rehearsal: active migrate does not match the candidate-pinned IHP runner" >&2
    echo "expected_runner=$expected_runner" >&2
    echo "active_runner=$runner" >&2
    exit 69
fi
launcher="${BEPIS_TOOLING_LAUNCHER:-$repo_root/bin/tooling-run}"
postgres_binary="${BEPIS_POSTGRES_BINARY:-$("$launcher" postgres --print-binary)}"
recipe_path="${BEPIS_MIGRATION_REHEARSAL_RECIPE:-${BEPIS_SCRIPTS_ROOT:-$repo_root/Config/nix/scripts}/db/migration-rehearsal-recipe}"
arguments=(
    rehearsal-run
    --workspace "$repo_root"
    --from-ref "$from_ref"
    --runner "$runner"
    --expected-runner "$expected_runner"
    --candidate-ihp-source "$candidate_ihp_source"
    --postgres-manager "$(command -v test-postgres)"
    --recipe "$recipe_path"
)
[ "$keep_failure_artifacts" -eq 0 ] || arguments+=(--keep-failure-artifacts)
exec "$postgres_binary" "${arguments[@]}"
