#!/usr/bin/env bash

# Publish one completely rendered Surface-adapter tree only after the supplied
# validator accepts every staged module. The validator receives the stage root
# followed by every staged .hs path. No managed path is inspected, deleted, or
# written before it succeeds.
surface_adapter_publish_managed_set() {
    local stage_root="${1%/}"
    local publication_root="${2%/}"
    local validator="$3"
    local managed_root="$publication_root/Application/Helper/FrontendContract/Surface"
    local generated_header='^-- @generated by Application\.Helper\.FrontendContract\.Surface\.HaskellAdapter\.Generator$'

    local -a expected_files=()
    mapfile -t expected_files < <(find "$stage_root" -type f -name '*.hs' -print | sort)
    if [ "${#expected_files[@]}" -eq 0 ]; then
        echo "frontend-surface-adapters: staged managed set is empty" >&2
        return 1
    fi

    if ! "$validator" "$stage_root" "${expected_files[@]}"; then
        return 1
    fi

    local -A expected_paths=()
    local generated_file relative_path
    for generated_file in "${expected_files[@]}"; do
        relative_path="${generated_file#"$stage_root"/}"
        expected_paths["$relative_path"]=1
    done

    local -a current_files=()
    mapfile -t current_files < <(
        rg -l "$generated_header" "$managed_root" -g '*.hs' 2>/dev/null | sort || true
    )

    local current_file
    for current_file in "${current_files[@]}"; do
        relative_path="${current_file#"$publication_root"/}"
        if [ -z "${expected_paths[$relative_path]:-}" ]; then
            echo "frontend-surface-adapters: removing stale generated module $relative_path" >&2
            rm -f "$current_file"
            rmdir "$(dirname "$current_file")" 2>/dev/null || true
        fi
    done

    local destination temporary_target
    for generated_file in "${expected_files[@]}"; do
        relative_path="${generated_file#"$stage_root"/}"
        destination="$publication_root/$relative_path"
        mkdir -p "$(dirname "$destination")"
        if [ -f "$destination" ] && cmp -s "$generated_file" "$destination"; then
            continue
        fi
        temporary_target="${destination}.tmp.$$"
        cp "$generated_file" "$temporary_target"
        mv "$temporary_target" "$destination"
        echo "frontend-surface-adapters: wrote $relative_path" >&2
    done

    echo "frontend-surface-adapters: generated ${#expected_files[@]} module(s)" >&2
}
