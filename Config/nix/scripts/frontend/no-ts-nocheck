#!/usr/bin/env bash
set -euo pipefail

repo_root="${FRONTEND_REPO_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
cd "$repo_root"

# shellcheck source=../lib/authority-scan.sh
. "${BEPIS_SCRIPTS_ROOT:-$repo_root/Config/nix/scripts}/lib/authority-scan.sh"

matches="$(authority_scan rg --line-number --fixed-strings '@ts-nocheck' frontend/ts --glob '!generated/**')"
if [ -n "$matches" ]; then
    printf '%s\n' "$matches"
    echo "frontend-no-ts-nocheck: @ts-nocheck is not allowed in app-owned frontend TypeScript" >&2
    exit 1
fi
