#!/usr/bin/env bash
set -euo pipefail

repo_root="${FRONTEND_REPO_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
cd "$repo_root"

entries=(frontend/ts/app.ts frontend/ts/dev-timer-tracking.ts)
for entry in "${entries[@]}"; do
    if [ ! -f "$entry" ]; then
        echo "frontend-build: missing entrypoint $entry" >&2
        exit 1
    fi
done

# Replace the complete generated app bundle authority; do not retain stale
# outputs from the superseded independent entrypoint build.
rm -f static/app*.js static/dev-timer-tracking.js

esbuild "${entries[@]}" \
    --bundle \
    --format=iife \
    --platform=browser \
    --target=es2020 \
    --legal-comments=none \
    --outdir=static
