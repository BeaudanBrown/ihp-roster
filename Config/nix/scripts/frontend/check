#!/usr/bin/env bash
set -euo pipefail

repo_root="${FRONTEND_REPO_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
cd "$repo_root"

bash "${BEPIS_SCRIPTS_ROOT:?}/frontend/contracts-check"
bash "${BEPIS_SCRIPTS_ROOT:?}/frontend/surface-adapters-check"
bash "${BEPIS_SCRIPTS_ROOT:?}/frontend/surface-guardrails"
bash "${BEPIS_SCRIPTS_ROOT:?}/frontend/surface-adapter-publication-test"
bash "${BEPIS_SCRIPTS_ROOT:?}/frontend/surface-compile-fail-check"
tsc --project tsconfig.json --noEmit
e2e-typecheck
bash "${BEPIS_SCRIPTS_ROOT:?}/frontend/no-ts-nocheck"
bash "${BEPIS_SCRIPTS_ROOT:?}/frontend/no-broad-switch-defaults"
bash "${BEPIS_SCRIPTS_ROOT:?}/frontend/test"
bash "${BEPIS_SCRIPTS_ROOT:?}/frontend/drift-check"
