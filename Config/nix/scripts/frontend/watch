#!/usr/bin/env bash
set -euo pipefail

repo_root="${FRONTEND_REPO_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
cd "$repo_root"

state_dir="$(dev-agent-state-dir)/generated-code"
tooling_launcher="${BEPIS_TOOLING_LAUNCHER:-$repo_root/bin/tooling-run}"
mkdir -p "$state_dir"
if [ "${BEPIS_JS_WATCH_LOCKED:-0}" != 1 ]; then
    exec "$tooling_launcher" artifacts lock-exec --lock "$state_dir/js-watch.lock" --nonblocking -- \
        env BEPIS_JS_WATCH_LOCKED=1 "$0" "$@"
fi

entries=(frontend/ts/app.ts frontend/ts/dev-timer-tracking.ts)
for entry in "${entries[@]}"; do
    if [ ! -f "$entry" ]; then
        echo "frontend-watch: missing entrypoint $entry" >&2
        exit 1
    fi
done

rm -f static/app*.js static/dev-timer-tracking.js

exec esbuild "${entries[@]}" \
    --bundle \
    --format=iife \
    --platform=browser \
    --target=es2020 \
    --legal-comments=none \
    --outdir=static \
    --watch=forever
