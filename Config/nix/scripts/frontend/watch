#!/usr/bin/env bash
set -euo pipefail

repo_root="${FRONTEND_REPO_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
cd "$repo_root"

if [ -f "@scriptsRoot@/frontend/generated-state-lib" ]; then
    # shellcheck source=generated-state-lib
    . "@scriptsRoot@/frontend/generated-state-lib"
else
    # shellcheck source=generated-state-lib
    . "Config/nix/scripts/frontend/generated-state-lib"
fi
if ! frontend_js_watch_lock; then
    echo "frontend-watch: another watcher already owns this workspace" >&2
    exit 75
fi

entries=(frontend/ts/app.ts frontend/ts/dev-timer-tracking.ts)
for entry in "${entries[@]}"; do
    if [ ! -f "$entry" ]; then
        echo "frontend-watch: missing entrypoint $entry" >&2
        exit 1
    fi
done

rm -f static/app*.js static/dev-timer-tracking.js

exec esbuild "${entries[@]}" \
    --bundle \
    --format=iife \
    --platform=browser \
    --target=es2020 \
    --legal-comments=none \
    --outdir=static \
    --watch=forever
