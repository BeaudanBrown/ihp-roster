design_matrix="$repo_root/Config/nix/frontend-operation-evidence-matrix.tsv"
script_source="$repo_root/Config/nix/scripts/frontend/surface-compile-fail-check"
if [ ! -f "$design_matrix" ]; then
    echo "surface-compile-fail-check: missing operation-evidence design matrix: $design_matrix" >&2
    exit 2
fi
if ! awk -F '\t' '
    NR == 1 {
        if ($0 != "fixture\tguarantee\tpilot_seam\tfull_rollout\troster_action_equivalent") exit 1
        next
    }
    NF != 5 || $1 == "" { exit 1 }
    $2 !~ /^(closed|fields|kind|opaque|operation|owner|reachability)$/ { exit 1 }
    $3 !~ /^(kind-indexed-generator|operation-kind|operation-local-action|operation-local-intent|unchanged)$/ { exit 1 }
    $4 !~ /^(kind-indexed-generator|operation-kind|operation-local-action|operation-local-intent|unchanged)$/ { exit 1 }
    $5 != "-" && $5 !~ /^Test\/CompileFail\/FrontendSurfaceRosterAction(WrongOwner|WrongField|WrongOperation|RawRebinding|Incomplete|ExtraField|WrongFieldOrder|WrongFieldPresence|WrongWireType)\.hs$/ { exit 1 }
' "$design_matrix"; then
    echo "surface-compile-fail-check: malformed operation-evidence design matrix" >&2
    exit 2
fi
awk '/^expect_compile_failure \\/ {
    getline
    gsub(/[ "\\]/, "", $0)
    print
}' "$script_source" | sort >"$tmp_dir/declared-fixtures.txt"
declared_total="$(wc -l <"$tmp_dir/declared-fixtures.txt")"
selected_total="$declared_total"
if ((${#filters[@]} > 0)); then
    selected_total="${#filters[@]}"
fi
tail -n +2 "$design_matrix" | cut -f1 | sort >"$tmp_dir/matrix-fixtures.txt"
awk -F '\t' 'NR > 1 && $5 != "-" { print $5 }' "$design_matrix" | sort >"$tmp_dir/pilot-fixtures.txt"
if [ "$(wc -l <"$tmp_dir/pilot-fixtures.txt")" -ne 9 ] || [ -n "$(uniq -d "$tmp_dir/pilot-fixtures.txt")" ]; then
    echo "surface-compile-fail-check: operation-evidence design matrix must name nine unique Roster Action pilot fixtures" >&2
    exit 2
fi
if [ -n "$(uniq -d "$tmp_dir/matrix-fixtures.txt")" ]; then
    echo "surface-compile-fail-check: duplicate fixture in operation-evidence design matrix" >&2
    uniq -d "$tmp_dir/matrix-fixtures.txt" >&2
    exit 2
fi
if ! diff -u "$tmp_dir/declared-fixtures.txt" "$tmp_dir/matrix-fixtures.txt"; then
    echo "surface-compile-fail-check: operation-evidence design matrix does not cover the exact registered fixture set" >&2
    exit 2
fi
echo "surface-compile-fail-check: operation-evidence design matrix covers $declared_total/$declared_total registered fixtures and names 9/9 Roster Action pilot fixtures"

fixtures=()
expected_diagnostics=()
rejected_diagnostics=()

expect_compile_failure() {
    local fixture="$1"
    shift
    local fixture_basename
    local fixture_stem
    local filter
    local filter_matches=0
    fixture_basename="$(basename "$fixture")"
    fixture_stem="${fixture_basename%.hs}"

    if ((${#filters[@]} > 0)); then
        for filter in "${filters[@]}"; do
            if [[ "$filter" == "$fixture" || "$filter" == "$fixture_basename" || "$filter" == "$fixture_stem" ]]; then
                matched_filters["$filter"]=1
                ((filter_matches += 1))
            fi
        done
        if ((filter_matches == 0)); then
            return
        fi
        if ((filter_matches > 1)); then
            echo "surface-compile-fail-check: multiple filters select $fixture; pass each fixture once" >&2
            exit 2
        fi
    fi

    ((checked_count += 1))
    echo "surface-compile-fail-check: checking $checked_count/$selected_total: $fixture"

    local mode="expected"
    local expected=""
    local rejected=""
    local diagnostic

    for diagnostic in "$@"; do
        if [ "$diagnostic" = "--reject" ]; then
            mode="rejected"
        elif [ "$mode" = "expected" ]; then
            expected+="$diagnostic"$'\n'
        else
            rejected+="$diagnostic"$'\n'
        fi
    done

    fixtures+=("$fixture")
    expected_diagnostics+=("$expected")
    rejected_diagnostics+=("$rejected")
}

run_compile_failure_checks() {
    local combined_log="$tmp_dir/combined.log"
    local fixture_log fixture diagnostic
    local index

    # One --make session amortizes GHC startup and dependency analysis across all
    # negative fixtures. -fkeep-going still asks GHC to diagnose every target.
    # shellcheck disable=SC2086 # GHC_OPTS is an intentional argument vector.
    if ghc $GHC_OPTS -fno-code -fkeep-going "${fixtures[@]}" \
        -odir "$IHP_ROSTER_GHC_CACHE_DIR/obj" \
        -hidir "$IHP_ROSTER_GHC_CACHE_DIR/hi" \
        >"$combined_log" 2>&1; then
        echo "surface-compile-fail-check: expected fixtures to fail, but the batch compiled" >&2
        exit 1
    fi

    for index in "${!fixtures[@]}"; do
        fixture="${fixtures[$index]}"
        fixture_log="$tmp_dir/$(basename "$fixture").log"
        awk -v fixture="$fixture" '
            /^\[[[:space:]]*[0-9]+ of [0-9]+\] Compiling / {
                active = index($0, "( " fixture ",") > 0
            }
            active { print }
        ' "$combined_log" >"$fixture_log"

        if ! grep -Fq ': error:' "$fixture_log"; then
            echo "surface-compile-fail-check: expected $fixture to fail, but no attributed error was reported" >&2
            cat "$fixture_log" >&2
            exit 1
        fi

        while IFS= read -r diagnostic; do
            [ -z "$diagnostic" ] || if ! grep -Fq "$diagnostic" "$fixture_log"; then
                echo "surface-compile-fail-check: $fixture missing expected diagnostic substring: $diagnostic" >&2
                cat "$fixture_log" >&2
                exit 1
            fi
        done <<<"${expected_diagnostics[$index]}"

        while IFS= read -r diagnostic; do
            [ -z "$diagnostic" ] || if grep -Fq "$diagnostic" "$fixture_log"; then
                echo "surface-compile-fail-check: $fixture contains rejected diagnostic substring: $diagnostic" >&2
                cat "$fixture_log" >&2
                exit 1
            fi
        done <<<"${rejected_diagnostics[$index]}"

        echo "surface-compile-fail-check: $fixture failed as expected"
    done
}

