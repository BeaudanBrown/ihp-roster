    # shellcheck source=../lib/ghc.sh
    . "Config/nix/scripts/lib/ghc.sh"
fi

if [[ "${1:-}" == "--help" ]]; then
    cat <<'EOF'
Usage: frontend-surface-compile-fail-check [FIXTURE ...]

Without arguments, checks every registered compile-failure fixture. A fixture
filter may be its repository path, basename, or basename without .hs.
EOF
    exit 0
fi

filters=("$@")
# Keep this explicit: project commands execute the working-tree script through
# /dev/fd, so reading $0 would consume the script stream itself.
declared_total=48
selected_total="$declared_total"
if ((${#filters[@]} > 0)); then
    selected_total="${#filters[@]}"
fi
checked_count=0
declare -A matched_filters=()

tmp_dir="$(mktemp -d)"
cleanup() {
    rm -rf "$tmp_dir"
}
trap cleanup EXIT

mkdir -p "$tmp_dir/obj" "$tmp_dir/hi"
GHC_OPTS="$(ihp_roster_ghc_opts)"
fixtures=()
expected_diagnostics=()
rejected_diagnostics=()

expect_compile_failure() {
    local fixture="$1"
    shift
    local fixture_basename
    local fixture_stem
    local filter
    local filter_matches=0
    fixture_basename="$(basename "$fixture")"
    fixture_stem="${fixture_basename%.hs}"

    if ((${#filters[@]} > 0)); then
        for filter in "${filters[@]}"; do
            if [[ "$filter" == "$fixture" || "$filter" == "$fixture_basename" || "$filter" == "$fixture_stem" ]]; then
                matched_filters["$filter"]=1
                ((filter_matches += 1))
            fi
        done
        if ((filter_matches == 0)); then
            return
        fi
        if ((filter_matches > 1)); then
            echo "surface-compile-fail-check: multiple filters select $fixture; pass each fixture once" >&2
            exit 2
        fi
    fi

    ((checked_count += 1))
    echo "surface-compile-fail-check: checking $checked_count/$selected_total: $fixture"

    local mode="expected"
    local expected=""
    local rejected=""
    local diagnostic

    for diagnostic in "$@"; do
        if [ "$diagnostic" = "--reject" ]; then
            mode="rejected"
        elif [ "$mode" = "expected" ]; then
            expected+="$diagnostic"$'\n'
        else
            rejected+="$diagnostic"$'\n'
        fi
    done

    fixtures+=("$fixture")
    expected_diagnostics+=("$expected")
    rejected_diagnostics+=("$rejected")
}

run_compile_failure_checks() {
    local combined_log="$tmp_dir/combined.log"
    local fixture_log fixture diagnostic
    local index

    # One --make session amortizes GHC startup and dependency analysis across all
    # negative fixtures. -fkeep-going still asks GHC to diagnose every target.
    # shellcheck disable=SC2086 # GHC_OPTS is an intentional argument vector.
    if ghc $GHC_OPTS -fno-code -fkeep-going "${fixtures[@]}" \
        -odir "$tmp_dir/obj" \
        -hidir "$tmp_dir/hi" \
        >"$combined_log" 2>&1; then
        echo "surface-compile-fail-check: expected fixtures to fail, but the batch compiled" >&2
        exit 1
    fi

    for index in "${!fixtures[@]}"; do
        fixture="${fixtures[$index]}"
        fixture_log="$tmp_dir/$(basename "$fixture").log"
        awk -v fixture="$fixture" '
            /^\[[[:space:]]*[0-9]+ of [0-9]+\] Compiling / {
                active = index($0, "( " fixture ",") > 0
            }
            active { print }
        ' "$combined_log" >"$fixture_log"

        if ! grep -Fq ': error:' "$fixture_log"; then
            echo "surface-compile-fail-check: expected $fixture to fail, but no attributed error was reported" >&2
            cat "$fixture_log" >&2
            exit 1
        fi

        while IFS= read -r diagnostic; do
            [ -z "$diagnostic" ] || if ! grep -Fq "$diagnostic" "$fixture_log"; then
                echo "surface-compile-fail-check: $fixture missing expected diagnostic substring: $diagnostic" >&2
                cat "$fixture_log" >&2
                exit 1
            fi
        done <<<"${expected_diagnostics[$index]}"

        while IFS= read -r diagnostic; do
            [ -z "$diagnostic" ] || if grep -Fq "$diagnostic" "$fixture_log"; then
                echo "surface-compile-fail-check: $fixture contains rejected diagnostic substring: $diagnostic" >&2
                cat "$fixture_log" >&2
                exit 1
            fi
        done <<<"${rejected_diagnostics[$index]}"

        echo "surface-compile-fail-check: $fixture failed as expected"
    done
}

