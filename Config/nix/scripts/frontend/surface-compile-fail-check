#!/usr/bin/env bash
set -euo pipefail
repo_root="${FRONTEND_REPO_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
cd "$repo_root"

if [ -f "@scriptsRoot@/lib/ghc.sh" ]; then
    # shellcheck source=../lib/ghc.sh
    . "@scriptsRoot@/lib/ghc.sh"
else
    # shellcheck source=../lib/ghc.sh
    . "Config/nix/scripts/lib/ghc.sh"
fi

tmp_dir="$(mktemp -d)"
cleanup() {
    rm -rf "$tmp_dir"
}
trap cleanup EXIT

mkdir -p "$tmp_dir/obj" "$tmp_dir/hi"
GHC_OPTS="$(ihp_roster_ghc_opts)"

expect_compile_failure() {
    local fixture="$1"
    shift
    local log="$tmp_dir/$(basename "$fixture").log"

    if ghc $GHC_OPTS -fno-code "$fixture" \
        -odir "$tmp_dir/obj" \
        -hidir "$tmp_dir/hi" \
        >"$log" 2>&1; then
        echo "surface-compile-fail-check: expected $fixture to fail, but it compiled" >&2
        exit 1
    fi

    for expected in "$@"; do
        if ! grep -Fq "$expected" "$log"; then
            echo "surface-compile-fail-check: $fixture missing expected diagnostic substring: $expected" >&2
            cat "$log" >&2
            exit 1
        fi
    done

    echo "surface-compile-fail-check: $fixture failed as expected"
}

expect_compile_failure \
    "Test/CompileFail/FrontendSurfaceRawMountedTarget.hs" \
    "IsString (SurfaceFields" \
    "raw-target-id"

expect_compile_failure \
    "Test/CompileFail/FrontendSurfaceWrongFragmentMarker.hs" \
    "does not declare fragment marker" \
    "RosterContent"

expect_compile_failure \
    "Test/CompileFail/FrontendSurfaceWrongFragmentField.hs" \
    "does not declare field marker" \
    "RowIndex"

expect_compile_failure \
    "Test/CompileFail/FrontendSurfaceWrongIntentField.hs" \
    "does not declare field marker" \
    "PanelId"

expect_compile_failure \
    "Test/CompileFail/FrontendSurfaceWrongScopeField.hs" \
    "does not declare field marker" \
    "PanelId"

expect_compile_failure \
    "Test/CompileFail/FrontendSurfaceWrongLiveScopeMarker.hs" \
    "does not declare scope marker" \
    "RosterWeek"

expect_compile_failure \
    "Test/CompileFail/FrontendSurfaceIncompleteLiveFragment.hs" \
    "Couldn't match type" \
    "RowIndex"

expect_compile_failure \
    "Test/CompileFail/FrontendSurfaceRawLiveIdentity.hs" \
    "Data constructor not in scope" \
    "FrontendSurfaceScope"

expect_compile_failure \
