#!/usr/bin/env bash
set -euo pipefail
repo_root="${FRONTEND_REPO_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
cd "$repo_root"

if [ -f "@scriptsRoot@/lib/ghc.sh" ]; then
    # shellcheck source=../lib/ghc.sh
    . "@scriptsRoot@/lib/ghc.sh"
else
    # shellcheck source=../lib/ghc.sh
    . "Config/nix/scripts/lib/ghc.sh"
fi

tmp_dir="$(mktemp -d)"
cleanup() {
    rm -rf "$tmp_dir"
}
trap cleanup EXIT

mkdir -p "$tmp_dir/obj" "$tmp_dir/hi"
GHC_OPTS="$(ihp_roster_ghc_opts)"

expect_compile_failure() {
    local fixture="$1"
    shift
    local log="$tmp_dir/$(basename "$fixture").log"

    if ghc $GHC_OPTS -fno-code "$fixture" \
        -odir "$tmp_dir/obj" \
        -hidir "$tmp_dir/hi" \
        >"$log" 2>&1; then
        echo "surface-compile-fail-check: expected $fixture to fail, but it compiled" >&2
        exit 1
    fi

    for expected in "$@"; do
        if ! grep -q "$expected" "$log"; then
            echo "surface-compile-fail-check: $fixture missing expected diagnostic substring: $expected" >&2
            cat "$log" >&2
            exit 1
        fi
    done

    echo "surface-compile-fail-check: $fixture failed as expected"
}

expect_compile_failure \
    "Test/CompileFail/FrontendSurfaceMissingFragmentHandler.hs" \
    "LabPanel" \
    "HandlerList"

expect_compile_failure \
    "Test/CompileFail/FrontendSurfaceMissingActionHandler.hs" \
    "RefreshPanel" \
    "HandlerList"

expect_compile_failure \
    "Test/CompileFail/FrontendSurfaceMissingIntentHandler.hs" \
    "MoveLabCard" \
    "HandlerList"

expect_compile_failure \
    "Test/CompileFail/FrontendSurfaceUndeclaredFieldAccessor.hs" \
    "FrontendSurface field" \
    "WeekOffset" \
    "not declared"

expect_compile_failure \
    "Test/CompileFail/FrontendSurfaceWrongActionMarker.hs" \
    "does not declare action marker" \
    "NavigateRosterWeek"

expect_compile_failure \
    "Test/CompileFail/FrontendSurfaceWrongActionField.hs" \
    "does not declare field marker" \
    "RosterGroupId"
