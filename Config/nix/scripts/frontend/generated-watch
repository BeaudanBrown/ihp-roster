#!/usr/bin/env bash
set -euo pipefail

repo_root="${FRONTEND_REPO_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
cd "$repo_root"

if [ -f "@scriptsRoot@/frontend/generated-state-lib" ]; then
    # shellcheck source=Config/nix/scripts/frontend/generated-state-lib
    . "@scriptsRoot@/frontend/generated-state-lib"
else
    # shellcheck source=Config/nix/scripts/frontend/generated-state-lib
    . "Config/nix/scripts/frontend/generated-state-lib"
fi

state_dir="$(frontend_generated_state_dir)"
manifest="$state_dir/frontend-contracts.manifest"
interval="${FRONTEND_GENERATED_WATCH_INTERVAL:-${FRONTEND_CONTRACTS_WATCH_INTERVAL:-2}}"
build_root="${FRONTEND_GENERATED_WATCH_BUILD_DIR:-$state_dir/watch-build}"
mkdir -p "$state_dir" "$build_root"
if ! frontend_generated_watch_lock; then
    echo "frontend-generated-watch: another watcher already owns this workspace" >&2
    exit 75
fi

regenerate() (
    frontend_generation_lock

    local input_hash output_hash
    input_hash="$(frontend_contract_input_hash)"
    output_hash="$(frontend_contract_output_hash)"
    if frontend_manifest_matches "$manifest" "$input_hash" "$output_hash"; then
        exit 0
    fi

    echo "[frontend-generated-watch] regenerating Haskell adapters and TypeScript contracts"
    FRONTEND_SURFACE_ADAPTERS_BUILD_DIR="$build_root/surface-adapters" frontend-surface-adapters
    FRONTEND_CONTRACTS_BUILD_DIR="$build_root/contracts" frontend-contracts
    frontend_write_manifest \
        "$manifest" \
        "$(frontend_contract_input_hash)" \
        "$(frontend_contract_output_hash)"
)

failed_state=""
while true; do
    current_input="$(frontend_contract_input_hash)"
    current_output="$(frontend_contract_output_hash)"
    current_state="$current_input:$current_output"
    if frontend_manifest_matches "$manifest" "$current_input" "$current_output"; then
        failed_state=""
    elif [ "$current_state" != "$failed_state" ]; then
        if regenerate; then
            failed_state=""
        else
            failed_state="$current_state"
            echo "[frontend-generated-watch] generation failed; waiting for source changes" >&2
        fi
    fi
    sleep "$interval"
done
