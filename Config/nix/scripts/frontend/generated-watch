#!/usr/bin/env bash
set -euo pipefail

repo_root="${FRONTEND_REPO_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
cd "$repo_root"
scripts_root="${BEPIS_SCRIPTS_ROOT:?}"
tooling_launcher="${BEPIS_TOOLING_LAUNCHER:-$repo_root/bin/tooling-run}"
state_dir="$(dev-agent-state-dir)/generated-code"
manifest="$state_dir/frontend-contracts.manifest"
interval="${FRONTEND_GENERATED_WATCH_INTERVAL:-${FRONTEND_CONTRACTS_WATCH_INTERVAL:-2}}"
build_root="${FRONTEND_GENERATED_WATCH_BUILD_DIR:-$state_dir/watch-build}"
mkdir -p "$state_dir" "$build_root"

if [ "${BEPIS_GENERATED_WATCH_LOCKED:-0}" != 1 ]; then
    exec "$tooling_launcher" artifacts lock-exec --lock "$state_dir/contracts-watch.lock" --nonblocking -- \
        env BEPIS_GENERATED_WATCH_LOCKED=1 "$0" "$@"
fi

export FRONTEND_SURFACE_ADAPTERS_BUILD_DIR="$build_root/surface-adapters"
export FRONTEND_CONTRACTS_BUILD_DIR="$build_root/contracts"
failed_state=""
while true; do
    current_input="$("$tooling_launcher" artifacts snapshot --root "$repo_root" --inventory-command "$scripts_root/frontend/contracts-input-inventory")"
    current_output="$("$tooling_launcher" artifacts snapshot --root "$repo_root" --inventory-command "$scripts_root/frontend/contracts-output-inventory")"
    current_state="$current_input:$current_output"
    if "$tooling_launcher" artifacts manifest check "$manifest" "$current_input" "$current_output"; then
        failed_state=""
    elif [ "$current_state" != "$failed_state" ]; then
        echo "[frontend-generated-watch] regenerating Haskell adapters and TypeScript contracts"
        if "$tooling_launcher" artifacts generate --mode ensure --root "$repo_root" \
            --lock "$state_dir/generation.lock" --manifest "$manifest" \
            --input-command "$scripts_root/frontend/contracts-input-inventory" \
            --output-command "$scripts_root/frontend/contracts-output-inventory" -- \
            "$scripts_root/frontend/generate-contract-artifacts" >/dev/null; then
            failed_state=""
        else
            failed_state="$current_state"
            echo "[frontend-generated-watch] generation failed; waiting for source changes" >&2
        fi
    fi
    sleep "$interval"
done
