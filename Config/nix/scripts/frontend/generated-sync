#!/usr/bin/env bash
set -euo pipefail

repo_root="${FRONTEND_REPO_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
cd "$repo_root"
scripts_root="${BEPIS_SCRIPTS_ROOT:?}"
tooling_launcher="${BEPIS_TOOLING_LAUNCHER:-$repo_root/bin/tooling-run}"
state_dir="$(dev-agent-state-dir)/generated-code"
mkdir -p "$state_dir"

"$tooling_launcher" artifacts generate --mode sync --root "$repo_root" \
    --lock "$state_dir/generation.lock" --manifest "$state_dir/frontend-contracts.manifest" \
    --input-command "$scripts_root/frontend/contracts-input-inventory" \
    --output-command "$scripts_root/frontend/contracts-output-inventory" -- \
    "$scripts_root/frontend/generate-contract-artifacts" >/dev/null
"$tooling_launcher" artifacts generate --mode sync --root "$repo_root" \
    --lock "$state_dir/generation.lock" --manifest "$state_dir/frontend-js.manifest" \
    --input-command "$scripts_root/frontend/js-input-inventory" \
    --output-command "$scripts_root/frontend/js-output-inventory" -- frontend-build >/dev/null

echo "frontend-generated-sync: generated frontend artifacts are current"
