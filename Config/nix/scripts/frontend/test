#!/usr/bin/env bash
set -euo pipefail

repo_root="${FRONTEND_REPO_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
cd "$repo_root"

tmp_dir="$(mktemp -d)"
cleanup() {
    rm -rf "$tmp_dir"
}
trap cleanup EXIT

esbuild frontend/ts/tests/main.ts \
    --bundle \
    --platform=node \
    --format=esm \
    --target=node22 \
    --outfile="$tmp_dir/frontend-tests.mjs" \
    --metafile="$tmp_dir/frontend-tests.meta.json" \
    --log-level=warning

node scripts/frontend-test-registration.mjs "$tmp_dir/frontend-tests.meta.json"
node "$tmp_dir/frontend-tests.mjs"
