        continue
    fi

    fixture_generated_module="Test.Support.FrontendSurfaceAdapterFixture.Generated.${fixture_kind}"
    fixture_generated_pattern="${fixture_generated_module//./\\.}"
    mapfile -t fixture_consumers < <(
        rg -l --glob '*.hs' "^import (qualified )?${fixture_generated_pattern}([[:space:]]|$)" Test 2>/dev/null \
            | sort \
            || true
    )
    if [ "${#fixture_consumers[@]}" -ne 1 ] || [ "${fixture_consumers[0]:-}" != "$fixture_facade" ]; then
        report_failure "private generated ${fixture_kind} fixture must be consumed only by $fixture_facade"
        printf '  %s\n' "${fixture_consumers[@]:-<no consumers>}" >&2
    fi

    if rg --line-number '^import .*\.Internal|HaskellAdapter\.Registry|Data\.Aeson' "$fixture_generated" >&2; then
        report_failure "generated ${fixture_kind} fixture bypasses a public generic boundary"
    fi
    if rg --line-number '\b(frontendSurface(Action|IntentForm)|parseSurface(Action|Intent)Params|surface(Field|OptionalField|NullableField))\b' "$fixture_facade" >&2; then
        report_failure "curated ${fixture_kind} fixture facade contains mechanical adapter code"
    fi
