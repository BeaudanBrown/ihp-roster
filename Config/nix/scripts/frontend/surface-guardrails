    'appShellActionByName' \
    "${migrated_overlay_paths[@]}"

expect_match \
    "migrated feedback overlay opener uses typed AppShellAction marker lookup" \
    'appShellActionByMarker @OpenFeedbackDialog' \
    Web/View/Layout.hs

expect_match \
    "migrated feedback overlay submit uses typed AppShellAction marker lookup" \
    'appShellActionByMarker @SubmitFeedback' \
    Web/View/Feedback/New.hs

expect_no_match \
    "migrated chrome partial navigation must not hand-author request HTMX attrs" \
    'hx-(get|post|target|swap|select|push-url|sync)=' \
    Application/Helper/View/Chrome.hs

expect_no_match \
    "shared staff/profile forms must not hand-author request HTMX attrs" \
    'hx-(get|post|target|swap|select|push-url|sync)=' \
    Web/View/StaffProfileSections.hs

expect_no_match \
    "migrated local feature initiators must not hand-author request HTMX attrs" \
    'hx-(get|post|target|swap|select|push-url|sync|trigger)=' \
    Web/View/Staff/Edit.hs \
    Web/View/RosterWeeks/StaffSelfServicePanel.hs \
    Web/View/RosterWeeks/Overview.hs \
    Web/View/Admin/Xero/TimesheetPreparation.hs

expect_match \
    "migrated chrome partial navigation uses typed AppShellAction marker lookup" \
    'appShellActionByMarker @PartialNavigate' \
    Application/Helper/View/Chrome.hs

expect_no_match \
    "migrated Admin Roster Groups view must not hand-author request HTMX attrs" \
    'hx-(get|post|target|swap|trigger|push-url)=' \
    Web/View/Admin/RosterGroups.hs

expect_no_match \
    "migrated Admin Roster Groups success path must not render business OOB helper" \
    'renderRosterGroupsSectionFragmentWithSwap|hx-swap-oob' \
    Web/View/Admin/RosterGroups.hs Web/Controller/Admin/Support.hs

expect_no_match \
    "production code must not resurrect shared SurfaceProjection cache plumbing" \
    'Application\.Helper\.SurfaceProjection|SurfaceProjection' \
    Application Web

expect_no_match \
    "production/browser code must not resurrect legacy declarative live-surface attributes" \
    'data-live-update-(surface|url)|parseLiveUpdateSurfaceConfig|liveUpdateUrl' \
    Application Web frontend/ts e2e static

expect_no_match \
    "app-live-updates must remain the sole focus-protection owner without IHP auto-refresh compatibility" \
    'ihp-auto-refresh|enableRosterGridAutoRefreshDeferral|data-live-field-key|morphdom' \
    Application Web frontend/ts static

expect_no_match \
    "focused-field descriptors must provide an exact policy instead of a compatibility default" \
    '\bFrontendSurfaceFocusedField\b' \
    Application Web Test

expect_no_match \
    "production Web code must not author legacy semantic interaction helpers or attrs" \
    'Application\.Helper\.Interaction|withInteraction|renderInteraction|data-bepis-(pointer-session|session-kind|session-intent|activation-intent|activation-trigger|marker|item=|dropzone=)' \
    Web

expect_no_match \
    "interaction runtime must not keep legacy semantic marker fallback paths" \
    'readLegacy|legacyActivation|legacyDropzone|attrs\.(marker|item|dropzone|pointerSession|sessionKind|sessionIntent|activationIntent|activationTrigger|activationValueField)' \
    frontend/ts/interaction

expect_no_match \
    "generated/static contracts must not expose deleted semantic interaction DOM attrs" \
    'data-bepis-(marker|item|pointer-session|session-kind|session-intent|activation-intent|activation-trigger|activation-value-field)|"(item|pointerSession|sessionIntent|activationIntent|activationTrigger|activationValueField|activationMarker|itemMarker|dropzoneMarker)"' \
    frontend/ts/generated/contracts.ts static/app-interactions.js static/app-live-updates.js

expect_no_match \
    "InteractionContract must not own roster-specific interaction enum authority" \
    'Interaction(SurfaceFamily|DisposableLayerName|SessionKindName|IntentName|IntentFieldName)|SetRosterLayoutMode|MoveRosterShiftToSlot|DragPreview|\bdata Roster\b' \
    Application/Helper/FrontendContract/Interaction.hs

expect_no_match_including_generated \
    "generated contracts must not expose compatibility shim aliases for old global interaction vocabulary" \
    '\bInteraction(SurfaceFamily|DisposableLayerName|SessionKindName|IntentName|IntentFieldName)\b|isInteractionSurfaceFamily|parseInteractionSurfaceFamily|encodeInteractionSurfaceFamily' \
    frontend/ts/generated/contracts.ts

expect_match \
    "generated contracts expose surface-derived interaction surface names" \
    'FrontendSurfaceInteractionSurfaceName = "roster"' \
    frontend/ts/generated/contracts.ts

expect_match \
    "generated contracts expose surface-derived roster interaction intents" \
    'FrontendSurfaceInteractionIntentName = "set-roster-layout-mode" \| "move-roster-shift-to-slot"' \
    frontend/ts/generated/contracts.ts

expect_no_match \
    "roster must use generic FrontendSurface interaction shell rendering" \
    'renderRosterFrontendSurfaceInteractionShell|renderRosterFrontendSurfaceIntentForm|rosterInteractionConflictPoliciesJson|renderRosterDisposableLayer|renderRosterServerLayer' \
    Web/RosterWeeks Web/View/RosterWeeks

expect_no_match \
    "frontend contracts must not resurrect legacy live-surface manifest DTOs" \
    'LiveSurfaceManifest|LiveSurfaceFamily|SurfaceManifestSchema|Application\.Helper\.Frontend\.Dto\.LiveSurface' \
    Application Web frontend/ts static

expect_no_match \
    "FrontendSurface specs must use current DSL primitive names" \
    '\b(HtmxAction|ClientEvent|DisposableLayer|InteractionEffect)\b' \
    Application/Helper/FrontendContract/Surface/Admin.hs \
    Application/Helper/FrontendContract/Surface/Billing.hs \
    Application/Helper/FrontendContract/Surface/Lab.hs \
    Application/Helper/FrontendContract/Surface/LeaveRequests.hs \
    Application/Helper/FrontendContract/Surface/Profile.hs \
    Application/Helper/FrontendContract/Surface/Roster.hs \
    Application/Helper/FrontendContract/Surface/Support.hs \
    Application/Helper/FrontendContract/Surface/Timesheets.hs

expect_no_match \
    "legacy LiveResource alias/ADT must stay deleted" \
    '\b(type|data|newtype)[[:space:]]+LiveResource\b' \
    Application Web Test

expect_no_match \
    "temporary surface-resource bridge conversion helpers must stay deleted" \
    'liveResourceToSurfaceResourceValues|liveResourcesToSurfaceResourceValues|SurfaceResourceValue bridge' \
    Application Web Test

expect_no_match \
    "FrontendSurface dependency planning must not use final-state custom dependency hooks" \
    'CustomDependency|custom dependency hook|custom dependency' \
    Application Web Test frontend/ts

expect_no_match \
    "legacy expansion sentinel resource constructors must stay deleted" \
    'leaveCalendarResource|staffRosterMembershipResource|staffPayProfileResource|staffTimesheetResource|rosterSlotResource' \
    Application Web Test

expect_no_match \
    "legacy expansion sentinel resource wire names must stay out of code" \
    '"(leave-calendar|staff-roster-membership|staff-pay-profile|staff-timesheet)"' \
    Application Web Test frontend/ts

expect_no_match \
    "surface subscription authorization must delegate to generated FrontendSurface scope auth" \
    'CurrentVenueManager|CurrentVenueOwner|CurrentVenueAdmin|CurrentVenueRosterGroup|CurrentVenueStaff|SupportSuperAdmin|NoAuthIR|AuthorizeIR' \
    Web/SurfaceInvalidation.hs

expect_match \
    "surface subscription authorization delegates to generated FrontendSurface scope auth" \
    'authorizeSurfaceScope = authorizeFrontendSurfaceScope' \
    Web/SurfaceInvalidation.hs

expect_match \
    "surface invalidation planning delegates dependency matching to generated FrontendSurface planner" \
    'planFrontendSurfaceKeyInvalidation resources subscription\.subscriptionScope subscription\.subscriptionFragmentKeys' \
    Web/SurfaceInvalidation.hs

expect_no_match \
    "app views/helpers must not hand-author request-side HTMX attrs" \
    'hx-(get|post|put|patch|delete|target|swap|push-url|sync|trigger|include|select|confirm)=' \
    Application/Helper/View Web/View

expect_no_match \
    "toggle helper must not expose raw request-side HTMX fields" \
    'appToggleHx(Get|Post|Trigger|Include|Target|Swap|PushUrl|Sync)' \
    Application Web Test

if [ "$failures" -ne 0 ]; then
    exit 1
fi

echo "frontend-surface-guardrails: ok"
