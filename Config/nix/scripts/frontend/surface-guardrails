    'haskellWireSource field.fieldWire' \
    Application/Helper/FrontendContract/Surface/HaskellAdapter/Core.hs
expect_no_match_including_generated \
    "focused Haskell Surface adapter renderers must not duplicate shared source-type resolution" \
