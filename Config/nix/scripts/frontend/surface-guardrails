#!/usr/bin/env bash
# This gate deliberately owns only narrow source tombstones and import edges.
# Contract shape, adapter homes/lanes, generated output, exact codecs, and
# browser behavior are checked by the IR, compile-fail, adapter, TypeScript,
# and Playwright suites invoked by frontend-check.
set -euo pipefail

repo_root="${FRONTEND_REPO_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
cd "$repo_root"

failures=0

fail() {
    echo "frontend-surface-guardrails: $*" >&2
    failures=$((failures + 1))
}

# A tombstone must name deleted vocabulary or a forbidden dependency edge. Do
# not add positive implementation-shape assertions here; put those in a
# checked IR/generator test, compile-failure fixture, DOM test, or E2E test.
expect_no_match() {
    local reason="$1"
    local pattern="$2"
    shift 2
    local matches
    matches="$(mktemp)"
    if rg --line-number --glob '!*.md' --glob '!*.test.ts' --glob '!*.log' --glob '!**/generated/**' "$pattern" "$@" >"$matches" 2>/dev/null; then
        fail "$reason"
        cat "$matches" >&2
    fi
    rm -f "$matches"
}

expect_absent() {
    local path="$1"
    [ ! -e "$path" ] || fail "deleted legacy path was restored: $path"
}

expect_present() {
    local path="$1"
    [ -f "$path" ] || fail "required generated adapter boundary is missing: $path"
}

expect_no_match_including_generated() {
    local reason="$1"
    local pattern="$2"
    shift 2
    local matches
    matches="$(mktemp)"
    if rg --line-number --glob '!*.md' --glob '!*.test.ts' --glob '!*.log' "$pattern" "$@" >"$matches" 2>/dev/null; then
        fail "$reason"
        cat "$matches" >&2
    fi
    rm -f "$matches"
}

# Exact deleted protocol names: these are intentionally narrow compatibility
# tombstones, not semantic scans.
expect_absent Application/Helper/Frontend
expect_absent Web/LiveSurfaceRegistry.hs
expect_absent static/vendor/morphdom-umd.min.js
expect_absent frontend/ts/roster/staff-highlight.ts
expect_absent frontend/ts/roster/staff-panel-sorting.ts
expect_absent frontend/ts/roster/staff-panel-tabs.ts
expect_absent frontend/ts/roster/staff-sort.ts
expect_absent frontend/ts/roster/overview.ts
expect_absent Application/Helper/FrontendContract/RosterValues.hs

expect_no_match \
    "legacy Frontend Haskell authority is forbidden" \
    'Application\.Helper\.Frontend\.' \
    Application Web Test
expect_no_match \
    "legacy live-surface mount protocol is forbidden" \
    'data-live-update-(surface|url)|parseLiveUpdateSurfaceConfig|liveUpdateUrl' \
    Application Web frontend/ts e2e static
expect_no_match \
    "legacy interaction marker protocol is forbidden" \
    'data-bepis-(pointer-session|session-kind|session-intent|activation-intent|activation-trigger|marker)' \
    Application Web frontend/ts e2e static
expect_no_match \
    "legacy overlay protocol is forbidden" \
    'data-(dialog-overlay|dialog-overlay-close|dialog-overlay-backdrop|dialog-overlay-submit-button|overlay-toast|toast-close|loading-label|auto-hide-ms)' \
    Application Web frontend/ts e2e
expect_no_match \
    "legacy toggle and time-picker protocol is forbidden" \
    'data-app-toggle|data-break-(toggle|target)|quarter-hour-time-picker-modal|js-time-picker-(input|trigger|step)|data-time-picker-(field|start|end|step|empty)|data-default-(start|end)-time|data-time-value|time-picker:sync' \
    Application Web frontend/ts e2e static/css
expect_no_match \
    "legacy passkey protocol is forbidden" \
    'data-passkey-management' \
    Application Web frontend/ts e2e static
expect_no_match \
    "legacy Xero filter protocol is forbidden" \
    'data-xero-import-(loading|search|candidates?)' \
    Application Web frontend/ts e2e static
expect_no_match \
    "legacy roster browser protocol is forbidden" \
    'data-roster-(staff-id|slot-id|shift-group-key|fullscreen|fullscreen-toggle|fullscreen-toggle-label|column-editor|column-editing|column-edit-start|column-edit-done|export)|data-week-overview' \
    Application Web frontend/ts e2e static/css
expect_no_match \
    "legacy LiveResource alias is forbidden" \
    '\b(type|data|newtype)[[:space:]]+LiveResource\b' \
    Application Web Test
expect_no_match \
    "catch-all venue configuration discriminator is forbidden" \
    '\b(UpdateVenueConfig(Action)?|ConfigFieldField)\b|name="configField"' \
    Application/Helper/FrontendContract/Surface/Admin.hs \
    Web/Controller/Admin.hs \
    Web/Types.hs \
    Web/View/Admin/VenueSettings.hs
expect_no_match \
    "raw Xero preparation AppShell request field names are forbidden" \
    'name="(periodKey|staffId|decision|xeroEmployeeSelection|accountCode|referenceWaitStartedAt|referenceDemand)"|"(periodKey|staffId|decision|xeroEmployeeSelection|accountCode|referenceWaitStartedAt|referenceDemand)"[[:space:]]*[,)]' \
    Web/Controller/Admin/Xero/Timesheets.hs \
    Web/View/Admin/Xero/TimesheetPreparation.hs

# Generated app-owned attributes must be consumed through reflected helpers or
# generated TypeScript constants; these exact names prevent hand-authored
# authority from returning outside the generator-owned declarations.
expect_no_match \
    "raw generated overlay attributes are forbidden outside their contract" \
    'data-bepis-(dialog-mount|dialog-backdrop|dialog-close|dialog-submit|dialog-submit-config|dialog-auto-submit-once|toast-mount|toast-close|toast-config)([^A-Za-z0-9_-]|$)' \
    Application Web frontend/ts e2e
expect_no_match \
    "raw generated toggle and time-picker attributes are forbidden outside their contract" \
    'data-bepis-(toggle-(root|input|label|transport|break-region|config)|time-picker-(field|trigger|label|step-down|step-up|options|option|clear|config))([^A-Za-z0-9_-]|$)' \
    Application Web frontend/ts e2e
expect_no_match \
    "raw generated passkey attributes are forbidden outside their contract" \
    'data-bepis-passkey-(login|registration|setup-prompt|action-button|device-name|status|recovery|dismissal|flow-config)([^A-Za-z0-9_-]|$)' \
    Application Web frontend/ts e2e
expect_no_match \
    "raw generated PWA, Xero, range, and scroll attributes are forbidden outside their contracts" \
    'data-bepis-(pwa-install-page|pwa-install-button|pwa-install-result|pwa-install-result-state|pwa-installed-status|xero-candidate-filter-(root|search|candidate|config|empty)|ordered-range-(root|config|state|start|end|availability)|horizontal-scroll-(drag|snap)|horizontal-(drag|snap)-config)([^A-Za-z0-9_-]|$)' \
    Application Web frontend/ts e2e
expect_no_match \
    "raw generated roster attributes are forbidden outside their contract" \
    'data-bepis-roster-(fullscreen|fullscreen-root|fullscreen-toggle|fullscreen-label|column-editor|column-editing|column-edit-start|column-edit-done|image-export-(trigger|config|projection|row|cell|format)|staff-highlight-(source|member|pin|order)|shift-group-highlight-(source|member)|day-timeline-shift-group-highlight-(source|member)|staff-panel-sort-(root|row|control)|staff-panel-tab|week-overview-(panel|day|today|details|selected-label|leave-value|assigned-value|hours-value|summary|week-label|go-link|availability|closure|calendar-day))([^A-Za-z0-9_-]|$)' \
    Application Web frontend/ts e2e

# Dependency boundaries: handwritten production code cannot bypass the typed
# request/live/resource facades or generated private-module facade boundary.
expect_no_match \
    "production Web callers must not bypass generated Action adapters" \
    '\b(parseSurfaceActionParams|frontendSurfaceAction)\b' \
    Web
expect_no_match \
    "production Web callers must not bypass generated Intent adapters" \
    '\b(parseSurfaceIntentParams|frontendSurfaceIntentForm)\b' \
    Web
expect_no_match \
    "feature code must not import raw Surface resource internals" \
    'Application\.Helper\.FrontendContract\.Surface\.Resource\.Internal' \
    Application/Helper/FrontendContract/Surface/Admin \
    Application/Helper/FrontendContract/Surface/Billing \
    Application/Helper/FrontendContract/Surface/LeaveRequests \
    Application/Helper/FrontendContract/Surface/Profile \
    Application/Helper/FrontendContract/Surface/Roster \
    Application/Helper/FrontendContract/Surface/Support \
    Application/Helper/FrontendContract/Surface/Timesheets \
    Web
expect_no_match \
    "feature code must not import raw live transport internals" \
    'Application\.Helper\.LiveUpdate\.Internal|Application\.Helper\.FrontendContract\.Wire\.LiveUpdate' \
    Application/Support Web/Admin Web/Billing Web/LeaveRequests Web/Profiles Web/RosterWeeks Web/Timesheets
expect_no_match_including_generated \
    "generated browser output must not restore retired aggregate manifests" \
    'FrontendSurfaceRegistry|InteractionStaticSchemas|SurfaceManifest|AppShellActionManifest|FrontendSurfaceActionManifest|htmxActions|containedSurfaces' \
    frontend/ts/generated/contracts.ts

# The fixture proves generated Action/Intent API lanes; its private output and
# matching facade are mandatory topology boundaries, not optional inventory.
for fixture_path in \
    Test/Support/FrontendSurfaceAdapterFixture/Generated/Action.hs \
    Test/Support/FrontendSurfaceAdapterFixture/Generated/Intent.hs \
    Test/Support/FrontendSurfaceAdapterFixture/Action.hs \
    Test/Support/FrontendSurfaceAdapterFixture/Intent.hs; do
    expect_present "$fixture_path"
done

# Discover generated modules from their generator marker instead of maintaining
# a feature inventory. Each private module has exactly one matching facade
# importer; this is a narrow import-topology check.
mapfile -t generated_modules < <(
    rg -l '^-- @generated by Application\.Helper\.FrontendContract\.Surface\.HaskellAdapter\.Generator$' \
        Application/Helper/FrontendContract/Surface \
        Test/Support/FrontendSurfaceAdapterFixture/Generated/Action.hs \
        Test/Support/FrontendSurfaceAdapterFixture/Generated/Intent.hs \
        -g '*.hs' | sort || true
)
[ "${#generated_modules[@]}" -gt 0 ] || fail "no generated Surface adapter modules found"

for generated_path in "${generated_modules[@]}"; do
    case "$generated_path" in
        */Generated/Resource.hs|*/Generated/Live.hs|*/Generated/Action.hs|*/Generated/Intent.hs) ;;
        *)
            fail "unsupported generated Surface adapter namespace: $generated_path"
            continue
            ;;
    esac

    feature_dir="${generated_path%/Generated/*}"
    kind="${generated_path##*/Generated/}"
    kind="${kind%.hs}"
    facade="$feature_dir/$kind.hs"
    module_name="${generated_path%.hs}"
    module_name="${module_name//\//.}"
    module_pattern="${module_name//./\\.}"

    [ -f "$facade" ] || { fail "missing generated adapter facade: $facade"; continue; }
    mapfile -t consumers < <(
        rg -l --glob '*.hs' "^import (qualified )?${module_pattern}([[:space:]]|$)" Application Web Test 2>/dev/null | sort || true
    )
    if [ "${#consumers[@]}" -ne 1 ] || [ "${consumers[0]:-}" != "$facade" ]; then
        fail "private generated $kind module must be imported only by $facade: $module_name"
        printf '  %s\n' "${consumers[@]:-<no consumers>}" >&2
    fi
    if rg --line-number '^import .*\.Internal|HaskellAdapter\.Registry' "$generated_path" >&2; then
        fail "generated adapter crosses a forbidden internal/registry edge: $generated_path"
    fi
done

# The generator's failure-atomic publication is behavior, not source shape.
if [ -f '@scriptsRoot@/frontend/surface-adapter-publication-test' ]; then
    publication_test='@scriptsRoot@/frontend/surface-adapter-publication-test'
else
    publication_test='Config/nix/scripts/frontend/surface-adapter-publication-test'
fi
bash "$publication_test" || fail "adapter publication must leave managed output untouched on validation failure"

# This inventory is generated, not maintained by feature name. An emitted
# browser token needs a production import and use to remain contract authority.
mapfile -t browser_dom_tokens < <(sed -n 's/^export const \([A-Za-z0-9_]*DomToken\) = .*$/\1/p' frontend/ts/generated/contracts.ts)
for token in "${browser_dom_tokens[@]}"; do
    uses="$( (rg --glob '!frontend/ts/generated/**' --glob '!frontend/ts/tests/**' -o "\\b${token}\\b" frontend/ts 2>/dev/null || true) | wc -l)"
    if [ "$uses" -lt 2 ]; then
        fail "generated browser DOM token has no production import and use: $token"
    fi
done

if [ "$failures" -ne 0 ]; then
    exit 1
fi

echo "frontend-surface-guardrails: ok"
