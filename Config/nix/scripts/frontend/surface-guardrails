#!/usr/bin/env bash
set -euo pipefail

repo_root="${FRONTEND_REPO_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
cd "$repo_root"

failures=0

report_failure() {
    echo "frontend-surface-guardrails: $*" >&2
    failures=$((failures + 1))
}

expect_no_match() {
    local label="$1"
    local pattern="$2"
    shift 2

    local tmp_log
    tmp_log="$(mktemp)"
    if rg --line-number --glob '!*.md' --glob '!*.test.ts' --glob '!*.log' --glob '!generated/**' "$pattern" "$@" >"$tmp_log" 2>/dev/null; then
        report_failure "$label"
        cat "$tmp_log" >&2
    fi
    rm -f "$tmp_log"
}

expect_no_match_including_generated() {
    local label="$1"
    local pattern="$2"
    shift 2

    local tmp_log
    tmp_log="$(mktemp)"
    if rg --line-number --glob '!*.md' --glob '!*.test.ts' --glob '!*.log' "$pattern" "$@" >"$tmp_log" 2>/dev/null; then
        report_failure "$label"
        cat "$tmp_log" >&2
    fi
    rm -f "$tmp_log"
}

expect_match() {
    local label="$1"
    local pattern="$2"
    shift 2

    if ! rg --quiet "$pattern" "$@"; then
        report_failure "$label"
    fi
}

lab_paths=(
    Application/Helper/FrontendContract/Surface/Lab.hs
    Web/Support/FrontendSurfaceLab.hs
    Web/View/Support/FrontendSurfaceLab.hs
)

timesheets_paths=(
    Web/Timesheets
    Web/Controller/Timesheets.hs
    Web/View/Timesheets/Index.hs
)

migrated_overlay_paths=(
    Web/View/Layout.hs
    Web/View/Feedback/New.hs
    Web/View/Timesheets/Index.hs
    Web/View/Timesheets/New.hs
    Web/View/Timesheets/Edit.hs
    Application/Helper/View/Timesheets.hs
    Web/View/Passkeys/Management.hs
    Web/View/Passkeys/StepUp.hs
    Web/View/LeaveRequests/New.hs
    Web/View/Staff/Edit.hs
    Web/View/StaffProfileSections.hs
    Web/View/RosterWeeks/Grid.hs
    Web/View/RosterWeeks/ShiftDialog.hs
    Web/Controller/RosterWeeks.hs
    Web/View/Admin/Xero.hs
    Web/View/Admin/Xero/ImportedPayItems.hs
    Web/View/Admin/Xero/TimesheetPreparation.hs
)

if find Application/Helper/Frontend -type f -name '*.hs' -print -quit 2>/dev/null | rg --quiet .; then
    report_failure "legacy Application/Helper/Frontend Haskell contract authority must stay deleted"
    find Application/Helper/Frontend -type f -name '*.hs' -print >&2
fi

expect_no_match \
    "production Haskell must not import legacy Application.Helper.Frontend authorities" \
    'Application\.Helper\.Frontend\.' \
    Application Web Test

expect_no_match_including_generated \
    "frontend contract generator must not reintroduce raw TypeScript support contract exports" \
    '"export (type|function) (FrontendSurface(UUID|Day)|HtmxActionOptions|FrontendSurfaceActionManifest|AppShellActionManifest|FrontendSurfaceLiveSubscription|FrontendSurfaceLiveWireFragment|FrontendSurfaceSurfaceFragmentProtection)' \
    Application/Helper/FrontendContract/TypeScript.hs

expect_no_match \
    "migrated FrontendSurface lab must not author old frontend codec/DTO/schema groups" \
    'Application\.Helper\.Frontend\.(Codec|Generic|ContractGroup|Options|Contracts|TypeScript|Dto\.|.*Schema)|FrontendCodec|HasFrontendCodec|someFrontendCodec|genericFrontendCodec' \
    "${lab_paths[@]}"

expect_no_match \
    "migrated FrontendSurface lab must not author TypedLiveSurfaceDefinition paths" \
    'TypedLiveSurfaceDefinition|descriptorToTypedLiveSurfaceDefinition|mkTypedDefinedLiveSurface|serveTypedLiveFragment' \
    "${lab_paths[@]}"

expect_no_match \
    "migrated FrontendSurface lab must use helpers instead of handwritten data-bepis-* attrs" \
    'data-bepis-' \
    "${lab_paths[@]}"

if [ -e Web/LiveSurfaceRegistry.hs ]; then
    report_failure "legacy Web.LiveSurfaceRegistry adapter module must stay deleted"
fi

if [ -e static/vendor/morphdom-umd.min.js ]; then
    report_failure "retired IHP auto-refresh Morphdom asset must stay deleted"
fi

expect_no_match \
    "migrated Timesheets FrontendSurface must not author old TypedLiveSurfaceDefinition paths" \
    'TypedLiveSurfaceDefinition|descriptorToTypedLiveSurfaceDefinition|mkTypedDefinedLiveSurface|serveTypedLiveFragment|timesheetLiveSurfaceDefinition|timesheetProjectionDefinition|respondWithTypedLiveSurfaceFragments' \
    "${timesheets_paths[@]}"

expect_no_match \
    "migrated Timesheets page must not mount legacy live-update attrs" \
    'data-live-update-(surface|url)' \
    Web/View/Timesheets/Index.hs

expect_no_match \
    "Timesheets pilot must use marker-indexed action access instead of reflected protocol-name scans" \
    'registeredFrontendSurfaceContractIR|surfaceHtmxActions|timesheetsAction[[:space:]]*::[[:space:]]*Text' \
    Web/View/Timesheets/Index.hs

expect_no_match \
    "Timesheets pilot must use exact typed values without phantom JSON carriers or required-field fallbacks" \
    'frontendSurfaceFieldValues|getSurfaceField|fromMaybe' \
    Web/Timesheets/FrontendSurface.hs

expect_no_match \
