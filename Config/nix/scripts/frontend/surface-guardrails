#!/usr/bin/env bash
set -euo pipefail

repo_root="${FRONTEND_REPO_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
cd "$repo_root"

failures=0

report_failure() {
    echo "frontend-surface-guardrails: $*" >&2
    failures=$((failures + 1))
}

expect_no_match() {
    local label="$1"
    local pattern="$2"
    shift 2

    local tmp_log
    tmp_log="$(mktemp)"
    if rg --line-number --glob '!*.md' --glob '!*.test.ts' --glob '!*.log' --glob '!generated/**' "$pattern" "$@" >"$tmp_log" 2>/dev/null; then
        report_failure "$label"
        cat "$tmp_log" >&2
    fi
    rm -f "$tmp_log"
}

expect_match() {
    local label="$1"
    local pattern="$2"
    shift 2

    if ! rg --quiet "$pattern" "$@"; then
        report_failure "$label"
    fi
}

lab_paths=(
    Application/Helper/FrontendSurface/Lab.hs
    Web/Support/FrontendSurfaceLab.hs
    Web/View/Support/FrontendSurfaceLab.hs
)

timesheets_paths=(
    Web/Timesheets
    Web/Controller/Timesheets.hs
    Web/View/Timesheets/Index.hs
)

expect_no_match \
    "migrated FrontendSurface lab must not author old FrontendCodec/schema groups" \
    'Application\.Helper\.Frontend\.(Codec|Generic|ContractGroup|.*Schema)|FrontendCodec|HasFrontendCodec|someFrontendCodec|genericFrontendCodec' \
    "${lab_paths[@]}"

expect_no_match \
    "migrated FrontendSurface lab must not author TypedLiveSurfaceDefinition paths" \
    'TypedLiveSurfaceDefinition|descriptorToTypedLiveSurfaceDefinition|mkTypedDefinedLiveSurface|serveTypedLiveFragment' \
    "${lab_paths[@]}"

expect_no_match \
    "migrated FrontendSurface lab must use helpers instead of handwritten data-bepis-* attrs" \
    'data-bepis-' \
    "${lab_paths[@]}"

expect_no_match \
    "migrated FrontendSurface lab must not be registered in legacy Web.LiveSurfaceRegistry" \
    'FrontendSurfaceLab|SurfaceLab|surface-lab' \
    Web/LiveSurfaceRegistry.hs

expect_no_match \
    "migrated Timesheets FrontendSurface must not author old TypedLiveSurfaceDefinition paths" \
    'TypedLiveSurfaceDefinition|descriptorToTypedLiveSurfaceDefinition|mkTypedDefinedLiveSurface|serveTypedLiveFragment|timesheetLiveSurfaceDefinition|timesheetProjectionDefinition|respondWithTypedLiveSurfaceFragments' \
    "${timesheets_paths[@]}"

expect_no_match \
    "migrated Timesheets page must not mount legacy live-update attrs" \
    'data-live-update-(surface|url)' \
    Web/View/Timesheets/Index.hs

expect_match \
    "generated contracts must expose the GHC-generated lab surface manifest" \
    'surfaceLabSurfaceManifest' \
    frontend/ts/generated/contracts.ts

expect_match \
    "generated contracts must expose the lab fragment key union" \
    'SurfaceLabFragmentKey' \
    frontend/ts/generated/contracts.ts

expect_match \
    "generated contracts must expose Admin page contained surface topology" \
    'parentSurface: "admin-page", parentFragment: "admin-page-content", childSurface: "admin-venue-config"' \
    frontend/ts/generated/contracts.ts

expect_match \
    "generated contracts must expose Admin Xero page contained surface topology" \
    'parentSurface: "admin-xero-page", parentFragment: "admin-xero-page-content", childSurface: "admin-xero"' \
    frontend/ts/generated/contracts.ts

expect_no_match \
    "production code must not resurrect shared SurfaceProjection cache plumbing" \
    'Application\.Helper\.SurfaceProjection|SurfaceProjection' \
    Application Web

expect_no_match \
    "production/browser code must not resurrect legacy declarative live-surface attributes" \
    'data-live-update-surface|parseLiveUpdateSurfaceConfig' \
    Application Web frontend/ts e2e static

expect_no_match \
    "frontend contracts must not resurrect legacy live-surface manifest DTOs" \
    'LiveSurfaceManifest|LiveSurfaceFamily|SurfaceManifestSchema|Application\.Helper\.Frontend\.Dto\.LiveSurface' \
    Application Web frontend/ts static

expect_no_match \
    "FrontendSurface specs must use current DSL primitive names" \
    '\b(HtmxAction|ClientEvent|DisposableLayer|InteractionEffect)\b' \
    Application/Helper/FrontendSurface/Admin.hs \
    Application/Helper/FrontendSurface/Billing.hs \
    Application/Helper/FrontendSurface/Lab.hs \
    Application/Helper/FrontendSurface/LeaveRequests.hs \
    Application/Helper/FrontendSurface/Profile.hs \
    Application/Helper/FrontendSurface/Roster.hs \
    Application/Helper/FrontendSurface/Support.hs \
    Application/Helper/FrontendSurface/Timesheets.hs

expect_no_match \
    "live resources must remain generated FrontendSurfaceResourceValue aliases, not a resurrected ADT" \
    '\bdata[[:space:]]+LiveResource\b|\bnewtype[[:space:]]+LiveResource\b' \
    Application Web Test

expect_no_match \
    "temporary LiveResource bridge conversion helpers must stay deleted" \
    'liveResourceToFrontendSurfaceResourceValues|liveResourcesToFrontendSurfaceResourceValues|FrontendSurfaceResourceValue bridge' \
    Application Web Test

expect_no_match \
    "FrontendSurface dependency planning must not use final-state custom dependency hooks" \
    'CustomDependency|custom dependency hook|custom dependency' \
    Application Web Test frontend/ts

expect_no_match \
    "legacy expansion sentinel resource constructors must stay deleted" \
    'leaveCalendarResource|staffRosterMembershipResource|staffPayProfileResource|staffTimesheetResource|rosterSlotResource' \
    Application Web Test

expect_no_match \
    "legacy expansion sentinel resource wire names must stay out of code" \
    '"(leave-calendar|staff-roster-membership|staff-pay-profile|staff-timesheet)"' \
    Application Web Test frontend/ts

expect_no_match \
    "registered live-surface authorization must delegate to generated FrontendSurface scope auth" \
    'CurrentVenueManager|CurrentVenueOwner|CurrentVenueAdmin|CurrentVenueRosterGroup|CurrentVenueStaff|SupportSuperAdmin|NoAuthIR|AuthorizeIR' \
    Web/LiveSurfaceRegistry.hs Web/LiveResourceInvalidation.hs

expect_match \
    "registered live-surface authorization delegates to generated FrontendSurface scope auth" \
    'authorizeRegisteredLiveSurfaceScope = authorizeFrontendSurfaceLiveScope' \
    Web/LiveSurfaceRegistry.hs

expect_match \
    "registered live-surface planning delegates dependency matching to generated FrontendSurface planner" \
    'planFrontendSurfaceInvalidation resources scope planningCandidateFragments' \
    Web/LiveSurfaceRegistry.hs

if [ "$failures" -ne 0 ]; then
    exit 1
fi

echo "frontend-surface-guardrails: ok"
