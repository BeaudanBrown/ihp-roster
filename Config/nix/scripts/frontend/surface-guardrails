mapfile -t generated_adapter_modules < <(
    rg -l '^-- @generated by Application\.Helper\.FrontendContract\.Surface\.HaskellAdapter\.Generator$' \
        Application/Helper/FrontendContract/Surface -g '*.hs' | sort || true
)
mapfile -t generated_resource_modules < <(
    printf '%s\n' "${generated_adapter_modules[@]}" | rg '/Generated/Resource\.hs$' || true
)
if [ "${#generated_resource_modules[@]}" -eq 0 ]; then
    report_failure "generated Surface resource adapter modules are missing"
fi

for generated_module_path in "${generated_adapter_modules[@]}"; do
    feature_dir="${generated_module_path%/Generated/*}"
    generated_kind="${generated_module_path##*/Generated/}"
    generated_kind="${generated_kind%.hs}"
    case "$generated_kind" in
        Resource|Live|Action|Intent)
            ;;
        *)
            report_failure "generated Surface adapter uses an unsupported private namespace: $generated_module_path"
            continue
            ;;
    esac

    curated_facade="$feature_dir/$generated_kind.hs"
    family_module="$feature_dir/HaskellAdapter.hs"
    generated_module_name="${generated_module_path%.hs}"
    generated_module_name="${generated_module_name//\//.}"
    generated_module_pattern="${generated_module_name//./\\.}"
    feature_module_name="${feature_dir//\//.}"
    feature_module_pattern="${feature_module_name//./\\.}"

    if [ ! -f "$curated_facade" ]; then
        report_failure "generated Surface $generated_kind adapter has no matching curated facade: $generated_module_path"
        continue
    fi
    if [ ! -f "$family_module" ]; then
        report_failure "generated Surface $generated_kind adapter has no feature-local family module: $generated_module_path"
        continue
    fi

    mapfile -t generated_consumers < <(
        rg -l --glob '*.hs' "^import (qualified )?${generated_module_pattern}([[:space:]]|$)" Application Web Test 2>/dev/null \
            | sort \
            || true
    )
    if [ "${#generated_consumers[@]}" -ne 1 ] || [ "${generated_consumers[0]:-}" != "$curated_facade" ]; then
        report_failure "private generated $generated_kind module must be consumed only by $curated_facade: $generated_module_name"
        printf '  %s\n' "${generated_consumers[@]:-<no consumers>}" >&2
    fi

    if rg --line-number '^import .*\.Internal|HaskellAdapter\.Registry' "$generated_module_path" >&2; then
        report_failure "generated $generated_kind adapter bypasses an opaque boundary or imports the omnibus registry: $generated_module_path"
    fi

    while IFS= read -r family_import; do
        case "$family_import" in
            *Application.Helper.FrontendContract.Surface.HaskellAdapter.Association*)
                ;;
            *Application.Helper.FrontendContract.Surface.HaskellAdapter.Family*)
                ;;
            *"$feature_module_name"*)
                ;;
            *)
                report_failure "feature adapter family imports an unrelated Surface module: $family_module"
                echo "$family_import" >&2
                ;;
        esac
    done < <(rg '^import (qualified )?Application\.Helper\.FrontendContract\.Surface\.' "$family_module" || true)

    surface_spec="${feature_dir}.hs"
    if rg --line-number \
        "^import (qualified )?(${feature_module_pattern}\\.Generated\\.|${feature_module_pattern}\\.${generated_kind}([[:space:]]|$))" \
        "$family_module" "$surface_spec" >&2; then
        report_failure "Surface specs and family associations must not import generated adapters or curated facades: $feature_module_name"
    fi

    if [ "$generated_kind" = "Resource" ]; then
        for generic_builder in frontendSurfaceResource matchFrontendSurfaceResource; do
            if ! rg --quiet "\\b${generic_builder}\\b" "$generated_module_path"; then
                report_failure "generated resource adapter does not use $generic_builder: $generated_module_path"
            fi
        done
        if rg --line-number '\b(frontendSurfaceResource|matchFrontendSurfaceResource|surface(Field|OptionalField|NullableField))\b' "$curated_facade" >&2; then
            report_failure "curated resource facade retains a handwritten mechanical adapter: $curated_facade"
        fi
    fi
    if [ "$generated_kind" = "Live" ]; then
        for generic_builder in frontendSurfaceScope matchFrontendSurfaceScope frontendSurfaceFragmentKey matchFrontendSurfaceFragmentKey; do
            if ! rg --quiet "\\b${generic_builder}\\b" "$generated_module_path"; then
                report_failure "generated Live adapter does not use $generic_builder: $generated_module_path"
            fi
        done
        if rg --line-number '\b(frontendSurface(Scope|FragmentKey)|matchFrontendSurface(Scope|FragmentKey)|surface(Field|OptionalField|NullableField))\b' "$curated_facade" >&2; then
            report_failure "curated Live facade retains a handwritten mechanical adapter: $curated_facade"
        fi
    fi
    if [ "$generated_kind" = "Action" ]; then
        if ! rg --quiet '\b(noSurfaceActionFields|surfaceActionFields)\b' "$generated_module_path"; then
            report_failure "generated Action adapter does not use a nominal field constructor: $generated_module_path"
        fi
        if ! rg --quiet '\bfrontendSurfaceAction\b' "$generated_module_path"; then
            report_failure "generated Action adapter does not use frontendSurfaceAction: $generated_module_path"
        fi
        if rg --line-number 'SurfaceFields[[:space:]]*\(SurfaceActionFieldSpecs' "$generated_module_path" >&2; then
            report_failure "generated Action adapter exposes structurally typed request bundles: $generated_module_path"
        fi
        if rg --line-number '\b(frontendSurfaceAction|parseSurfaceActionParams|surface(Field|OptionalField|NullableField))\b' "$curated_facade" >&2; then
            report_failure "curated Action facade retains a handwritten mechanical adapter: $curated_facade"
        fi
    fi
    if [ "$generated_kind" = "Intent" ]; then
        if ! rg --quiet '\b(noSurfaceIntentFields|surfaceIntentFields)\b' "$generated_module_path"; then
            report_failure "generated Intent adapter does not use a nominal field constructor: $generated_module_path"
        fi
        for generic_builder in frontendSurfaceIntentForm parseSurfaceIntentParams; do
            if ! rg --quiet "\\b${generic_builder}\\b" "$generated_module_path"; then
                report_failure "generated Intent adapter does not use $generic_builder: $generated_module_path"
            fi
        done
        if rg --line-number 'SurfaceFields[[:space:]]*\(SurfaceIntentFieldSpecs' "$generated_module_path" >&2; then
            report_failure "generated Intent adapter exposes structurally typed request bundles: $generated_module_path"
        fi
        if rg --line-number '\b(frontendSurfaceIntentForm|parseSurfaceIntentParams|surface(Field|OptionalField|NullableField))\b' "$curated_facade" >&2; then
            report_failure "curated Intent facade retains a handwritten mechanical adapter: $curated_facade"
        fi
    fi
done

