    Application/Helper/FrontendContract/Surface/HaskellAdapter/Family.hs \
    Application/Helper/FrontendContract/Surface/HaskellAdapter/Generator.hs \
    Application/Helper/FrontendContract/Surface/HaskellAdapter/Intent.hs \
    Application/Helper/FrontendContract/Surface/HaskellAdapter/Live.hs \
    Application/Helper/FrontendContract/Surface/HaskellAdapter/Registry.hs \
    Application/Helper/FrontendContract/Surface/HaskellAdapter/RequestRenderer.hs \
