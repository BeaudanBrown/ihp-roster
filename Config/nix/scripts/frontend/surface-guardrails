    "server-only mount state and load policy must stay out of generated browser contracts" \
    'MountStateMountState|export type [A-Za-z]+MountState[[:space:]]*=|"mountState"|"loadPolicy"' \
    frontend/ts/generated/contracts.ts

expect_no_match_including_generated \
    "live wire contracts must not expose executable fragment descriptor types" \
    '\b(SurfaceWireFragment|WireSurfaceWireFragment|FrontendSurfaceLiveWireFragment)\b' \
    Application/Helper/FrontendContract/LiveUpdate.hs \
    Application/Helper/FrontendContract/Wire/LiveUpdate.hs \
    frontend/ts/generated/contracts.ts

expect_match \
    "generated contracts must expose the reflected lab surface manifest" \
    'surfaceLabSurfaceManifest' \
    frontend/ts/generated/contracts.ts

expect_match \
    "generated contracts must expose the lab fragment key union" \
    'SurfaceLabFragmentKey' \
    frontend/ts/generated/contracts.ts

expect_match \
    "generated contracts must expose Admin page contained surface topology" \
    'parentSurface: "admin-page", parentFragment: "admin-page-content", childSurface: "admin-venue-config"' \
    frontend/ts/generated/contracts.ts

expect_match \
    "generated contracts must expose Admin Xero page contained surface topology" \
    'parentSurface: "admin-xero-page", parentFragment: "admin-xero-page-content", childSurface: "admin-xero"' \
    frontend/ts/generated/contracts.ts

expect_match \
    "generated contracts must expose Admin Roster Groups action manifests" \
    'adminRosterGroupsSurfaceManifest.*create-roster-group.*move-roster-group-up' \
    frontend/ts/generated/contracts.ts

expect_match \
    "generated contracts must expose declared Admin Roster Groups custom HTMX reason" \
    'move buttons submit the containing row form via hx-include=closest form' \
    frontend/ts/generated/contracts.ts

expect_match \
    "generated contracts must expose migrated feedback overlay opener action" \
    'open-feedback-dialog' \
    frontend/ts/generated/contracts.ts

expect_match \
    "generated contracts must expose migrated feedback overlay submit action" \
    'submit-feedback' \
    frontend/ts/generated/contracts.ts

expect_no_match \
    "migrated overlay request initiators must not hand-author dialog mount targets" \
    'hx-target=\{?"?#"? <> dialogOverlayMountId|hx-target="#dialog-overlay-mount"' \
    "${migrated_overlay_paths[@]}"

expect_no_match \
    "migrated feedback dialog view must not hand-author dialog mount targets" \
    '#dialog-overlay-mount|dialogOverlayMountId' \
    Web/View/Feedback/New.hs

expect_no_match \
