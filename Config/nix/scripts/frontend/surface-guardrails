    "TimesheetWeekShellSyncCustomHtmx|'CustomHtmx|'HtmxRaw" \
    Application/Helper/FrontendContract/Surface/Timesheets.hs \
    Web/View/Timesheets/Index.hs

expect_no_match \
    "feature mounts must not patch descriptor lists after construction" \
    'surfaceImplMountConfig[[:space:]]*=.*mountFragments[[:space:]]*=' \
    Application \
    Web

expect_no_match \
    "production Surface mounts must use one marker-indexed construction step without ceremonial handlers" \
    '\b(mkSurfaceImpl|surfaceImplWithMountedFragments|SurfaceImplHandlers|FrontendSurface(Scope|MountState|Fragment|Action|Intent)Handler|fragmentHandlerRender|surfaceImplActions)\b' \
    Application \
    Web

expect_no_match \
    "production Surface mounts must not construct fake nil-id action routes" \
    'Id[[:space:]]+UUID\.nil|placeholderRosterDayId' \
    Application/Support/LiveUpdates.hs \
    Web/Admin/FrontendSurface.hs \
    Web/LeaveRequests/FrontendSurface.hs \
    Web/Profiles/FrontendSurface.hs \
    Web/RosterWeeks/FrontendSurface.hs

expect_no_match \
    "FrontendSurface mount parsing must remain generated" \
    'function[[:space:]]+(is|parse)FrontendSurfaceMountConfig' \
    frontend/ts/app-live-updates.ts \
    frontend/ts/live-updates

expect_no_match \
    "live mount parsing must not recover authority through unsafe double casts" \
    'as[[:space:]]+unknown[[:space:]]+as' \
    frontend/ts/app-live-updates.ts \
    frontend/ts/live-updates

expect_no_match \
    "live mount runtime must consume generated descriptor types without compatibility aliases" \
    '\bLiveUpdateMountedFragment\b' \
    frontend/ts

expect_no_match_including_generated \
    "obsolete aggregate mount aliases must stay deleted" \
    '\b(FrontendSurfaceLiveSubscription|FrontendSurfaceScope|FrontendSurfaceMountedFragmentKeyConfig|FrontendSurfaceSurfaceFragmentProtection)\b' \
    Application/Helper/FrontendContract \
    frontend/ts/generated/contracts.ts \
    frontend/ts/live-updates

expect_no_match \
    "Haskell live consumers must use reflected endpoint, header, and mount DOM constants" \
    '"/?live-updates"|"X-Live-Update-Client-Id"|"data-bepis-surface"|"data-bepis-surface-config"|"data-bepis-surface-action"' \
