#!/usr/bin/env bash
set -euo pipefail
printf 'path\t%s\n' frontend/ts/generated/contracts.ts
if [ -d Application/Helper/FrontendContract/Surface ]; then
    rg -l '^-- @generated by Application\.Helper\.FrontendContract\.Surface\.HaskellAdapter\.Generator$' \
        Application/Helper/FrontendContract/Surface -g '*.hs' 2>/dev/null \
        | LC_ALL=C sort | while IFS= read -r path; do printf 'path\t%s\n' "$path"; done
fi
