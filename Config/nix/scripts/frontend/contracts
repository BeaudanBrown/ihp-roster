#!/usr/bin/env bash
set -euo pipefail
repo_root="${FRONTEND_REPO_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
cd "$repo_root"

# shellcheck source=../lib/ghc.sh
. "${BEPIS_SCRIPTS_ROOT:?}/lib/ghc.sh"
# shellcheck source=tool-package-lib
. "${BEPIS_SCRIPTS_ROOT:?}/frontend/tool-package-lib"

output_path="${1:-frontend/ts/generated/contracts.ts}"

build_dir="${FRONTEND_CONTRACTS_BUILD_DIR:-$PWD/build/FrontendContracts}"
mkdir -p "$(dirname "$output_path")"
if generator="$(frontend_contract_tool_binary generate-frontend-contracts)"; then
    echo "frontend-contracts: using isolated tooling package" >&2
else
    GHC_OPTS="$(ihp_roster_ghc_opts)"
    ihp_roster_prepare_ghc_build_dir "$build_dir" "$GHC_OPTS"
    echo "frontend-contracts: compiling reflected FrontendContract generator" >&2
    ghc $GHC_OPTS Application/Script/GenerateFrontendContracts.hs \
        -main-is Application.Script.GenerateFrontendContracts \
        -odir "$build_dir/obj" \
        -hidir "$build_dir/hi" \
        -o "$build_dir/generate-frontend-contracts" >/dev/null
    generator="$build_dir/generate-frontend-contracts"
fi

tmp_output="$(mktemp "$(dirname "$output_path")/.contracts.ts.XXXXXX")"
echo "frontend-contracts: rendering checked reflected registry" >&2
"$generator" "$tmp_output"

if [ -f "$output_path" ] && cmp -s "$tmp_output" "$output_path"; then
    rm -f "$tmp_output"
else
    mv "$tmp_output" "$output_path"
fi
