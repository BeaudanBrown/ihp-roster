#!/usr/bin/env bash
set -euo pipefail

repo_root="${FRONTEND_REPO_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
cd "$repo_root"

# shellcheck source=../lib/authority-scan.sh
. "${BEPIS_SCRIPTS_ROOT:-$repo_root/Config/nix/scripts}/lib/authority-scan.sh"

defaults="$(authority_scan rg '^\s*default:' frontend/ts --glob '!generated/**' -n)"
status=0
while IFS=: read -r file line _; do
    [ -n "$file" ] || continue
    block="$(sed -n "${line},$((line + 4))p" "$file")"
    if [[ "$block" != *'assertNever('* ]]; then
        echo "Broad switch default without assertNever: $file:$line" >&2
        status=1
    fi
done <<<"$defaults"

exit "$status"
