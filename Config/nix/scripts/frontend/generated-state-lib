#!/usr/bin/env bash
# Shared fingerprints and manifests for cache-aware generated frontend artifacts.

frontend_generated_state_dir() {
    printf '%s/generated-code\n' "$(dev-agent-state-dir)"
}

frontend_hash_paths() {
    local path
    while IFS= read -r path; do
        [ -n "$path" ] || continue
        printf 'path:%s\n' "$path"
        if [ -f "$path" ]; then
            sha256sum "$path"
        else
            printf 'missing:%s\n' "$path"
        fi
    done | sha256sum | cut -d ' ' -f 1
}

frontend_contract_input_hash() {
    local files_hash tool_identity
    files_hash="$({
        printf '%s\n' \
            App.cabal \
            flake.lock \
            Application/Script/GenerateFrontendContracts.hs \
            Application/Script/GenerateFrontendSurfaceAdapters.hs \
            Config/nix/scripts/frontend/contracts \
            Config/nix/scripts/frontend/surface-adapters \
            Config/nix/scripts/frontend/surface-adapter-publish-lib \
            Config/nix/scripts/frontend/generated-state-lib \
            Config/nix/scripts/lib/ghc.sh
        find Application/Helper/FrontendContract \
            -type d -name Generated -prune -o \
            -type f -name '*.hs' -print
    } | LC_ALL=C sort -u | frontend_hash_paths)"
    # App.cabal and flake.lock own the package environment. Absolute Nix store
    # paths are deliberately excluded so equivalent shells cannot invalidate
    # each other's manifest.
    tool_identity="ghc:$({ ghc --numeric-version 2>/dev/null || printf 'missing'; } | tr -d '\n')"
    printf '%s\n%s\n' "$files_hash" "$tool_identity" | sha256sum | cut -d ' ' -f 1
}

frontend_contract_output_paths() {
    local path
    printf '%s\n' frontend/ts/generated/contracts.ts
    if [ -d Application/Helper/FrontendContract/Surface ]; then
        while IFS= read -r -d '' path; do
            if grep -q '^-- @generated by Application\.Helper\.FrontendContract\.Surface\.HaskellAdapter\.Generator$' "$path"; then
                printf '%s\n' "$path"
            fi
        done < <(find Application/Helper/FrontendContract/Surface -type f -name '*.hs' -print0)
    fi
}

frontend_contract_output_hash() {
    frontend_contract_output_paths | LC_ALL=C sort -u | frontend_hash_paths
}

frontend_js_input_hash() {
    {
        printf '%s\n' tsconfig.json Config/nix/scripts/frontend/build
        find frontend/ts -type f -name '*.ts' -print
    } | LC_ALL=C sort -u | frontend_hash_paths
}

frontend_js_output_paths() {
    printf '%s\n' \
        static/app.js \
        static/dev-timer-tracking.js
}

frontend_js_output_hash() {
    frontend_js_output_paths | LC_ALL=C sort -u | frontend_hash_paths
}

frontend_manifest_matches() {
    local manifest="$1"
    local expected_input="$2"
    local expected_output="$3"
    [ -f "$manifest" ] || return 1
    local recorded_input="" recorded_output=""
    IFS=' ' read -r recorded_input recorded_output < "$manifest" || return 1
    [ "$recorded_input" = "$expected_input" ] && [ "$recorded_output" = "$expected_output" ]
}

frontend_write_manifest() {
    local manifest="$1"
    local input_hash="$2"
    local output_hash="$3"
    local tmp
    mkdir -p "$(dirname "$manifest")"
    tmp="$(mktemp "${manifest}.XXXXXX")"
    printf '%s %s\n' "$input_hash" "$output_hash" > "$tmp"
    mv "$tmp" "$manifest"
}

frontend_generation_lock() {
    local state_dir
    state_dir="$(frontend_generated_state_dir)"
    mkdir -p "$state_dir"
    exec 9>"$state_dir/generation.lock"
    flock 9
}

frontend_generated_watch_lock() {
    local state_dir
    state_dir="$(frontend_generated_state_dir)"
    mkdir -p "$state_dir"
    exec 8>"$state_dir/contracts-watch.lock"
    flock -n 8
}

frontend_js_watch_lock() {
    local state_dir
    state_dir="$(frontend_generated_state_dir)"
    mkdir -p "$state_dir"
    exec 7>"$state_dir/js-watch.lock"
    flock -n 7
}
