#!/usr/bin/env bash
set -euo pipefail
repo_root="${FRONTEND_REPO_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
cd "$repo_root"

if [ -f "@scriptsRoot@/lib/ghc.sh" ]; then
    # shellcheck source=../lib/ghc.sh
    . "@scriptsRoot@/lib/ghc.sh"
else
    # shellcheck source=../lib/ghc.sh
    . "Config/nix/scripts/lib/ghc.sh"
fi

build_dir="${FRONTEND_SURFACE_ADAPTERS_BUILD_DIR:-$PWD/build/FrontendSurfaceAdapters}"
GHC_OPTS="$(ihp_roster_ghc_opts)"
ihp_roster_prepare_ghc_build_dir "$build_dir" "$GHC_OPTS"
echo "frontend-surface-adapters: compiling checked-IR Haskell generator" >&2
ghc $GHC_OPTS Application/Script/GenerateFrontendSurfaceAdapters.hs \
    -main-is Application.Script.GenerateFrontendSurfaceAdapters \
    -odir "$build_dir/obj" \
    -hidir "$build_dir/hi" \
    -o "$build_dir/generate-frontend-surface-adapters" >/dev/null

tmp_dir="$(mktemp -d)"
cleanup() {
    rm -rf "$tmp_dir"
}
trap cleanup EXIT

echo "frontend-surface-adapters: rendering typed adapter homes" >&2
"$build_dir/generate-frontend-surface-adapters" "$tmp_dir"

mapfile -t expected_files < <(find "$tmp_dir" -type f -name '*.hs' -print | sort)
for generated_file in "${expected_files[@]}"; do
    stylish-haskell -i "$generated_file"
done

managed_root="Application/Helper/FrontendContract/Surface"
generated_header='^-- @generated by Application\.Helper\.FrontendContract\.Surface\.HaskellAdapter\.Generator$'
mapfile -t current_files < <(rg -l "$generated_header" "$managed_root" -g '*.hs' | sort || true)

declare -A expected_paths=()
for generated_file in "${expected_files[@]}"; do
    relative_path="${generated_file#"$tmp_dir"/}"
    expected_paths["$relative_path"]=1
done

for current_file in "${current_files[@]}"; do
    if [ -z "${expected_paths[$current_file]:-}" ]; then
        echo "frontend-surface-adapters: removing stale generated module $current_file" >&2
        rm -f "$current_file"
        rmdir "$(dirname "$current_file")" 2>/dev/null || true
    fi
done

for generated_file in "${expected_files[@]}"; do
    relative_path="${generated_file#"$tmp_dir"/}"
    mkdir -p "$(dirname "$relative_path")"
    if [ -f "$relative_path" ] && cmp -s "$generated_file" "$relative_path"; then
        continue
    fi
    temporary_target="${relative_path}.tmp.$$"
    cp "$generated_file" "$temporary_target"
    mv "$temporary_target" "$relative_path"
    echo "frontend-surface-adapters: wrote $relative_path" >&2
done

echo "frontend-surface-adapters: generated ${#expected_files[@]} module(s)" >&2
