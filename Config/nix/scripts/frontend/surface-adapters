#!/usr/bin/env bash
set -euo pipefail
repo_root="${FRONTEND_REPO_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
cd "$repo_root"

if [ -f "@scriptsRoot@/lib/ghc.sh" ]; then
    # shellcheck source=../lib/ghc.sh
    . "@scriptsRoot@/lib/ghc.sh"
    # shellcheck source=tool-package-lib
    . "@scriptsRoot@/frontend/tool-package-lib"
else
    # shellcheck source=../lib/ghc.sh
    . "Config/nix/scripts/lib/ghc.sh"
    # shellcheck source=tool-package-lib
    . "Config/nix/scripts/frontend/tool-package-lib"
fi
if [ -f "@scriptsRoot@/frontend/surface-adapter-publish-lib" ]; then
    # shellcheck source=surface-adapter-publish-lib
    . "@scriptsRoot@/frontend/surface-adapter-publish-lib"
else
    # shellcheck source=surface-adapter-publish-lib
    . "Config/nix/scripts/frontend/surface-adapter-publish-lib"
fi

build_dir="${FRONTEND_SURFACE_ADAPTERS_BUILD_DIR:-$PWD/build/FrontendSurfaceAdapters}"
publication_root="${FRONTEND_SURFACE_ADAPTERS_PUBLICATION_ROOT:-$PWD}"
GHC_OPTS="$(ihp_roster_ghc_opts)"
if generator="$(frontend_contract_tool_binary generate-frontend-surface-adapters)"; then
    echo "frontend-surface-adapters: using isolated tooling package" >&2
else
    ihp_roster_prepare_ghc_build_dir "$build_dir" "$GHC_OPTS"
    echo "frontend-surface-adapters: compiling checked-IR Haskell generator" >&2
    ghc $GHC_OPTS Application/Script/GenerateFrontendSurfaceAdapters.hs \
        -main-is Application.Script.GenerateFrontendSurfaceAdapters \
        -odir "$build_dir/obj" \
        -hidir "$build_dir/hi" \
        -o "$build_dir/generate-frontend-surface-adapters" >/dev/null
    generator="$build_dir/generate-frontend-surface-adapters"
fi

tmp_dir="$(mktemp -d)"
proof_dir="$(mktemp -d)"
cleanup() {
    rm -rf "$tmp_dir" "$proof_dir"
}
trap cleanup EXIT

echo "frontend-surface-adapters: rendering typed adapter homes" >&2
"$generator" "$tmp_dir" "$proof_dir"

mapfile -t expected_files < <(find "$tmp_dir" -type f -name '*.hs' -print | sort)
mapfile -t proof_files < <(find "$proof_dir" -type f -name '*.hs' -print | sort)
for generated_file in "${expected_files[@]}" "${proof_files[@]}"; do
    stylish-haskell -i "$generated_file"
done

validate_staged_modules() {
    local stage_root="$1"
    shift
    local validation_dir="$stage_root/.validation"
    local validation_ghc_opts="$GHC_OPTS -i$stage_root"

    ihp_roster_prepare_ghc_build_dir "$validation_dir" "$validation_ghc_opts"
    echo "frontend-surface-adapters: typechecking complete staged module set" >&2
    ghc -no-link $validation_ghc_opts "$@" "${proof_files[@]}" \
        -odir "$validation_dir/obj" \
        -hidir "$validation_dir/hi" >/dev/null
}

surface_adapter_publish_managed_set \
    "$tmp_dir" \
    "$publication_root" \
    validate_staged_modules
