#!/usr/bin/env bash
set -euo pipefail
repo_root="${FRONTEND_REPO_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
cd "$repo_root"

if [ -f "@scriptsRoot@/lib/ghc.sh" ]; then
    # shellcheck source=../lib/ghc.sh
    . "@scriptsRoot@/lib/ghc.sh"
else
    # shellcheck source=../lib/ghc.sh
    . "Config/nix/scripts/lib/ghc.sh"
fi

build_dir="${FRONTEND_SURFACE_GHC_PROBE_BUILD_DIR:-$PWD/build/FrontendSurfaceGhcProbe}"
GHC_OPTS="$(ihp_roster_ghc_opts)"
ihp_roster_prepare_ghc_build_dir "$build_dir" "$GHC_OPTS -package ghc"
ghc $GHC_OPTS -package ghc Application/Script/FrontendSurfaceGhcProbe.hs \
    -main-is Application.Script.FrontendSurfaceGhcProbe \
    -odir "$build_dir/obj" \
    -hidir "$build_dir/hi" \
    -o "$build_dir/frontend-surface-ghc-probe" >/dev/null

FRONTEND_SURFACE_GHC_API_BUILD_DIR="$build_dir/ghc-api" \
    "$build_dir/frontend-surface-ghc-probe" "$@" "$(ghc --print-libdir)"
