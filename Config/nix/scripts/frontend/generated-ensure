#!/usr/bin/env bash
set -euo pipefail

repo_root="${FRONTEND_REPO_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
cd "$repo_root"
scripts_root="${BEPIS_SCRIPTS_ROOT:?}"
tooling_launcher="${BEPIS_TOOLING_LAUNCHER:-$repo_root/bin/tooling-run}"
state_dir="$(dev-agent-state-dir)/generated-code"
mkdir -p "$state_dir"

contract_result="$("$tooling_launcher" artifacts generate --mode ensure --root "$repo_root" \
    --lock "$state_dir/generation.lock" --manifest "$state_dir/frontend-contracts.manifest" \
    --input-command "$scripts_root/frontend/contracts-input-inventory" \
    --output-command "$scripts_root/frontend/contracts-output-inventory" -- \
    "$scripts_root/frontend/generate-contract-artifacts")"
if [ "$contract_result" = current ]; then
    echo "frontend-generated-ensure: Haskell adapters and TypeScript contracts are current"
else
    echo "frontend-generated-ensure: regenerated Haskell adapters and TypeScript contracts"
fi

js_result="$("$tooling_launcher" artifacts generate --mode ensure --root "$repo_root" \
    --lock "$state_dir/generation.lock" --manifest "$state_dir/frontend-js.manifest" \
    --input-command "$scripts_root/frontend/js-input-inventory" \
    --output-command "$scripts_root/frontend/js-output-inventory" -- frontend-build)"
if [ "$js_result" = current ]; then
    echo "frontend-generated-ensure: JavaScript bundles are current"
else
    echo "frontend-generated-ensure: rebuilt JavaScript bundles"
fi
