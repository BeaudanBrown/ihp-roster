#!/usr/bin/env bash
set -euo pipefail
repo_root="${FRONTEND_REPO_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
cd "$repo_root"

if [ -f "@scriptsRoot@/lib/ghc.sh" ]; then
    # shellcheck source=../lib/ghc.sh
    . "@scriptsRoot@/lib/ghc.sh"
    # shellcheck source=tool-package-lib
    . "@scriptsRoot@/frontend/tool-package-lib"
else
    # shellcheck source=../lib/ghc.sh
    . "Config/nix/scripts/lib/ghc.sh"
    # shellcheck source=tool-package-lib
    . "Config/nix/scripts/frontend/tool-package-lib"
fi

expected="frontend/ts/generated/contracts.ts"
tmp_dir="$(mktemp -d)"
cleanup() {
    rm -rf "$tmp_dir"
}
trap cleanup EXIT
actual="$tmp_dir/contracts.ts"
build_dir="${FRONTEND_CONTRACTS_BUILD_DIR:-$PWD/build/FrontendContracts}"

if generator="$(frontend_contract_tool_binary generate-frontend-contracts)"; then
    echo "frontend-contracts-check: using isolated tooling package" >&2
else
    GHC_OPTS="$(ihp_roster_ghc_opts)"
    ihp_roster_prepare_ghc_build_dir "$build_dir" "$GHC_OPTS"
    echo "frontend-contracts-check: compiling reflected FrontendContract generator" >&2
    ghc $GHC_OPTS Application/Script/GenerateFrontendContracts.hs \
        -main-is Application.Script.GenerateFrontendContracts \
        -odir "$build_dir/obj" \
        -hidir "$build_dir/hi" \
        -o "$build_dir/generate-frontend-contracts" >/dev/null
    generator="$build_dir/generate-frontend-contracts"
fi
echo "frontend-contracts-check: rendering checked reflected registry" >&2
"$generator" "$actual"

if [ ! -f "$expected" ]; then
    echo "frontend-contracts-check: missing generated file $expected" >&2
    exit 1
fi

if ! cmp -s "$actual" "$expected"; then
    echo "frontend-contracts-check: $expected is stale; run bash ./bin/in-env frontend-contracts" >&2
    diff -u "$expected" "$actual" || true
    exit 1
fi
