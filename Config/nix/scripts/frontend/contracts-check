#!/usr/bin/env bash
set -euo pipefail
repo_root="${FRONTEND_REPO_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
cd "$repo_root"

if [ -f "@scriptsRoot@/lib/ghc.sh" ]; then
    # shellcheck source=../lib/ghc.sh
    . "@scriptsRoot@/lib/ghc.sh"
else
    # shellcheck source=../lib/ghc.sh
    . "Config/nix/scripts/lib/ghc.sh"
fi

expected="frontend/ts/generated/contracts.ts"
tmp_dir="$(mktemp -d)"
cleanup() {
    rm -rf "$tmp_dir"
}
trap cleanup EXIT
actual="$tmp_dir/contracts.ts"

mkdir -p "$tmp_dir/obj" "$tmp_dir/hi"
GHC_OPTS="$(ihp_roster_ghc_opts)"
echo "frontend-contracts-check: compiling GHC FrontendSurface contract generator" >&2
ghc $GHC_OPTS -package ghc Application/Script/GenerateFrontendContractsGhc.hs \
    -main-is Application.Script.GenerateFrontendContractsGhc \
    -odir "$tmp_dir/obj" \
    -hidir "$tmp_dir/hi" \
    -o "$tmp_dir/generate-frontend-contracts" >/dev/null
echo "frontend-contracts-check: extracting FrontendSurface registry with GHC API" >&2
"$tmp_dir/generate-frontend-contracts" "$(ghc --print-libdir)" "$actual"

if [ ! -f "$expected" ]; then
    echo "frontend-contracts-check: missing generated file $expected" >&2
    exit 1
fi

if ! cmp -s "$actual" "$expected"; then
    echo "frontend-contracts-check: $expected is stale; run bash ./bin/in-env frontend-contracts" >&2
    diff -u "$expected" "$actual" || true
    exit 1
fi
