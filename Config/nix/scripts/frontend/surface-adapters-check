#!/usr/bin/env bash
set -euo pipefail
repo_root="${FRONTEND_REPO_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
cd "$repo_root"

# shellcheck source=../lib/ghc.sh
. "${BEPIS_SCRIPTS_ROOT:?}/lib/ghc.sh"
# shellcheck source=tool-package-lib
. "${BEPIS_SCRIPTS_ROOT:?}/frontend/tool-package-lib"

build_dir="${FRONTEND_SURFACE_ADAPTERS_BUILD_DIR:-$PWD/build/FrontendSurfaceAdapters}"
GHC_OPTS="$(ihp_roster_ghc_opts)"
if generator="$(frontend_contract_tool_binary generate-frontend-surface-adapters)"; then
    echo "frontend-surface-adapters-check: using isolated tooling package" >&2
else
    ihp_roster_prepare_ghc_build_dir "$build_dir" "$GHC_OPTS"
    echo "frontend-surface-adapters-check: compiling checked-IR Haskell generator" >&2
    ghc $GHC_OPTS Application/Script/GenerateFrontendSurfaceAdapters.hs \
        -main-is Application.Script.GenerateFrontendSurfaceAdapters \
        -odir "$build_dir/obj" \
        -hidir "$build_dir/hi" \
        -o "$build_dir/generate-frontend-surface-adapters" >/dev/null
    generator="$build_dir/generate-frontend-surface-adapters"
fi

tmp_dir="$(mktemp -d)"
proof_dir="$(mktemp -d)"
cleanup() {
    ihp_roster_release_verification_cache
    rm -rf "$tmp_dir" "$proof_dir"
}
trap cleanup EXIT

"$generator" "$tmp_dir" "$proof_dir"
mapfile -t expected_files < <(find "$tmp_dir" -type f -name '*.hs' -print | sort)
mapfile -t proof_files < <(find "$proof_dir" -type f -name '*.hs' -print | sort)
for generated_file in "${expected_files[@]}" "${proof_files[@]}"; do
    stylish-haskell -i "$generated_file"
done

validation_dir="$tmp_dir/.validation"
validation_ghc_opts="$GHC_OPTS -i$tmp_dir"
ihp_roster_prepare_verification_cache "surface-adapter-validation" "$validation_ghc_opts" "v1"
mkdir -p "$IHP_ROSTER_GHC_CACHE_DIR/obj" "$IHP_ROSTER_GHC_CACHE_DIR/hi"
echo "frontend-surface-adapters-check: typechecking managed modules and private authority proofs" >&2
ghc -no-link $validation_ghc_opts "${expected_files[@]}" "${proof_files[@]}" \
    -odir "$IHP_ROSTER_GHC_CACHE_DIR/obj" \
    -hidir "$IHP_ROSTER_GHC_CACHE_DIR/hi" >/dev/null

managed_root="Application/Helper/FrontendContract/Surface"
generated_header='^-- @generated by Application\.Helper\.FrontendContract\.Surface\.HaskellAdapter\.Generator$'
mapfile -t current_files < <(rg -l "$generated_header" "$managed_root" -g '*.hs' | sort || true)
mapfile -t expected_paths < <(
    for generated_file in "${expected_files[@]}"; do
        printf '%s\n' "${generated_file#"$tmp_dir"/}"
    done | sort
)

failed=0
for expected_path in "${expected_paths[@]}"; do
    if [ ! -f "$expected_path" ]; then
        echo "frontend-surface-adapters-check: missing generated module $expected_path" >&2
        failed=1
    fi
done
for current_file in "${current_files[@]}"; do
    found=0
    for expected_path in "${expected_paths[@]}"; do
        if [ "$current_file" = "$expected_path" ]; then
            found=1
            break
        fi
    done
    if [ "$found" -eq 0 ]; then
        echo "frontend-surface-adapters-check: stale generated module $current_file" >&2
        failed=1
    fi
done

for generated_file in "${expected_files[@]}"; do
    expected_path="${generated_file#"$tmp_dir"/}"
    if [ -f "$expected_path" ] && ! cmp -s "$generated_file" "$expected_path"; then
        echo "frontend-surface-adapters-check: $expected_path is stale" >&2
        diff -u "$expected_path" "$generated_file" || true
        failed=1
    fi
done

if [ "$failed" -ne 0 ]; then
    echo "frontend-surface-adapters-check: run bash ./bin/in-env frontend-surface-adapters" >&2
    exit 1
fi

echo "frontend-surface-adapters-check: ${#expected_files[@]} generated module(s) are current" >&2
