#!/usr/bin/env bash
set -euo pipefail

if [ -f "@scriptsRoot@/frontend/surface-adapter-publish-lib" ]; then
    # shellcheck source=surface-adapter-publish-lib
    . "@scriptsRoot@/frontend/surface-adapter-publish-lib"
else
    # shellcheck source=surface-adapter-publish-lib
    . "Config/nix/scripts/frontend/surface-adapter-publish-lib"
fi

tmp_root="$(mktemp -d)"
cleanup() {
    rm -rf "$tmp_root"
}
trap cleanup EXIT

stage_root="$tmp_root/stage"
publication_root="$tmp_root/published"
managed_relative="Application/Helper/FrontendContract/Surface/Fixture/Generated"
mkdir -p "$stage_root/$managed_relative" "$publication_root/$managed_relative"

header='-- @generated by Application.Helper.FrontendContract.Surface.HaskellAdapter.Generator'
for lane in Resource Action Intent; do
    printf '%s\n%s\n' "$header" "${lane,,}-sentinel" \
        >"$publication_root/$managed_relative/$lane.hs"
done
printf '%s\nmodule Fixture.Generated.Live where\n' "$header" \
    >"$stage_root/$managed_relative/Live.hs"

before="$(find "$publication_root" -type f -print0 | sort -z | xargs -0 sha256sum)"
reject_staged_tree() {
    return 1
}

if surface_adapter_publish_managed_set "$stage_root" "$publication_root" reject_staged_tree; then
    echo "surface-adapter-publication-test: injected validation failure unexpectedly published" >&2
    exit 1
fi

after="$(find "$publication_root" -type f -print0 | sort -z | xargs -0 sha256sum)"
if [ "$before" != "$after" ]; then
    echo "surface-adapter-publication-test: validation failure changed existing managed files" >&2
    diff -u <(printf '%s\n' "$before") <(printf '%s\n' "$after") >&2 || true
    exit 1
fi
if [ -e "$publication_root/$managed_relative/Live.hs" ]; then
    echo "surface-adapter-publication-test: validation failure published a partial Live module" >&2
    exit 1
fi

echo "surface-adapter-publication-test: ok"
