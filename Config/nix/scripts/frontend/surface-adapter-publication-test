#!/usr/bin/env bash
set -euo pipefail
repo_root="$(git rev-parse --show-toplevel)"
tooling_launcher="$repo_root/bin/tooling-run"
tmp_root="$(mktemp -d)"
trap 'rm -rf "$tmp_root"' EXIT
fail() { echo "surface-adapter-publication-test: $*" >&2; exit 1; }

stage_root="$tmp_root/stage"
publication_root="$tmp_root/published"
recovery_root="$tmp_root/recovery"
managed_relative="Application/Helper/FrontendContract/Surface/Fixture/Generated"
marker='-- @generated by Application.Helper.FrontendContract.Surface.HaskellAdapter.Generator'
mkdir -p "$stage_root/$managed_relative" "$publication_root/$managed_relative" "$tmp_root/bin"
for lane in Resource Live Action; do
    printf '%s\n%s\n' "$marker" "${lane,,}-sentinel" >"$publication_root/$managed_relative/$lane.hs"
done
printf 'module Handwritten where\n' >"$publication_root/$managed_relative/Handwritten.hs"
printf '%s\nmodule Fixture.Generated.Intent where\n' "$marker" >"$stage_root/$managed_relative/Intent.hs"
printf '#!/usr/bin/env bash\nexit 1\n' >"$tmp_root/bin/reject"
printf '#!/usr/bin/env bash\nexit 0\n' >"$tmp_root/bin/accept"
chmod +x "$tmp_root/bin/"*

before="$(find "$publication_root" -type f -print0 | sort -z | xargs -0 sha256sum)"
set +e
"$tooling_launcher" artifacts publish-managed --stage "$stage_root" --root "$publication_root" \
    --managed-relative Application/Helper/FrontendContract/Surface --marker "$marker" \
    --recovery "$recovery_root" -- "$tmp_root/bin/reject" >/dev/null 2>&1
rejected=$?
set -e
[ "$rejected" -ne 0 ] || fail "injected validation failure unexpectedly published"
after="$(find "$publication_root" -type f -print0 | sort -z | xargs -0 sha256sum)"
[ "$before" = "$after" ] || fail "validation failure changed existing managed files"
[ -f "$recovery_root/$managed_relative/Intent.hs" ] || fail "validation failure omitted recovery evidence"

"$tooling_launcher" artifacts publish-managed --stage "$stage_root" --root "$publication_root" \
    --managed-relative Application/Helper/FrontendContract/Surface --marker "$marker" \
    --recovery "$recovery_root" -- "$tmp_root/bin/accept" >/dev/null
[ -f "$publication_root/$managed_relative/Intent.hs" ] || fail "validated output was not published"
[ -f "$publication_root/$managed_relative/Handwritten.hs" ] || fail "handwritten file was removed"
for stale in Resource Live Action; do
    [ ! -e "$publication_root/$managed_relative/$stale.hs" ] || fail "stale managed output was retained"
done

echo "surface-adapter-publication-test: ok"
