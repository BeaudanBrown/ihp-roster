#!/usr/bin/env bash
set -euo pipefail
unset DEVENV_AGENT_STATE_DIR XDG_RUNTIME_DIR DEV_POSTGRES_MODE DEV_POSTGRES_ROOT DEV_POSTGRES_SOCKET PGHOST DATABASE_URL

repo_root="$(git rev-parse --show-toplevel)"
export BEPIS_TOOLING_LAUNCHER="$repo_root/bin/tooling-run"
registry_command="$repo_root/Config/nix/scripts/epic/worktree"
fixture_root="$(mktemp -d)"
main_pid=""
epic_pid=""
foreground_pid=""
cleanup() {
    for pid in "$main_pid" "$epic_pid" "$foreground_pid"; do
        if [ -n "$pid" ]; then
            kill -TERM -- -"$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null || true
        fi
    done
    rm -rf "$fixture_root"
}
trap cleanup EXIT

fail() {
    echo "dev-runtime-isolation-test: $*" >&2
    exit 1
}

assert_contains() {
    local haystack="$1"
    local needle="$2"
    [[ "$haystack" == *"$needle"* ]] || fail "expected marker was absent: $needle"
}

for command_name in dev-app dev-start dev-foreground dev-status dev-stop pwcli-auth-open; do
    command -v "$command_name" >/dev/null 2>&1 || fail "named command unavailable: $command_name"
done
dev_app_command="$(command -v dev-app)"
dev_start_command="$(command -v dev-start)"
dev_foreground_command="$(command -v dev-foreground)"
dev_status_command="$(command -v dev-status)"
dev_stop_command="$(command -v dev-stop)"
pwcli_auth_open_command="$(command -v pwcli-auth-open)"

fixture_repo="$fixture_root/repo"
epic_path="$fixture_root/repo-epic-265"
git init --quiet --initial-branch=roster "$fixture_repo"
git -C "$fixture_repo" config user.name "Runtime Isolation Test"
git -C "$fixture_repo" config user.email "runtime-isolation@example.invalid"
printf 'fixture\n' >"$fixture_repo/README"
printf '.bepis-epic-worktree.json\n.devenv/\n' >"$fixture_repo/.gitignore"
mkdir -p "$fixture_repo/Config/nix/flake"
cp -R "$repo_root/Config/nix/scripts" "$fixture_repo/Config/nix/scripts"
cp "$repo_root/Config/nix/flake/scripts.nix" "$fixture_repo/Config/nix/flake/scripts.nix"
# Runtime isolation uses no Haskell schema; generation has its own focused tests.
printf '#!/usr/bin/env bash\nexit 0\n' >"$fixture_repo/Config/nix/scripts/haskell/generated-ensure"
git -C "$fixture_repo" add README .gitignore Config
git -C "$fixture_repo" commit --quiet -m fixture
git -C "$fixture_repo" worktree add --quiet -b epic-265 "$epic_path" roster
(
    cd "$epic_path"
    bash "$registry_command" register --epic 265 --target roster --kind epic >/dev/null
)

fake_bin="$fixture_root/bin"
mkdir -p "$fake_bin"
cat >"$fake_bin/dev-status" <<'EOF'
#!/usr/bin/env bash
exit 1
EOF
for ensure in frontend-generated-ensure haskell-generated-ensure; do
    cat >"$fake_bin/$ensure" <<'EOF'
#!/usr/bin/env bash
exit 0
EOF
done
cat >"$fake_bin/dev-ensure-postgres" <<'EOF'
#!/usr/bin/env bash
exit 0
EOF
cat >"$fake_bin/dev-postgres" <<'EOF'
#!/usr/bin/env bash
exit 0
EOF
cat >"$fake_bin/dev-ensure-mailhog" <<'EOF'
#!/usr/bin/env bash
exit 0
EOF
cat >"$fake_bin/dev-observability-stop" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' "$DEVENV_AGENT_STATE_DIR" >>"$OBS_STOP_LOG"
rm -f "$DEVENV_AGENT_STATE_DIR/tempo.pid" \
    "$DEVENV_AGENT_STATE_DIR/otel-collector.pid" \
    "$DEVENV_AGENT_STATE_DIR/grafana.pid"
EOF
for watcher in frontend-watch frontend-generated-watch; do
    cat >"$fake_bin/$watcher" <<'EOF'
#!/usr/bin/env bash
exec sleep 300
EOF
done
cat >"$fake_bin/start" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
if [ "${1:-}" = "--probe" ]; then
    printf 'PORT=%s APP_BASE_URL=%s SMTP_PORT=%s MAILHOG_BASE_URL=%s\n' \
        "$PORT" "$APP_BASE_URL" "$SMTP_PORT" "$MAILHOG_BASE_URL"
    exit 0
fi
mkdir -p "$DEVENV_AGENT_STATE_DIR"
env | sort >"$DEVENV_AGENT_STATE_DIR/runtime.env"
sleep 300 &
printf '%s\n' "$!" >"$DEVENV_AGENT_STATE_DIR/start-child.pid"
wait
EOF
cat >"$fake_bin/dev-worker" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
printf '%s\n' "$DATABASE_URL" >"$DEVENV_AGENT_STATE_DIR/worker-database"
sleep 300 &
printf '%s\n' "$!" >"$DEVENV_AGENT_STATE_DIR/worker-child.pid"
wait
EOF
cat >"$fake_bin/lsof" <<'EOF'
#!/usr/bin/env bash
exit 1
EOF
cat >"$fake_bin/systemctl" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
[ "${1:-}" = --user ] && shift
printf 'systemctl|%s\n' "$*" >>"$DEV_RESOURCE_TEST_LOG"
case "${1:-}" in
    is-system-running|start|set-property) exit 0 ;;
esac
exit 0
EOF
cat >"$fake_bin/systemd-run" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
printf 'systemd-run|%s\n' "$*" >>"$DEV_RESOURCE_TEST_LOG"
while [ "$#" -gt 0 ] && [ "$1" != -- ]; do shift; done
[ "${1:-}" = -- ] && shift
export BEPIS_DEV_RESOURCE_CONTAINED=1
exec "$@"
EOF
chmod +x "$fake_bin"/*

run_for() {
    local root="$1"
    shift
    local root_id
    root_id="$(printf '%s' "$root" | sha256sum | cut -c1-12)"
    (
        cd "$root"
        PATH="$fake_bin:$PATH" \
            DEVENV_AGENT_STATE_DIR="$fixture_root/state" \
            DEV_POSTGRES_ROOT="$fixture_root/postgres-$root_id" \
            BEPIS_WORKSPACE_REPO_ROOT="$root" \
            BEPIS_EPIC_WORKTREE_COMMAND="$registry_command" \
            BEPIS_SCRIPTS_ROOT="$root/Config/nix/scripts" \
            BEPIS_DEV_RESOURCE_CONTAINED=1 \
            "$@"
    )
}

resource_log="$fixture_root/dev-resource.log"
contained_probe="$( (
    cd "$fixture_repo"
    PATH="$fake_bin:$PATH" \
        DEVENV_AGENT_STATE_DIR="$fixture_root/state" \
        DEV_POSTGRES_ROOT="$fixture_root/postgres-contained" \
        BEPIS_WORKSPACE_REPO_ROOT="$fixture_repo" \
        BEPIS_EPIC_WORKTREE_COMMAND="$registry_command" \
        BEPIS_SCRIPTS_ROOT="$fixture_repo/Config/nix/scripts" \
        BEPIS_SYSTEMCTL_COMMAND="$fake_bin/systemctl" \
        BEPIS_SYSTEMD_RUN_COMMAND="$fake_bin/systemd-run" \
        DEV_RESOURCE_TEST_LOG="$resource_log" \
        "$dev_app_command" --probe
) )"
assert_contains "$contained_probe" "PORT=8000 APP_BASE_URL=http://127.0.0.1:8000"
assert_contains "$(cat "$resource_log")" "systemd-run|--user --scope --quiet --collect --slice=bepis-"
assert_contains "$(cat "$resource_log")" "-primary.slice"

app_probe="$(run_for "$epic_path" "$dev_app_command" --probe)"
assert_contains "$app_probe" "PORT=8003 APP_BASE_URL=http://127.0.0.1:8003 SMTP_PORT=1026"
run_for "$fixture_repo" "$dev_start_command" >/dev/null
run_for "$epic_path" "$dev_start_command" >/dev/null
main_id="$(printf '%s' "$fixture_repo" | sha256sum | cut -c1-12)"
epic_id="$(printf '%s' "$epic_path" | sha256sum | cut -c1-12)"
main_state="$fixture_root/state/workspace-$main_id"
epic_state="$fixture_root/state/workspace-$epic_id"
main_pid="$(cat "$main_state/devenv.pid")"
epic_pid="$(cat "$epic_state/devenv.pid")"
kill -0 "$main_pid" 2>/dev/null || fail "primary managed process did not start"
kill -0 "$epic_pid" 2>/dev/null || fail "epic managed process did not start"
[ "$main_pid" != "$epic_pid" ] || fail "worktrees share managed PID"
[ -f "$main_state/frontend-watch.pid" ] || fail "primary watcher PID missing"
[ -f "$epic_state/frontend-watch.pid" ] || fail "epic watcher PID missing"
assert_contains "$(cat "$main_state/runtime.env")" "PORT=8000"
assert_contains "$(cat "$epic_state/runtime.env")" "PORT=8003"
assert_contains "$(cat "$epic_state/runtime.env")" "IHP_HOOGLE_PORT=8005"
assert_contains "$(cat "$epic_state/runtime.env")" "APP_BASE_URL=http://127.0.0.1:8003"
assert_contains "$(cat "$epic_state/runtime.env")" "SMTP_PORT=1026"
assert_contains "$(cat "$epic_state/runtime.env")" "MAILHOG_BASE_URL=http://127.0.0.1:8026"
assert_contains "$(cat "$epic_state/runtime.env")" "PGHOST=$fixture_root/postgres-$epic_id/socket"
assert_contains "$(cat "$epic_state/runtime.env")" "DATABASE_URL=postgresql:///app?host=$fixture_root/postgres-$epic_id/socket"

# Exercise real status scripts with deterministic healthy probes.
rm "$fake_bin/dev-status"
cat >"$fake_bin/psql" <<'EOF'
#!/usr/bin/env bash
printf 'psql:%s\n' "$*" >>"$RUNTIME_PROBE_LOG"
exit 0
EOF
cat >"$fake_bin/curl" <<'EOF'
#!/usr/bin/env bash
printf 'curl:%s\n' "$*" >>"$RUNTIME_PROBE_LOG"
exit 0
EOF
chmod +x "$fake_bin/psql" "$fake_bin/curl"
probe_log="$fixture_root/probes.log"
main_status="$(RUNTIME_PROBE_LOG="$probe_log" run_for "$fixture_repo" "$dev_status_command")"
epic_status="$(RUNTIME_PROBE_LOG="$probe_log" run_for "$epic_path" "$dev_status_command")"
assert_contains "$main_status" "slot=0 app_url=http://127.0.0.1:8000"
assert_contains "$epic_status" "slot=1 app_url=http://127.0.0.1:8003"
assert_contains "$(cat "$probe_log")" "http://127.0.0.1:8026/api/v2/messages"
assert_contains "$(cat "$probe_log")" "-h $fixture_root/postgres-$epic_id/socket"

# Browser auth helper must derive the epic URL rather than defaulting to slot zero.
mkdir -p "$epic_path/.devenv/playwright-cli"
printf '{}\n' >"$epic_path/.devenv/playwright-cli/manager-state.json"
cat >"$fake_bin/pwcli" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' "$*" >>"$PWCLI_TEST_LOG"
EOF
chmod +x "$fake_bin/pwcli"
pwcli_log="$fixture_root/pwcli.log"
PWCLI_TEST_LOG="$pwcli_log" run_for "$epic_path" "$pwcli_auth_open_command" manager /RosterWeeks
assert_contains "$(cat "$pwcli_log")" "-s=ihp-epic-265-manager open http://127.0.0.1:8003"
assert_contains "$(cat "$pwcli_log")" "-s=ihp-epic-265-manager goto http://127.0.0.1:8003/RosterWeeks"

# Stopping primary must not touch any epic process or state, including opt-in observability.
printf '999999\n' >"$main_state/tempo.pid"
obs_stop_log="$fixture_root/observability-stop.log"
OBS_STOP_LOG="$obs_stop_log" run_for "$fixture_repo" "$dev_stop_command" >/dev/null
[ "$(cat "$obs_stop_log")" = "$main_state" ] || fail "dev-stop did not scope observability cleanup to primary state"
if kill -0 "$main_pid" 2>/dev/null; then
    fail "primary managed process survived its own stop"
fi
kill -0 "$epic_pid" 2>/dev/null || fail "stopping primary killed epic process"
[ -f "$epic_state/devenv.pid" ] || fail "stopping primary removed epic PID state"
run_for "$epic_path" "$dev_stop_command" >/dev/null
if kill -0 "$epic_pid" 2>/dev/null; then
    fail "epic managed process survived its own stop"
fi
main_pid=""
epic_pid=""

# Foreground Ctrl-C/TERM cleanup must terminate the complete app and watcher
# process groups rather than orphaning GHCi/esbuild descendants.
cat >"$fake_bin/curl" <<'EOF'
#!/usr/bin/env bash
case "$*" in
    *api/v2/messages*) exit 0 ;;
    *) [ "${RUNTIME_APP_HEALTHY:-0}" = 1 ] ;;
esac
EOF
chmod +x "$fake_bin/curl"
launch_foreground() {
rm -f "$epic_state/runtime.env" "$epic_state/start-child.pid" "$epic_state/worker-child.pid"
(
    cd "$epic_path"
    exec setsid env \
        PATH="$fake_bin:$PATH" \
        DEVENV_AGENT_STATE_DIR="$fixture_root/state" \
        DEV_POSTGRES_ROOT="$fixture_root/postgres-$epic_id" \
        BEPIS_WORKSPACE_REPO_ROOT="$epic_path" \
        BEPIS_EPIC_WORKTREE_COMMAND="$registry_command" \
        BEPIS_SCRIPTS_ROOT="$epic_path/Config/nix/scripts" \
        BEPIS_DEV_RESOURCE_CONTAINED=1 \
        "$dev_foreground_command"
) >"$fixture_root/foreground.log" 2>&1 &
foreground_pid=$!
for _ in $(seq 1 300); do
    [ -f "$epic_state/start-child.pid" ] && [ -f "$epic_state/worker-child.pid" ] && break
    sleep 0.05
done
[ -f "$epic_state/start-child.pid" ] || { cat "$fixture_root/foreground.log" >&2 || true; fail "foreground app child did not start"; }
foreground_child_pid="$(cat "$epic_state/start-child.pid")"
kill -0 "$foreground_child_pid" 2>/dev/null || fail "foreground app child was not alive"
[ -f "$epic_state/worker-child.pid" ] || fail "foreground worker did not start"
worker_child_pid="$(cat "$epic_state/worker-child.pid")"
kill -0 "$worker_child_pid" 2>/dev/null || fail "foreground worker child was not alive"
}
launch_foreground
assert_contains "$(cat "$epic_state/worker-database")" "$fixture_root/postgres-$epic_id/socket"
kill -TERM -- -"$foreground_pid"
wait "$foreground_pid" 2>/dev/null || true
foreground_pid=""
for _ in $(seq 1 40); do
    child_state="$(awk '{print $3}' "/proc/$foreground_child_pid/stat" 2>/dev/null || true)"
    if [ -z "$child_state" ] || [ "$child_state" = Z ]; then break; fi
    sleep 0.05
done
child_state="$(awk '{print $3}' "/proc/$foreground_child_pid/stat" 2>/dev/null || true)"
if [ -n "$child_state" ] && [ "$child_state" != Z ]; then
    fail "foreground app child survived Ctrl-C/TERM cleanup"
fi

worker_state="$(awk '{print $3}' "/proc/$worker_child_pid/stat" 2>/dev/null || true)"
if [ -n "$worker_state" ] && [ "$worker_state" != Z ]; then
    ps -o pid,ppid,pgid,sid,state,cmd -p "$worker_child_pid" >&2 || true
    [ ! -f "$epic_state/worker.owner.json" ] || cat "$epic_state/worker.owner.json" >&2
    cat "$fixture_root/foreground.log" >&2 || true
    fail "foreground worker child survived Ctrl-C/TERM cleanup"
fi

# Losing the worker must stop the app instead of leaving jobs silently queued.
launch_foreground
kill -TERM "$worker_child_pid"
for _ in $(seq 1 160); do
    kill -0 "$foreground_pid" 2>/dev/null || break
    sleep 0.05
done
if kill -0 "$foreground_pid" 2>/dev/null; then
    fail "foreground stack survived worker exit"
fi
if wait "$foreground_pid"; then
    fail "worker exit reported a successful stack shutdown"
fi
foreground_pid=""
child_state="$(awk '{print $3}' "/proc/$foreground_child_pid/stat" 2>/dev/null || true)"
if [ -n "$child_state" ] && [ "$child_state" != Z ]; then
    fail "app child survived worker failure"
fi

# A pre-existing app cannot be supervised as our child: reject mixed ownership.
rm -f "$epic_state/worker-child.pid"
if RUNTIME_APP_HEALTHY=1 run_for "$epic_path" "$dev_foreground_command" >"$fixture_root/already-running.log" 2>&1; then
    fail "foreground accepted an already-running app"
fi
assert_contains "$(cat "$fixture_root/already-running.log")" "stop it before starting the foreground stack"
[ ! -f "$epic_state/worker-child.pid" ] || fail "worker started beside an unowned app"

# The public dev-start adapter keeps its established exit 1 contract even
# though the shared runtime classifies immediate child failure as exit 75.
cat >"$fake_bin/start" <<'EOF'
#!/usr/bin/env bash
exit 1
EOF
chmod +x "$fake_bin/start"
set +e
run_for "$epic_path" "$dev_start_command" >"$fixture_root/start-failure.log" 2>&1
start_failure_status=$?
set -e
[ "$start_failure_status" = 1 ] || fail "dev-start leaked runtime failure exit $start_failure_status"
assert_contains "$(cat "$fixture_root/start-failure.log")" "devenv failed to start; log retained"
run_for "$epic_path" "$dev_stop_command" >/dev/null

# A child that passes runtime publication but exits during the delayed startup
# window also leaves no stale ownership artifacts.
cat >"$fake_bin/start" <<'EOF'
#!/usr/bin/env bash
sleep 0.3
exit 1
EOF
chmod +x "$fake_bin/start"
set +e
run_for "$epic_path" "$dev_start_command" >"$fixture_root/delayed-start-failure.log" 2>&1
delayed_start_status=$?
set -e
[ "$delayed_start_status" = 1 ] || fail "delayed dev-start failure returned $delayed_start_status"
[ ! -e "$epic_state/devenv.pid" ] && [ ! -e "$epic_state/devenv.owner.json" ] || fail "delayed startup failure retained ownership state"
run_for "$epic_path" "$dev_stop_command" >/dev/null

echo "dev-runtime-isolation-test: ok"
