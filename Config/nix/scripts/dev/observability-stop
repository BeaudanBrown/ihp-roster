#!/usr/bin/env bash
set -euo pipefail
# shellcheck source=../lib/workspace.sh
. "${BEPIS_SCRIPTS_ROOT:?}/lib/workspace.sh"
bepis_workspace_configure
# shellcheck source=../lib/runtime.sh
. "${BEPIS_SCRIPTS_ROOT:?}/lib/runtime.sh"

STATE_DIR="$(dev-agent-state-dir)"
PID_FILES=(
    "$STATE_DIR/grafana.pid:grafana"
    "$STATE_DIR/otel-collector.pid:otel-collector"
    "$STATE_DIR/tempo.pid:tempo"
)

stop_tracked_process() {
    local pid_file="$1"
    local label="$2"

    bepis_runtime_stop "$pid_file" "$label" 20000
}

for entry in "${PID_FILES[@]}"; do
    stop_tracked_process "${entry%%:*}" "${entry#*:}"
done
