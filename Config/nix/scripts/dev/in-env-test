#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
fixture_root="$(mktemp -d)"
trap 'rm -rf "$fixture_root"' EXIT

fail() {
    echo "in-env-test: $*" >&2
    exit 1
}

fake_bin="$fixture_root/bin"
mkdir -p "$fake_bin" "$fixture_root/wrong-worktree" "$fixture_root/caller"
cat >"$fake_bin/direnv" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
[ "$1" = exec ]
target="$2"
shift 2
[ "$PWD" = "$target" ] || {
    echo "fake-direnv: wrapper did not enter target root: $PWD != $target" >&2
    exit 1
}
exec "$@"
EOF
chmod +x "$fake_bin/direnv"

(
    cd "$fixture_root/caller"
    PATH="$fake_bin:$PATH" \
    EXPECTED_REPO_ROOT="$repo_root" \
    BEPIS_WORKSPACE_REPO_ROOT="$fixture_root/wrong-worktree" \
    BEPIS_WORKSPACE_KIND=primary \
    BEPIS_WORKSPACE_SLOT=0 \
    BEPIS_WORKSPACE_STATE_CONFIGURED=1 \
    DEVENV_AGENT_STATE_DIR="$fixture_root/wrong-state" \
    DEVENV_IN_DIRENV_SHELL=true \
    PGHOST="$fixture_root/wrong-db" \
    DATABASE_URL="postgresql:///wrong" \
    IHP_ROSTER_DEV_TEMPO_PORT=3209 \
    IHP_ROSTER_DEV_OTLP_HTTP_PORT=4327 \
    IHP_ROSTER_DEV_GRAFANA_PORT=3309 \
    OTEL_SERVICE_NAME=ihp-roster-dev-epic-wrong \
    OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:9999 \
    OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:9998 \
        bash "$repo_root/bin/in-env" bash -c '
            [ "$PWD" = "$EXPECTED_REPO_ROOT" ]
            [ -z "${BEPIS_WORKSPACE_REPO_ROOT+x}" ]
            [ -z "${BEPIS_WORKSPACE_KIND+x}" ]
            [ -z "${BEPIS_WORKSPACE_SLOT+x}" ]
            [ -z "${BEPIS_WORKSPACE_STATE_CONFIGURED+x}" ]
            [ -z "${DEVENV_AGENT_STATE_DIR+x}" ]
            [ -z "${DEVENV_IN_DIRENV_SHELL+x}" ]
            [ -z "${PGHOST+x}" ]
            [ -z "${DATABASE_URL+x}" ]
            [ -z "${IHP_ROSTER_DEV_TEMPO_PORT+x}" ]
            [ -z "${IHP_ROSTER_DEV_OTLP_HTTP_PORT+x}" ]
            [ -z "${IHP_ROSTER_DEV_GRAFANA_PORT+x}" ]
            [ -z "${OTEL_SERVICE_NAME+x}" ]
            [ -z "${OTEL_EXPORTER_OTLP_ENDPOINT+x}" ]
            [ -z "${OTEL_EXPORTER_OTLP_TRACES_ENDPOINT+x}" ]
        '
) || fail "stale sibling-worktree environment survived wrapper entry"

echo "in-env-test: ok"
