#!/usr/bin/env bash
set -euo pipefail
# shellcheck source=../lib/workspace.sh
. "${BEPIS_SCRIPTS_ROOT:?}/lib/workspace.sh"
# shellcheck source=../lib/workspace-resources.sh
. "${BEPIS_SCRIPTS_ROOT:?}/lib/workspace-resources.sh"
# shellcheck source=../lib/runtime.sh
. "${BEPIS_SCRIPTS_ROOT:?}/lib/runtime.sh"
bepis_workspace_configure
bepis_workspace_resource_reexec_dev "$(command -v dev-start)" "$@"
bash "${BEPIS_SCRIPTS_ROOT:?}/haskell/generated-ensure"
STATE_DIR="$(dev-agent-state-dir)"
PID_FILE="$STATE_DIR/devenv.pid"
FRONTEND_WATCH_PID_FILE="$STATE_DIR/frontend-watch.pid"
FRONTEND_GENERATED_WATCH_PID_FILE="$STATE_DIR/frontend-generated-watch.pid"
MAILHOG_PID_FILE="$STATE_DIR/mailhog.pid"
LOG_FILE="$STATE_DIR/devenv.log"
FRONTEND_WATCH_LOG_FILE="$STATE_DIR/frontend-watch.log"
FRONTEND_GENERATED_WATCH_LOG_FILE="$STATE_DIR/frontend-generated-watch.log"
APP_HEALTH_URL="$APP_BASE_URL"

mkdir -p "$STATE_DIR"
bepis_runtime_ensure_invocation_token
cleanup_failed_start() {
    local status=$?
    if [ "$status" -ne 0 ]; then
        bepis_runtime_stop_invocation "$PID_FILE" devenv 2000 >/dev/null 2>&1 || true
        bepis_runtime_stop_invocation "$FRONTEND_WATCH_PID_FILE" frontend-watch 2000 >/dev/null 2>&1 || true
        bepis_runtime_stop_invocation "$FRONTEND_GENERATED_WATCH_PID_FILE" frontend-generated-watch 2000 >/dev/null 2>&1 || true
        bepis_runtime_stop_invocation "$MAILHOG_PID_FILE" mailhog 2000 >/dev/null 2>&1 || true
    fi
    return "$status"
}
trap cleanup_failed_start EXIT

start_tracked_watch() {
    local pid_file="$1"
    local log_file="$2"
    local label="$3"
    shift 3

    bepis_runtime_start_result "$pid_file" "$log_file" "$label" "$@" >/dev/null
}

start_frontend_watchers() {
    start_tracked_watch "$FRONTEND_GENERATED_WATCH_PID_FILE" "$FRONTEND_GENERATED_WATCH_LOG_FILE" "frontend-generated-watch" frontend-generated-watch
    start_tracked_watch "$FRONTEND_WATCH_PID_FILE" "$FRONTEND_WATCH_LOG_FILE" "frontend-watch" frontend-watch
}

if dev-status >/dev/null 2>&1; then
    frontend-generated-ensure
    start_frontend_watchers
    echo "devenv already healthy (frontend-watch log=$FRONTEND_WATCH_LOG_FILE, frontend-generated-watch log=$FRONTEND_GENERATED_WATCH_LOG_FILE)"
    exit 0
fi

if runtime_status="$(bepis_runtime_observe "$PID_FILE" devenv 2>/dev/null)"; then
    PID="$(awk '{for (i=1; i<=NF; i++) if ($i ~ /^pid=/) {sub(/^pid=/, "", $i); print $i}}' <<<"$runtime_status")"
    frontend-generated-ensure
    start_frontend_watchers
    echo "devenv already running (pid=$PID); frontend watchers ensured"
    exit 0
fi

frontend-generated-ensure

# In restricted sandboxes ~/.cache can be read-only, which makes
# nix/direnv evaluation fail while writing fetcher cache.
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-/tmp/nix-cache}"
mkdir -p "$XDG_CACHE_HOME"
dev-ensure-postgres
dev-ensure-mailhog
start_frontend_watchers

if command -v lsof >/dev/null 2>&1 \
    && lsof -nP -iTCP:"$PORT" -sTCP:LISTEN >/dev/null 2>&1 \
    && ! curl --connect-timeout 1 --max-time 2 -fsS "$APP_HEALTH_URL" >/dev/null 2>&1; then
    echo "Port $PORT is occupied but not responding to $APP_HEALTH_URL." >&2
    echo "Stop the stale process before starting dev again:" >&2
    lsof -nP -iTCP:"$PORT" -sTCP:LISTEN >&2 || true
    exit 1
fi

export IHP_BROWSER="${IHP_BROWSER:-echo}"
if ! PID="$(bepis_runtime_start "$PID_FILE" "$LOG_FILE" devenv start)"; then
    echo "devenv failed to start; log retained at $LOG_FILE" >&2
    exit 1
fi

# Surface delayed startup failures while keeping a bounded deadline.
for _ in $(seq 1 3); do
    sleep 1
    bepis_runtime_observe "$PID_FILE" devenv >/dev/null 2>&1 || {
        bepis_runtime_stop "$PID_FILE" devenv 0 >/dev/null 2>&1 || true
        echo "devenv failed to start; log retained at $LOG_FILE"
        exit 1
    }
done

trap - EXIT
echo "devenv started (slot=$BEPIS_WORKSPACE_SLOT, pid=$PID, app=$APP_BASE_URL, mailhog=$MAILHOG_BASE_URL, log=$LOG_FILE)"
