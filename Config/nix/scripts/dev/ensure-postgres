#!/usr/bin/env bash
set -euo pipefail
# shellcheck source=../lib/workspace.sh
. "@scriptsRoot@/lib/workspace.sh"
bepis_workspace_configure

socket="$(dev-postgres ensure)"
if [ "$socket" != "$PGHOST" ]; then
    echo "dev-ensure-postgres: runtime socket mismatch: workspace=$PGHOST manager=$socket" >&2
    exit 73
fi
printf 'dev PostgreSQL: mode=%s socket=%s root=%s durability=durable\n' \
    "$DEV_POSTGRES_MODE" "$socket" "$DEV_POSTGRES_ROOT"
