#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
pi_command="$repo_root/Config/nix/scripts/dev/pi"
registry_command="$repo_root/Config/nix/scripts/epic/worktree"
fixture_root="$(mktemp -d)"
cleanup() { rm -rf "$fixture_root"; }
trap cleanup EXIT

fail() { echo "workspace-pi-test: $*" >&2; exit 1; }

primary="$fixture_root/repo"
epic_path="$fixture_root/repo-epic-900"
git init --quiet --initial-branch=roster "$primary"
git -C "$primary" config user.name "Workspace Pi Test"
git -C "$primary" config user.email "workspace-pi@example.invalid"
printf 'fixture\n' >"$primary/README"
printf '.bepis-epic-worktree.json\n' >"$primary/.gitignore"
git -C "$primary" add README .gitignore
git -C "$primary" commit --quiet -m fixture
git -C "$primary" worktree add --quiet -b epic-900 "$epic_path"
(
    cd "$epic_path"
    BEPIS_SCRIPTS_ROOT="$repo_root/Config/nix/scripts" bash "$registry_command" register --epic 900 --target roster >/dev/null
)

fake_bin="$fixture_root/bin"
mkdir -p "$fake_bin"
cat >"$fake_bin/systemctl" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
[ "${1:-}" = --user ] && shift
printf 'systemctl' >>"$WORKSPACE_PI_SYSTEMD_LOG"
printf '|%s' "$@" >>"$WORKSPACE_PI_SYSTEMD_LOG"
printf '\n' >>"$WORKSPACE_PI_SYSTEMD_LOG"
case "${1:-}" in
    is-system-running) exit 0 ;;
    show)
        printf '%s\n' 'LoadState=loaded' 'ActiveState=active' 'CPUWeight=100' 'TasksCurrent=2'
        ;;
esac
EOF
cat >"$fake_bin/systemd-run" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
printf 'systemd-run' >>"$WORKSPACE_PI_SYSTEMD_LOG"
printf '|%s' "$@" >>"$WORKSPACE_PI_SYSTEMD_LOG"
printf '\n' >>"$WORKSPACE_PI_SYSTEMD_LOG"
while [ "$#" -gt 0 ] && [ "$1" != -- ]; do shift; done
[ "${1:-}" = -- ] && shift
export WORKSPACE_PI_CONTAINED=1
exec "$@"
EOF
cat >"$fake_bin/real-pi" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
printf 'pi-contained=%s arg=%s\n' "${WORKSPACE_PI_CONTAINED:-0}" "${1:-}"
bash -c 'printf "child-contained=%s\n" "${WORKSPACE_PI_CONTAINED:-0}"'
EOF
chmod +x "$fake_bin"/*

run_pi() {
    local path="$1"
    shift
    (
        cd "$path"
        PATH="$fake_bin:$PATH" \
        BEPIS_SCRIPTS_ROOT="$repo_root/Config/nix/scripts" \
        BEPIS_EPIC_WORKTREE_COMMAND="$registry_command" \
        BEPIS_REAL_PI_COMMAND="$fake_bin/real-pi" \
        BEPIS_SYSTEMCTL_COMMAND="$fake_bin/systemctl" \
        BEPIS_SYSTEMD_RUN_COMMAND="$fake_bin/systemd-run" \
        WORKSPACE_PI_SYSTEMD_LOG="$fixture_root/systemd.log" \
            bash "$pi_command" "$@"
    )
}

primary_output="$(run_pi "$primary" primary)"
[[ "$primary_output" == *'pi-contained=1 arg=primary'* ]] || fail "primary Pi was not contained"
[[ "$primary_output" == *'child-contained=1'* ]] || fail "Pi child did not inherit containment"
primary_slice="$(grep 'systemd-run' "$fixture_root/systemd.log" | tail -1 | grep -Eo -- '--slice=[^|]+' | cut -d= -f2)"
[[ "$primary_slice" == *'-primary.slice' ]] || fail "primary slice identity is wrong: $primary_slice"

epic_output="$(run_pi "$epic_path" epic)"
[[ "$epic_output" == *'pi-contained=1 arg=epic'* ]] || fail "epic Pi was not contained"
epic_slice="$(grep 'systemd-run' "$fixture_root/systemd.log" | tail -1 | grep -Eo -- '--slice=[^|]+' | cut -d= -f2)"
[[ "$epic_slice" == *'-epic1.slice' ]] || fail "epic slot slice identity is wrong: $epic_slice"
[ "$primary_slice" != "$epic_slice" ] || fail "primary and epic shared one slice"
[ "${primary_slice%-primary.slice}" = "${epic_slice%-epic1.slice}" ] || fail "repository workspaces are not sibling slices"
[ "$(grep -c 'set-property|--runtime|.*|CPUWeight=100' "$fixture_root/systemd.log")" -ge 2 ] \
    || fail "equal CPU weight was not configured"

bypass_output="$(cd "$epic_path" && PATH="$fake_bin:$PATH" BEPIS_SCRIPTS_ROOT="$repo_root/Config/nix/scripts" \
    BEPIS_EPIC_WORKTREE_COMMAND="$registry_command" BEPIS_REAL_PI_COMMAND="$fake_bin/real-pi" \
    BEPIS_WORKSPACE_CPU_SHARING=off bash "$pi_command" bypass 2>&1)"
[[ "$bypass_output" == *'explicitly disabled'* && "$bypass_output" == *'pi-contained=0 arg=bypass'* ]] \
    || fail "explicit bypass was not visible and uncontained"

unknown="$fixture_root/unknown"
git -C "$primary" worktree add --quiet -b unknown "$unknown"
unknown_output="$(cd "$unknown" && PATH="$fake_bin:$PATH" BEPIS_SCRIPTS_ROOT="$repo_root/Config/nix/scripts" \
    BEPIS_EPIC_WORKTREE_COMMAND="$registry_command" BEPIS_REAL_PI_COMMAND="$fake_bin/real-pi" \
    bash "$pi_command" unknown 2>&1)"
[[ "$unknown_output" == *'no valid Bepis workspace identity'* && "$unknown_output" == *'pi-contained=0 arg=unknown'* ]] \
    || fail "unknown linked worktree did not visibly fall back"

echo "workspace-pi-test: ok"
