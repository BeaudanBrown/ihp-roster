#!/usr/bin/env bash
set -euo pipefail
# shellcheck source=../lib/workspace.sh
. "${BEPIS_SCRIPTS_ROOT:?}/lib/workspace.sh"
bepis_workspace_configure
# shellcheck source=../lib/runtime.sh
. "${BEPIS_SCRIPTS_ROOT:?}/lib/runtime.sh"
TIMEOUT="${1:-90}"
[[ "$TIMEOUT" =~ ^[1-9][0-9]*$ ]] || { echo "dev-wait timeout must be a positive integer" >&2; exit 64; }
LOG_FILE="$(dev-agent-state-dir)/devenv.log"
if ! bepis_runtime_wait "$((TIMEOUT * 1000))" "devenv health" "$LOG_FILE" dev-status; then
    echo "Timed out waiting for devenv health after ${TIMEOUT}s"
    dev-status || true
    echo "Recent log retained at $LOG_FILE"
    exit 1
fi
dev-status
