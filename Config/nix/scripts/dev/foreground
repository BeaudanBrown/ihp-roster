#!/usr/bin/env bash
set -euo pipefail

STATE_DIR="$(dev-agent-state-dir)"
LOG_FILE="$STATE_DIR/devenv.log"
DB_SOCKET="${PGHOST:-$PWD/build/db}"
APP_HEALTH_URL="${APP_BASE_URL:-http://127.0.0.1:8000}"
APP_PID=""
FRONTEND_WATCH_PID=""
FRONTEND_GENERATED_WATCH_PID=""
APP_WAS_ALREADY_RUNNING=0
MAILHOG_STARTED=0
OBSERVABILITY_STARTED=0
MAILHOG_BIN="$(command -v MailHog || command -v mailhog)"
OTLP_HTTP_PORT="${IHP_ROSTER_DEV_OTLP_HTTP_PORT:-4318}"

mkdir -p "$STATE_DIR"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-/tmp/nix-cache}"
mkdir -p "$XDG_CACHE_HOME"

frontend-generated-ensure

if curl --connect-timeout 1 --max-time 2 -fsS "${MAILHOG_BASE_URL:-http://127.0.0.1:8025}/api/v2/messages" >/dev/null 2>&1; then
    MAILHOG_STARTED=0
else
    "$MAILHOG_BIN" \
        -smtp-bind-addr 127.0.0.1:1025 \
        -ui-bind-addr 127.0.0.1:8025 \
        -api-bind-addr 127.0.0.1:8025 &
    MAILHOG_PID=$!
    MAILHOG_STARTED=1
fi

cleanup() {
    if [ -n "$APP_PID" ]; then
        kill "$APP_PID" 2>/dev/null || true
    fi
    if [ -n "$FRONTEND_WATCH_PID" ]; then
        kill "$FRONTEND_WATCH_PID" 2>/dev/null || true
    fi
    if [ -n "$FRONTEND_GENERATED_WATCH_PID" ]; then
        kill "$FRONTEND_GENERATED_WATCH_PID" 2>/dev/null || true
    fi
    if [ "${MAILHOG_STARTED:-0}" = "1" ] && [ -n "${MAILHOG_PID:-}" ]; then
        kill "$MAILHOG_PID" 2>/dev/null || true
    fi
    if [ "${OBSERVABILITY_STARTED:-0}" = "1" ]; then
        dev-observability-stop >/dev/null 2>&1 || true
    fi
}
trap cleanup EXIT INT TERM

if dev-observability-status >/dev/null 2>&1; then
    OBSERVABILITY_STARTED=0
else
    dev-observability-start
    OBSERVABILITY_STARTED=1
fi

export IHP_ROSTER_OTEL="${IHP_ROSTER_OTEL:-1}"
export IHP_ROSTER_OTEL_DIAGNOSTIC_HEADERS="${IHP_ROSTER_OTEL_DIAGNOSTIC_HEADERS:-1}"
export OTEL_SERVICE_NAME="${OTEL_SERVICE_NAME:-ihp-roster-dev}"
export OTEL_EXPORTER_OTLP_ENDPOINT="${OTEL_EXPORTER_OTLP_ENDPOINT:-http://127.0.0.1:${OTLP_HTTP_PORT}}"
export OTEL_TRACES_SAMPLER="${OTEL_TRACES_SAMPLER:-always_on}"
export OTEL_BSP_SCHEDULE_DELAY="${OTEL_BSP_SCHEDULE_DELAY:-1000}"
export OTEL_BSP_EXPORT_TIMEOUT="${OTEL_BSP_EXPORT_TIMEOUT:-5000}"

frontend-generated-watch &
FRONTEND_GENERATED_WATCH_PID=$!
frontend-watch &
FRONTEND_WATCH_PID=$!

if ! psql -h "$DB_SOCKET" -d postgres -c "select 1" >/dev/null 2>&1; then
    dev-ensure-postgres
fi

if curl --connect-timeout 1 --max-time 2 -fsS "$APP_HEALTH_URL" >/dev/null 2>&1; then
    APP_WAS_ALREADY_RUNNING=1
    echo "App server already running; frontend-watch and frontend-generated-watch active; MailHog available at http://127.0.0.1:8025"
    echo "Dev observability available at http://127.0.0.1:${IHP_ROSTER_DEV_GRAFANA_PORT:-3300}/explore"
    echo "Existing app process was left unchanged; restart it if it was not started with IHP_ROSTER_OTEL=1."
else
    if command -v lsof >/dev/null 2>&1 && lsof -nP -iTCP:8000 -sTCP:LISTEN >/dev/null 2>&1; then
        echo "Port 8000 is occupied but not responding to $APP_HEALTH_URL." >&2
        echo "Stop the stale process before starting dev again:" >&2
        lsof -nP -iTCP:8000 -sTCP:LISTEN >&2 || true
        exit 1
    fi
    echo "[dev-foreground] launching start with observability (XDG_CACHE_HOME=$XDG_CACHE_HOME)" >>"$LOG_FILE"
    echo "Starting app server, frontend-watch, frontend-generated-watch, postgres, MailHog, and observability..."
    echo "Tracing env: OTEL_SERVICE_NAME=$OTEL_SERVICE_NAME OTEL_EXPORTER_OTLP_ENDPOINT=$OTEL_EXPORTER_OTLP_ENDPOINT OTEL_TRACES_SAMPLER=$OTEL_TRACES_SAMPLER"
    echo "Grafana Explore: http://127.0.0.1:${IHP_ROSTER_DEV_GRAFANA_PORT:-3300}/explore"
    start &
    APP_PID=$!
    wait "$APP_PID"
fi

if [ "$APP_WAS_ALREADY_RUNNING" = "1" ] && [ "${MAILHOG_STARTED:-0}" = "1" ] && [ -n "${MAILHOG_PID:-}" ]; then
    wait "$MAILHOG_PID"
fi
