#!/usr/bin/env bash
set -euo pipefail
# shellcheck source=../lib/workspace.sh
. "${BEPIS_SCRIPTS_ROOT:?}/lib/workspace.sh"
# shellcheck source=../lib/workspace-resources.sh
. "${BEPIS_SCRIPTS_ROOT:?}/lib/workspace-resources.sh"
# shellcheck source=../lib/runtime.sh
. "${BEPIS_SCRIPTS_ROOT:?}/lib/runtime.sh"
bepis_workspace_configure
bepis_workspace_resource_reexec_dev "$(command -v dev-foreground)" "$@"
bash "${BEPIS_SCRIPTS_ROOT:?}/haskell/generated-ensure"

# Foreground development does not assume access to a desktop session. Callers
# can still opt in to automatic launch with an explicit browser command.
export IHP_BROWSER="${IHP_BROWSER:-true}"

STATE_DIR="$(dev-agent-state-dir)"
PID_FILE="$STATE_DIR/devenv.pid"
FRONTEND_WATCH_PID_FILE="$STATE_DIR/frontend-watch.pid"
FRONTEND_GENERATED_WATCH_PID_FILE="$STATE_DIR/frontend-generated-watch.pid"
APP_PID_FILE="$STATE_DIR/foreground-app.pid"
WORKER_PID_FILE="$STATE_DIR/worker.pid"
MAILHOG_PID_FILE="$STATE_DIR/mailhog.pid"
TEMPO_PID_FILE="$STATE_DIR/tempo.pid"
COLLECTOR_PID_FILE="$STATE_DIR/otel-collector.pid"
GRAFANA_PID_FILE="$STATE_DIR/grafana.pid"
LOG_FILE="$STATE_DIR/devenv.log"
DB_SOCKET="$PGHOST"
APP_HEALTH_URL="$APP_BASE_URL"
if [ -n "${BEPIS_PUBLIC_APP_BASE_URL:-}" ]; then
    if [ "$BEPIS_PUBLIC_APP_BASE_URL" != "https://dev.bepis.lol" ]; then
        echo "BEPIS_PUBLIC_APP_BASE_URL supports only https://dev.bepis.lol." >&2
        exit 64
    fi
    export APP_BASE_URL="$BEPIS_PUBLIC_APP_BASE_URL"
fi
APP_PID=""
WORKER_PID=""
FRONTEND_WATCH_PID=""
FRONTEND_GENERATED_WATCH_PID=""
MAILHOG_STARTED=0
POSTGRES_STARTED=0
MAILHOG_BIN="$(command -v MailHog || command -v mailhog)"
OTLP_HTTP_PORT="${IHP_ROSTER_DEV_OTLP_HTTP_PORT:-4318}"
OBSERVABILITY_ENABLED="${IHP_ROSTER_DEV_OBSERVABILITY:-0}"

mkdir -p "$STATE_DIR"
bepis_runtime_ensure_invocation_token
if existing_status="$(bepis_runtime_observe "$PID_FILE" devenv 2>/dev/null)"; then
    existing_pid="$(awk '{for (i=1; i<=NF; i++) if ($i ~ /^pid=/) {sub(/^pid=/, "", $i); print $i}}' <<<"$existing_status")"
    if [ "$existing_pid" != "$BASHPID" ]; then
        echo "Foreground development already owns this workspace (pid=$existing_pid)." >&2
        exit 75
    fi
fi
bepis_runtime_adopt "$PID_FILE" devenv "$BASHPID"
cleanup() {
    bepis_runtime_stop_invocation "$WORKER_PID_FILE" worker 2000 >/dev/null 2>&1 || true
    bepis_runtime_stop_invocation "$APP_PID_FILE" app 2000 >/dev/null 2>&1 || true
    bepis_runtime_stop_invocation "$FRONTEND_WATCH_PID_FILE" frontend-watch 2000 >/dev/null 2>&1 || true
    bepis_runtime_stop_invocation "$FRONTEND_GENERATED_WATCH_PID_FILE" frontend-generated-watch 2000 >/dev/null 2>&1 || true
    bepis_runtime_release "$PID_FILE" devenv "$BASHPID" >/dev/null || true
    bepis_runtime_stop_invocation "$MAILHOG_PID_FILE" mailhog 2000 >/dev/null 2>&1 || true
    bepis_runtime_stop_invocation "$GRAFANA_PID_FILE" grafana 2000 >/dev/null 2>&1 || true
    bepis_runtime_stop_invocation "$COLLECTOR_PID_FILE" otel-collector 2000 >/dev/null 2>&1 || true
    bepis_runtime_stop_invocation "$TEMPO_PID_FILE" tempo 2000 >/dev/null 2>&1 || true
    if [ "${POSTGRES_STARTED:-0}" = "1" ]; then
        dev-postgres stop >/dev/null 2>&1 || true
    fi
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

export XDG_CACHE_HOME="${XDG_CACHE_HOME:-/tmp/nix-cache}"
mkdir -p "$XDG_CACHE_HOME"
frontend-generated-ensure

if curl --connect-timeout 1 --max-time 2 -fsS "$MAILHOG_BASE_URL/api/v2/messages" >/dev/null 2>&1; then
    MAILHOG_STARTED=0
else
    mailhog_result="$(bepis_runtime_start_result "$MAILHOG_PID_FILE" "$LOG_FILE" mailhog "$MAILHOG_BIN" \
        -smtp-bind-addr "127.0.0.1:$MAILHOG_SMTP_PORT" \
        -ui-bind-addr "127.0.0.1:$MAILHOG_PORT" \
        -api-bind-addr "127.0.0.1:$MAILHOG_PORT")"
    MAILHOG_PID="$(bepis_runtime_result_value "$mailhog_result" pid)"
    if [ "$(bepis_runtime_result_value "$mailhog_result" created)" = true ]; then MAILHOG_STARTED=1; fi
fi

if [ "$OBSERVABILITY_ENABLED" = "1" ]; then
    if dev-observability-status >/dev/null 2>&1; then
        :
    else
        observability_output="$(dev-observability-start)"
        printf '%s\n' "$observability_output"
    fi
    export IHP_ROSTER_OTEL="${IHP_ROSTER_OTEL:-1}"
    export IHP_ROSTER_OTEL_DIAGNOSTIC_HEADERS="${IHP_ROSTER_OTEL_DIAGNOSTIC_HEADERS:-1}"
else
    export IHP_ROSTER_OTEL="${IHP_ROSTER_OTEL:-0}"
    export IHP_ROSTER_OTEL_DIAGNOSTIC_HEADERS="${IHP_ROSTER_OTEL_DIAGNOSTIC_HEADERS:-0}"
fi
export OTEL_SERVICE_NAME="${OTEL_SERVICE_NAME:-$BEPIS_WORKSPACE_OTEL_SERVICE_NAME}"
export OTEL_EXPORTER_OTLP_ENDPOINT="${OTEL_EXPORTER_OTLP_ENDPOINT:-http://127.0.0.1:${OTLP_HTTP_PORT}}"
export OTEL_TRACES_SAMPLER="${OTEL_TRACES_SAMPLER:-always_on}"
telemetry_revision="$(git rev-parse HEAD 2>/dev/null || printf unknown)"
telemetry_version="${telemetry_revision:0:12}"
export OTEL_RESOURCE_ATTRIBUTES="${OTEL_RESOURCE_ATTRIBUTES:-deployment.environment.name=development,service.version=$telemetry_version,service.instance.id=${HOSTNAME:-localhost},host.name=${HOSTNAME:-localhost},bepis.workspace.kind=$BEPIS_WORKSPACE_KIND,bepis.deployment.slot=$BEPIS_WORKSPACE_SLOT,vcs.ref.head.revision=$telemetry_revision}"
export IHP_ROSTER_OTEL_SHUTDOWN_TIMEOUT_MS="${IHP_ROSTER_OTEL_SHUTDOWN_TIMEOUT_MS:-2000}"
export OTEL_BSP_MAX_QUEUE_SIZE="${OTEL_BSP_MAX_QUEUE_SIZE:-512}"
export OTEL_BSP_MAX_EXPORT_BATCH_SIZE="${OTEL_BSP_MAX_EXPORT_BATCH_SIZE:-128}"
export OTEL_BSP_SCHEDULE_DELAY="${OTEL_BSP_SCHEDULE_DELAY:-1000}"
export OTEL_BSP_EXPORT_TIMEOUT="${OTEL_BSP_EXPORT_TIMEOUT:-1000}"
export OTEL_ATTRIBUTE_VALUE_LENGTH_LIMIT="${OTEL_ATTRIBUTE_VALUE_LENGTH_LIMIT:-256}"
export OTEL_ATTRIBUTE_COUNT_LIMIT="${OTEL_ATTRIBUTE_COUNT_LIMIT:-64}"
export OTEL_SPAN_ATTRIBUTE_VALUE_LENGTH_LIMIT="${OTEL_SPAN_ATTRIBUTE_VALUE_LENGTH_LIMIT:-256}"
export OTEL_SPAN_ATTRIBUTE_COUNT_LIMIT="${OTEL_SPAN_ATTRIBUTE_COUNT_LIMIT:-64}"
export OTEL_SPAN_EVENT_COUNT_LIMIT="${OTEL_SPAN_EVENT_COUNT_LIMIT:-64}"
export OTEL_SPAN_LINK_COUNT_LIMIT="${OTEL_SPAN_LINK_COUNT_LIMIT:-16}"

frontend_generated_result="$(bepis_runtime_start_result "$FRONTEND_GENERATED_WATCH_PID_FILE" "$STATE_DIR/frontend-generated-watch.log" frontend-generated-watch frontend-generated-watch)"
FRONTEND_GENERATED_WATCH_PID="$(bepis_runtime_result_value "$frontend_generated_result" pid)"
frontend_watch_result="$(bepis_runtime_start_result "$FRONTEND_WATCH_PID_FILE" "$STATE_DIR/frontend-watch.log" frontend-watch frontend-watch)"
FRONTEND_WATCH_PID="$(bepis_runtime_result_value "$frontend_watch_result" pid)"
sleep 0.1
for watcher_pid in "$FRONTEND_GENERATED_WATCH_PID" "$FRONTEND_WATCH_PID"; do
    if ! kill -0 "$watcher_pid" 2>/dev/null; then
        echo "A frontend watcher failed to start; another development process may own this workspace." >&2
        exit 75
    fi
done

if ! psql -h "$DB_SOCKET" -d postgres -c "select 1" >/dev/null 2>&1; then
    dev-ensure-postgres
    POSTGRES_STARTED=1
fi

if curl --connect-timeout 1 --max-time 2 -fsS "$APP_HEALTH_URL" >/dev/null 2>&1; then
    echo "App server already running at $APP_HEALTH_URL; stop it before starting the foreground stack." >&2
    exit 75
else
    if command -v lsof >/dev/null 2>&1 && lsof -nP -iTCP:"$PORT" -sTCP:LISTEN >/dev/null 2>&1; then
        echo "Port $PORT is occupied but not responding to $APP_HEALTH_URL." >&2
        echo "Stop the stale process before starting dev again:" >&2
        lsof -nP -iTCP:"$PORT" -sTCP:LISTEN >&2 || true
        exit 1
    fi
    echo "Starting slot $BEPIS_WORKSPACE_SLOT app at $APP_BASE_URL with frontend watchers, PostgreSQL, and MailHog at $MAILHOG_BASE_URL..."
    if [ "$OBSERVABILITY_ENABLED" = "1" ]; then
        echo "Tracing env: OTEL_SERVICE_NAME=$OTEL_SERVICE_NAME OTEL_EXPORTER_OTLP_ENDPOINT=$OTEL_EXPORTER_OTLP_ENDPOINT OTEL_TRACES_SAMPLER=$OTEL_TRACES_SAMPLER"
        echo "Grafana Explore: http://127.0.0.1:${IHP_ROSTER_DEV_GRAFANA_PORT:-3300}/explore"
    fi
    app_result="$(bepis_runtime_start_result "$APP_PID_FILE" "$LOG_FILE" app start)"
    APP_PID="$(bepis_runtime_result_value "$app_result" pid)"
fi

# Run the same registered AppJob consumers as production, using this workspace's
# database and service configuration. Both just dev and just ddev enter here.
echo "Starting background job worker for slot $BEPIS_WORKSPACE_SLOT..."
worker_result="$(bepis_runtime_start_result "$WORKER_PID_FILE" "$STATE_DIR/worker.log" worker dev-worker)"
WORKER_PID="$(bepis_runtime_result_value "$worker_result" pid)"

# Do not leave a healthy-looking web server running without its job consumer.
# Detached children publish ownership evidence; this foreground owner observes
# them until a signal or child failure triggers scoped cleanup.
while true; do
    sleep 0.2
    bepis_runtime_observe "$WORKER_PID_FILE" worker >/dev/null 2>&1 || break
    bepis_runtime_observe "$FRONTEND_WATCH_PID_FILE" frontend-watch >/dev/null 2>&1 || break
    bepis_runtime_observe "$FRONTEND_GENERATED_WATCH_PID_FILE" frontend-generated-watch >/dev/null 2>&1 || break
    [ -z "$APP_PID" ] || bepis_runtime_observe "$APP_PID_FILE" app >/dev/null 2>&1 || break
    [ "$MAILHOG_STARTED" != "1" ] || bepis_runtime_observe "$MAILHOG_PID_FILE" mailhog >/dev/null 2>&1 || break
done
echo "A development stack process exited; stopping owned services." >&2
exit 1
