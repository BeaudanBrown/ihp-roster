#!/usr/bin/env bash
set -euo pipefail

if [ "${1:-}" = "--probe" ]; then
    echo "materialized-script-snapshot"
    exit 0
fi

command_name="devenv-script-freshness-check"
command -v "$command_name" >/dev/null 2>&1 || {
    echo "$command_name: missing named project command" >&2
    exit 1
}

fixture_root="$(mktemp -d)"
trap 'rm -rf "$fixture_root"' EXIT
fixture_repo="$fixture_root/repo&with|shell\\chars"
fixture_relative="Config/nix/scripts/dev/script-freshness-check"
mkdir -p "$fixture_repo/$(dirname "$fixture_relative")"
cat >"$fixture_repo/$fixture_relative" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
if [ "${1:-}" = --stdin-probe ]; then
    IFS= read -r value
    printf 'stdin:%s\n' "$value"
    exit 0
fi
[ "${1:-}" != --exit-probe ] || exit 73
printf '%s\n' \
    'working-tree-script' \
    "$BEPIS_SCRIPTS_ROOT" \
    "$BEPIS_MAILHOG_ROOT" \
    "$BEPIS_RIPGREP_ROOT" \
    "${2:-}"
EOF

argument="argument with spaces"
mapfile -t actual < <(FRONTEND_REPO_ROOT="$fixture_repo" "$command_name" --probe "$argument")
if [ "${#actual[@]}" -ne 5 ] \
    || [ "${actual[0]:-}" != "working-tree-script" ] \
    || [ "${actual[1]:-}" != "$fixture_repo/Config/nix/scripts" ] \
    || [ "${actual[4]:-}" != "$argument" ] \
    || [ ! -x "${actual[2]:-}/bin/MailHog" ] \
    || [ ! -x "${actual[3]:-}/bin/rg" ]; then
    echo "$command_name: working-tree source or dependency roots were not selected directly" >&2
    printf 'actual: %s\n' "${actual[*]-}" >&2
    exit 1
fi

missing_repo="$fixture_root/missing-repo"
mkdir -p "$missing_repo"
set +e
missing_output="$(FRONTEND_REPO_ROOT="$missing_repo" "$command_name" --probe 2>&1)"
missing_status=$?
newline_output="$(FRONTEND_REPO_ROOT="$fixture_root/newline"$'\n'"repo" "$command_name" --probe 2>&1)"
newline_status=$?
set -e
if [ "$missing_status" -ne 66 ] || [[ "$missing_output" != *"missing working-tree script"* ]]; then
    echo "$command_name: missing explicit source did not fail closed" >&2
    exit 1
fi
if [ "$newline_status" -ne 64 ] || [[ "$newline_output" != *"paths containing newlines are unsupported"* ]]; then
    echo "$command_name: newline checkout path did not fail clearly" >&2
    exit 1
fi

assert_packaged_fallback() {
    local directory="$1"
    local output status
    set +e
    output="$(cd "$directory" && env -u FRONTEND_REPO_ROOT "$command_name" --probe 2>&1)"
    status=$?
    set -e
    if [ "$status" -ne 0 ] \
        || [[ "$output" != *"using packaged snapshot"* ]] \
        || [[ "$output" != *"materialized-script-snapshot"* ]]; then
        echo "$command_name: packaged fallback failed in $directory" >&2
        echo "$output" >&2
        exit 1
    fi
}
assert_packaged_fallback "$fixture_root"
unrelated_repo="$fixture_root/unrelated-repo"
mkdir -p "$unrelated_repo"
git -C "$unrelated_repo" init --quiet
assert_packaged_fallback "$unrelated_repo"

stdin_actual="$(printf 'preserved-input\n' | FRONTEND_REPO_ROOT="$fixture_repo" "$command_name" --stdin-probe)"
set +e
FRONTEND_REPO_ROOT="$fixture_repo" "$command_name" --exit-probe
exit_status=$?
set -e
if [ "$stdin_actual" != "stdin:preserved-input" ] || [ "$exit_status" -ne 73 ]; then
    echo "$command_name: caller stdin or selected script exit status was not preserved" >&2
    exit 1
fi

repo_root="$(git rev-parse --show-toplevel)"
fake_bin="$fixture_root/fake-bin"
mkdir -p "$fake_bin"
printf '#!/usr/bin/env bash\nprintf "direnv-exec"; printf "|%%s" "$@"; printf "\\n"\n' >"$fake_bin/direnv"
printf '#!/usr/bin/env bash\necho direct-project-command\n' >"$fake_bin/probe-command"
printf '#!/usr/bin/env bash\necho ihp-1.0.0\n' >"$fake_bin/ghc-pkg"
chmod +x "$fake_bin"/*
in_env_actual="$(
    PATH="$fake_bin:$PATH" DEVENV_IN_DIRENV_SHELL=true \
        bash "$repo_root/bin/in-env" probe-command
)"
if [ "$in_env_actual" != "direnv-exec|exec|$repo_root|probe-command" ]; then
    echo "$command_name: bin/in-env bypassed direnv freshness validation" >&2
    exit 1
fi

echo "$command_name: ok"
