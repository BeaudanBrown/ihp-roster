#!/usr/bin/env bash
set -euo pipefail
# shellcheck source=../lib/workspace.sh
. "${BEPIS_SCRIPTS_ROOT:?}/lib/workspace.sh"
bepis_workspace_configure
# shellcheck source=../lib/runtime.sh
. "${BEPIS_SCRIPTS_ROOT:?}/lib/runtime.sh"
stop_postgres() {
    dev-postgres stop >/dev/null || true
}
trap stop_postgres EXIT
STATE_DIR="$(dev-agent-state-dir)"
PID_FILE="$STATE_DIR/devenv.pid"
FRONTEND_WATCH_PID_FILE="$STATE_DIR/frontend-watch.pid"
FRONTEND_GENERATED_WATCH_PID_FILE="$STATE_DIR/frontend-generated-watch.pid"
LEGACY_FRONTEND_CONTRACTS_WATCH_PID_FILE="$STATE_DIR/frontend-contracts-watch.pid"
MAILHOG_PID_FILE="$STATE_DIR/mailhog.pid"
STRIPE_PID_FILE="$STATE_DIR/stripe-listen.pid"

stop_tracked_process() {
    local pid_file="$1" label="${2:-service}"
    bepis_runtime_stop "$pid_file" "$label" 20000 >/dev/null
}

if [ -f "$STATE_DIR/tempo.pid" ] \
    || [ -f "$STATE_DIR/otel-collector.pid" ] \
    || [ -f "$STATE_DIR/grafana.pid" ]; then
    dev-observability-stop
fi

if [ ! -f "$PID_FILE" ]; then
    stop_tracked_process "$FRONTEND_WATCH_PID_FILE" "frontend-watch"
    stop_tracked_process "$FRONTEND_GENERATED_WATCH_PID_FILE" "frontend-generated-watch"
    stop_tracked_process "$LEGACY_FRONTEND_CONTRACTS_WATCH_PID_FILE" "frontend-contracts-watch"
    stop_tracked_process "$STRIPE_PID_FILE" "stripe-listen"
    if dev-status >/dev/null 2>&1; then
        echo "devenv is healthy but unmanaged (no pid file); not stopping"
        exit 0
    fi
    echo "devenv not running (no pid file)"
    exit 0
fi

PID=$(cat "$PID_FILE")
if ! bepis_runtime_observe "$PID_FILE" devenv >/dev/null 2>&1; then
    bepis_runtime_stop "$PID_FILE" devenv 0 >/dev/null
    if dev-status >/dev/null 2>&1; then
        echo "devenv is healthy but unmanaged (stale or foreign pid evidence removed); not stopping"
        exit 0
    fi
    echo "devenv not running (stale or foreign pid evidence removed)"
    exit 0
fi

stop_tracked_process "$PID_FILE" "devenv"
stop_tracked_process "$FRONTEND_WATCH_PID_FILE" "frontend-watch"
stop_tracked_process "$FRONTEND_GENERATED_WATCH_PID_FILE" "frontend-generated-watch"
stop_tracked_process "$LEGACY_FRONTEND_CONTRACTS_WATCH_PID_FILE" "frontend-contracts-watch"
stop_tracked_process "$STRIPE_PID_FILE" "stripe-listen"
stop_tracked_process "$MAILHOG_PID_FILE" "mailhog"
echo "devenv stopped (slot=$BEPIS_WORKSPACE_SLOT, state=$STATE_DIR, postgres_root=$DEV_POSTGRES_ROOT, data=preserved)"
