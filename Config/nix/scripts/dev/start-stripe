#!/usr/bin/env bash
set -euo pipefail
# shellcheck source=../lib/stripe.sh
. "${BEPIS_SCRIPTS_ROOT:?}/lib/stripe.sh"
# shellcheck source=../lib/workspace.sh
. "${BEPIS_SCRIPTS_ROOT:?}/lib/workspace.sh"
# shellcheck source=../lib/stripe-dev.sh
. "${BEPIS_SCRIPTS_ROOT:?}/lib/stripe-dev.sh"

stripe_dev_load_and_validate_config
STATE_DIR="$(dev-agent-state-dir)"
PID_FILE="$STATE_DIR/devenv.pid"
STRIPE_PID_FILE="$STATE_DIR/stripe-listen.pid"
LOG_FILE="$STATE_DIR/devenv.log"
STRIPE_GENERATED_ENV="$STATE_DIR/stripe-generated.env"
APP_HEALTH_URL="$APP_BASE_URL"
mkdir -p "$STATE_DIR"

if dev-status >/dev/null 2>&1; then
    echo "devenv already healthy; run dev-stop before dev-start-stripe if you need Stripe webhook forwarding."
    exit 0
fi

if [ -f "$PID_FILE" ]; then
    PID=$(cat "$PID_FILE")
    if kill -0 "$PID" 2>/dev/null; then
        echo "devenv already running (pid=$PID); run dev-stop before dev-start-stripe."
        exit 0
    fi
    rm -f "$PID_FILE"
fi

: > "$LOG_FILE"
rm -f "$STRIPE_GENERATED_ENV"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-/tmp/nix-cache}"
mkdir -p "$XDG_CACHE_HOME"
dev-ensure-postgres
dev-ensure-mailhog

if command -v lsof >/dev/null 2>&1 \
    && lsof -nP -iTCP:"$PORT" -sTCP:LISTEN >/dev/null 2>&1 \
    && ! curl --connect-timeout 1 --max-time 2 -fsS "$APP_HEALTH_URL" >/dev/null; then
    echo "Port $PORT is occupied but not responding to $APP_HEALTH_URL." >&2
    echo "Stop the stale process before starting dev again:" >&2
    lsof -nP -iTCP:"$PORT" -sTCP:LISTEN >&2 || true
    exit 1
fi

stripe_dev_start_listener "$STATE_DIR" "$PORT"

umask 077
printf 'STRIPE_WEBHOOK_SECRET=%s\n' "$STRIPE_WEBHOOK_SECRET" > "$STRIPE_GENERATED_ENV"
# The child shell expands its own positional parameters.
# shellcheck disable=SC2016
setsid nohup bash -c '
    set -euo pipefail
    generated_env="$1"
    set -a
    . "$PWD/.env"
    . "$generated_env"
    rm -f "$generated_env"
    set +a
    . "$2"
    bepis_workspace_configure
    exec start
' bash "$STRIPE_GENERATED_ENV" "${BEPIS_SCRIPTS_ROOT:?}/lib/workspace.sh" </dev/null >>"$LOG_FILE" 2>&1 &
PID=$!
echo "$PID" > "$PID_FILE"
disown "$PID" 2>/dev/null || true

for _ in $(seq 1 3); do
    sleep 1
    if ! kill -0 "$PID" 2>/dev/null; then
        echo "devenv failed to start; recent log output:"
        tail -n 60 "$LOG_FILE" || true
        rm -f "$PID_FILE" "$STRIPE_GENERATED_ENV"
        stripe_dev_stop_listener "$STRIPE_PID_FILE"
        exit 1
    fi
done

echo "devenv started with Stripe forwarding (pid=$PID, stripe_pid=$(cat "$STRIPE_PID_FILE"), log=$LOG_FILE, stripe_log=$STATE_DIR/stripe-listen.log)"
