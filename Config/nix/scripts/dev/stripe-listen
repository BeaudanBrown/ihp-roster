#!/usr/bin/env bash
set -euo pipefail
# shellcheck source=../lib/stripe.sh
. "@scriptsRoot@/lib/stripe.sh"
if [ -f "$PWD/.env" ]; then
    set -a
    # shellcheck disable=SC1091
    . "$PWD/.env"
    set +a
fi
if [ -z "${STRIPE_SECRET_KEY:-}" ]; then
    echo "stripe-listen requires STRIPE_SECRET_KEY in the environment or .env." >&2
    exit 64
fi
exec stripe listen \
    --api-key "$STRIPE_SECRET_KEY" \
    --skip-update \
    --events "$IHP_ROSTER_STRIPE_WEBHOOK_EVENTS" \
    --forward-to localhost:8000/StripeWebhook
