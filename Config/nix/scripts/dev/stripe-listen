#!/usr/bin/env bash
set -euo pipefail
# shellcheck source=../lib/stripe.sh
. "${BEPIS_SCRIPTS_ROOT:?}/lib/stripe.sh"
# shellcheck source=../lib/workspace.sh
. "${BEPIS_SCRIPTS_ROOT:?}/lib/workspace.sh"
if [ -f "$PWD/.env" ]; then
    set -a
    # shellcheck disable=SC1091
    . "$PWD/.env"
    set +a
fi
bepis_workspace_configure
if [ -z "${STRIPE_SECRET_KEY:-}" ]; then
    echo "stripe-listen requires STRIPE_SECRET_KEY in the environment or .env." >&2
    exit 64
fi
require_stripe_test_secret_key "$STRIPE_SECRET_KEY" "stripe-listen"
echo "stripe-listen: requesting Stripe's latest snapshot format; Bepis accepts pinned contract $IHP_ROSTER_STRIPE_API_VERSION" >&2
export STRIPE_API_KEY="$STRIPE_SECRET_KEY"
exec stripe listen \
    --skip-update \
    --latest \
    --events "$IHP_ROSTER_STRIPE_WEBHOOK_EVENTS" \
    --forward-to "127.0.0.1:$PORT/StripeWebhook"
