#!/usr/bin/env bash
set -euo pipefail

# This tier is intentionally independent of verify-full. It owns synthetic
# checker and harness fixtures; repository authority stays in verify-full.
echo "verify-tooling: working-tree devenv script freshness"
devenv-script-freshness-check

echo "verify-tooling: production checker fixtures"
production-source-boundary-check
production-build-profile-test
production-build-budget-test

echo "verify-tooling: checker parser and publication fixtures"
weeder-policy-test
bash Config/nix/scripts/frontend/surface-adapter-publication-test
http-polling-policy-test
node --test scripts/documentation/check.test.mjs
node --test scripts/migration-enum-commit-boundary.test.mjs
migration-enum-commit-boundary-real-runner-test
migration-rehearsal-test
bash Config/nix/scripts/architecture/wiring-registry-test
node --test scripts/architecture/enum-authority.test.mjs
node --test scripts/architecture/layout-policy.test.mjs
node --test scripts/architecture/query.test.mjs

# These two mixed standalone checkers retain their real repository scans below;
# their fixture halves live here.
node --test scripts/architecture/email-transport.test.mjs
node --test scripts/architecture/fixture-reset-manifest.test.mjs
stripe-sandbox-contract-parity --self-test

echo "verify-tooling: generated-code provenance and watcher ownership"
bash "@scriptsRoot@/haskell/generated-ensure-test"
bash "@scriptsRoot@/frontend/generated-state-test"

echo "verify-tooling: development database maintenance harness"
dev-db-maintenance-test

echo "verify-tooling: E2E PostgreSQL lifecycle harness"
e2e-postgres-lifecycle-test
