#!/usr/bin/env bash
set -euo pipefail

# Synthetic checker/lifecycle fixtures; repository authority stays in verify-full.
# Keep stage timing and focused reruns here, not in another verification layer.
check() {
    local started="$SECONDS" status
    printf 'verify-tooling: start %s\n' "$*"
    if "$@"; then
        printf 'verify-tooling: passed (%ss) %s\n' "$((SECONDS - started))" "$*"
    else
        status="$?"
        printf 'verify-tooling: FAILED status=%s elapsed=%ss\n' "$status" "$((SECONDS - started))" >&2
        printf 'Focused rerun: bash ./bin/in-env' >&2
        printf ' %q' "$@" >&2
        printf '\n' >&2
        return "$status"
    fi
}

