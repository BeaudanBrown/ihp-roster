tooling-hls-test

echo "verify-tooling: workspace and Git lifecycle compatibility"
dev-workspace-test
epic-worktree-workflow-acceptance-test

echo "verify-tooling: checker parser and publication fixtures"
glue-compatibility-test
weeder-policy-test
node --test scripts/application-warnings.test.mjs scripts/weeder-reachability.test.mjs
bash "${BEPIS_SCRIPTS_ROOT:?}/frontend/surface-adapter-publication-test"
node --test scripts/authority-scan.test.mjs scripts/tooling-footprint.test.mjs
