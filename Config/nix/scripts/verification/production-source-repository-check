#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"
app_drv="$(nix eval --raw .#optimized-prod-server.drvPath --accept-flake-config)"
requisites="$(nix-store --query --requisites "$app_drv")"
source_paths="$(printf '%s\n' "$requisites" | grep -- '-ihp-roster-source$' || true)"
if [ "$(printf '%s\n' "$source_paths" | grep -c . || true)" -ne 1 ]; then
    echo "production-source-repository: expected one filtered project source below $app_drv" >&2
    exit 1
fi
production_source="$source_paths"
for excluded_root in Test docs e2e frontend scripts bin vendor; do
    if [ -e "$production_source/$excluded_root" ]; then
        echo "production-source-repository: excluded root leaked into production source: $excluded_root" >&2
        exit 1
    fi
done
while IFS= read -r -d '' required_path; do
    if [ ! -e "$production_source/$required_path" ]; then
        echo "production-source-repository: required production input omitted: $required_path" >&2
        exit 1
    fi
done < <(git ls-files -z -- \
    Application/Schema.sql Application/Migration Application/Deployment static \
    Config/nix/hosts Config/nix/modules \
    Config/nix/production-package-dependency-inventory.tsv Makefile)
echo "production-source-repository: explicit production source contains required inputs only"
