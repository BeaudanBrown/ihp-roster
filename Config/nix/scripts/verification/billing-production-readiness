#!/usr/bin/env bash
set -euo pipefail

echo "billing-production-readiness: Stripe OpenAPI and sanitized fixtures"
python3 scripts/check-stripe-openapi-contract

# This is deliberately offline: the real Sandbox probe requires an explicit
# STRIPE_SANDBOX_PARITY=1 operator invocation and refuses CI.
echo "billing-production-readiness: Stripe Sandbox probe sanitizer"
stripe-sandbox-contract-parity --self-test

echo "billing-production-readiness: predecessor migration upgrade"
billing-migration-check

echo "billing-production-readiness: production NixOS billing options and assertions"
nix eval --impure --json --file Config/nix/tests/billing-stripe-module.nix >/dev/null

echo "Billing production-readiness checks passed"
