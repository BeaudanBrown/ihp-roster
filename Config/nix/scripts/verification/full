#!/usr/bin/env bash
set -euo pipefail

echo "verify-full: working-tree devenv script freshness"
devenv-script-freshness-check

echo "verify-full: explicit production manifest authority"
production-manifest-check

echo "verify-full: production HTTP polling policy"
http-repository-check

echo "verify-full: zero-bypass typed contract authority"
typed-contract-authority-check

echo "verify-full: canonical wage authority and fixtures"
bash ./bin/wage-authority-check

echo "verify-full: date-native Roster runtime authority"
bash ./bin/date-native-roster-authority-check

echo "verify-full: documentation links, anchors, archive inventory, and scoped retired terms"
documentation-repository-check

echo "verify-full: typecheck"
typecheck

# Keep the complete default selection; never substitute a feedback-only lane here.
echo "verify-full: complete Hspec"
hspec-test

echo "verify-full: application reachability policy"
weeder-check

# Reuse the isolated package for every generator/freshness command below.
export FRONTEND_CONTRACT_USE_PACKAGE=1
echo "verify-full: isolated frontend-contract tooling package"
# Retain the resolved tooling root for the later single production-closure
# traversal, which proves tooling isolation without a second package build.
source "$(command -v frontend-contract-package-check)"
# The package check generated these contracts; later architecture validation
# consumes that same checked output rather than regenerating it.
export ARCHITECTURE_CONTRACTS_CURRENT=1

echo "verify-full: curated FrontendContract warnings"
frontend-contract-warnings

echo "verify-full: generated frontend, TypeScript, and browser unit checks"
frontend-runtime-check
frontend-surface-compile-fail-check

echo "verify-full: CSS ownership and stale-selector checks"
bash ./bin/style-audit

echo "verify-full: current architecture authority"
architecture-repository-check

echo "verify-full: optimized production package and consolidated inspection"
production-inspection-check

echo "verify-full: billing contracts"
billing-contract-check

echo "verify-full: deployment modules"
deployment-module-check

echo "verify-full: complete Playwright"
E2E_SHARDS=8 e2e
