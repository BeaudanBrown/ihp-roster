#!/usr/bin/env bash
set -euo pipefail

echo "verify-full: working-tree devenv script freshness"
devenv-script-freshness-check

echo "verify-full: explicit production module and script inventory"
production-inventory-check

echo "verify-full: typecheck"
typecheck

# Keep the complete default selection; never substitute a feedback-only lane here.
echo "verify-full: complete Hspec"
hspec-test

echo "verify-full: zero-bypass typed contract authority"
typed-contract-authority-check

echo "verify-full: curated FrontendContract warnings"
frontend-contract-warnings

echo "verify-full: application reachability policy"
weeder-policy-test
weeder-check

echo "verify-full: generated frontend, TypeScript, and browser unit checks"
frontend-check

echo "verify-full: CSS ownership and stale-selector checks"
bash ./bin/style-audit

echo "verify-full: architecture and documentation structure"
architecture-check-fresh
bash ./bin/doc-drift-check

echo "verify-full: production build profiler contract"
production-build-profile-test

echo "verify-full: production package executable and deployment smoke"
production-package-smoke

echo "verify-full: canonical wage authority and fixtures"
bash ./bin/wage-authority-check

echo "verify-full: billing production-readiness"
billing-production-readiness

echo "verify-full: wage-cutover deployment ordering"
nix eval --impure --json --file Config/nix/tests/wage-cutover-module.nix >/dev/null

echo "verify-full: E2E PostgreSQL lifecycle preflight"
e2e-postgres-lifecycle-test

echo "verify-full: complete Playwright"
e2e
