#!/usr/bin/env bash
set -euo pipefail

if [ -z "${PRODUCTION_SOURCE_BOUNDARY_FIXTURE_ROOT:-}" ]; then
    source_root="$(git rev-parse --show-toplevel)"
    fixture_parent="$(mktemp -d)"
    fixture_root="$fixture_parent/source"
    mkdir -p "$fixture_root"
    cleanup_fixture() {
        rm -rf "$fixture_parent"
    }
    trap cleanup_fixture EXIT
    while IFS= read -r -d '' path; do
        if [ -e "$source_root/$path" ] || [ -L "$source_root/$path" ]; then
            printf '%s\0' "$path"
        fi
    done < <(git -C "$source_root" ls-files -z --cached --others --exclude-standard) \
        | tar -C "$source_root" --null --files-from=- -cf - \
        | tar -C "$fixture_root" -xf -
    git -C "$fixture_root" init -q
    git -C "$fixture_root" config user.name 'Bepis source boundary fixture'
    git -C "$fixture_root" config user.email 'source-boundary@invalid.example'
    git -C "$fixture_root" add -A
    git -C "$fixture_root" commit -qm 'isolated source-boundary fixture'
    PRODUCTION_SOURCE_BOUNDARY_FIXTURE_ROOT="$fixture_root" "$0"
    exit $?
fi

repo_root="$PRODUCTION_SOURCE_BOUNDARY_FIXTURE_ROOT"
cd "$repo_root"

probe_paths=(
    docs/README.md
    e2e/AGENTS.md
    frontend/ts/app-bootstrap.ts
    Main.hs
    Application/AccountSecurityEmail/Email.hs
    Application/Schema.sql
    Application/Migration/1783512600.sql
    static/manifest.json
    Config/nix/modules/ihp-roster.nix
    Config/nix/production-package-dependency-inventory.tsv
)
backup_root="$(mktemp -d)"
untracked_probe_path="static/.production-source-untracked-probe"
restore_sources() {
    local path
    for path in "${probe_paths[@]}"; do
        cp "$backup_root/$path" "$path"
    done
    rm -f "$untracked_probe_path"
    rm -rf "$backup_root"
}
for path in "${probe_paths[@]}"; do
    mkdir -p "$backup_root/$(dirname "$path")"
    cp "$path" "$backup_root/$path"
done
trap restore_sources EXIT

production_derivations() {
    local graph app_drv requisites app_lib_drvs source_paths
    graph="$(nix eval --impure --json --accept-flake-config --expr '
        let
            flake = builtins.getFlake ("git+file://" + toString ./.);
            packages = flake.packages.${builtins.currentSystem};
        in {
            app = packages.optimized-prod-server.drvPath;
            static = packages.static.drvPath;
            schema = packages.schema.drvPath;
            deployment = import ./Config/nix/tests/production-deployment-derivation.nix;
        }')"
    app_drv="$(jq -r .app <<<"$graph")"
    requisites="$(nix-store --query --requisites "$app_drv")"
    app_lib_drvs="$(printf '%s\n' "$requisites" | grep -- '-app-lib-0\.1\.0\.drv$' || true)"
    source_paths="$(printf '%s\n' "$requisites" | grep -- '-ihp-roster-source$' || true)"
    if [ "$(printf '%s\n' "$app_lib_drvs" | grep -c . || true)" -ne 1 ] \
        || [ "$(printf '%s\n' "$source_paths" | grep -c . || true)" -ne 1 ]; then
        echo "production-source-boundary: expected one app-lib and filtered source below $app_drv" >&2
        exit 1
    fi
    jq -r --arg library "$app_lib_drvs" --arg source "$source_paths" \
        '[.app, $library, $source, .static, .schema, .deployment] | @tsv' <<<"$graph"
}

snapshot_probe() {
    local path="$1"
    local marker="$2"
    printf '%s\n' "$marker" >> "$path"
    production_derivations
    cp "$backup_root/$path" "$path"
}

snapshot_untracked_static_probe() {
    printf 'untracked development artifact\n' > "$untracked_probe_path"
    production_derivations
    rm -f "$untracked_probe_path"
}

snapshot_deployment_module_probe() {
    local path="Config/nix/modules/ihp-roster.nix"
    local before='description = "Enqueue Stripe subscription reconciliation jobs for ihp-roster";'
    local after='description = "Enqueue Stripe subscription reconciliation jobs for ihp-roster (source-boundary probe)";'
    if [ "$(grep -Fc "$before" "$path")" -ne 1 ]; then
        echo "production-source-boundary: deployment mutation marker changed" >&2
        exit 1
    fi
    sed -i "s|$before|$after|" "$path"
    production_derivations
    cp "$backup_root/$path" "$path"
}

field_names=(app app-lib source static schema deployment)
assert_effects() {
    local description="$1"
    local actual="$2"
    local changed_csv="$3"
    local expected_change index name
    IFS=$'\t' read -r -a baseline_fields <<< "$baseline"
    IFS=$'\t' read -r -a actual_fields <<< "$actual"
    for index in "${!field_names[@]}"; do
        name="${field_names[$index]}"
        expected_change=false
        [[ ",$changed_csv," == *",$name,"* ]] && expected_change=true
        if { [ "$expected_change" = true ] && [ "${baseline_fields[$index]}" = "${actual_fields[$index]}" ]; } \
            || { [ "$expected_change" = false ] && [ "${baseline_fields[$index]}" != "${actual_fields[$index]}" ]; }; then
            echo "production-source-boundary: $description had wrong $name invalidation" >&2
            diff -u <(printf '%s\n' "$baseline") <(printf '%s\n' "$actual") >&2 || true
            exit 1
        fi
    done
}

baseline="$(production_derivations)"
IFS=$'\t' read -r _ _ production_source _ _ _ <<< "$baseline"
for excluded_root in Test docs e2e frontend scripts bin tooling vendor; do
    if [ -e "$production_source/$excluded_root" ]; then
        echo "production-source-boundary: excluded root leaked into production source: $excluded_root" >&2
        exit 1
    fi
done
while IFS= read -r -d '' required_path; do
    if [ ! -e "$production_source/$required_path" ]; then
        echo "production-source-boundary: required production input omitted: $required_path" >&2
        exit 1
    fi
done < <(git ls-files -z -- \
    Application/Schema.sql Application/Migration Application/Deployment static \
    Config/nix/hosts Config/nix/modules \
    Config/nix/production-package-dependency-inventory.tsv Makefile)

assert_effects "documentation edit" "$(snapshot_probe docs/README.md '<!-- source-boundary probe -->')" ""
assert_effects "E2E edit" "$(snapshot_probe e2e/AGENTS.md '<!-- source-boundary probe -->')" ""
assert_effects "authored frontend edit" "$(snapshot_probe frontend/ts/app-bootstrap.ts '// source-boundary probe')" ""
assert_effects "untracked static artifact" "$(snapshot_untracked_static_probe)" ""
assert_effects "Main edit" "$(snapshot_probe Main.hs '-- source-boundary probe')" "app,app-lib,source,deployment"
assert_effects "inventoried Haskell edit" "$(snapshot_probe Application/AccountSecurityEmail/Email.hs '-- source-boundary probe')" "app,app-lib,source,deployment"
assert_effects "schema edit" "$(snapshot_probe Application/Schema.sql '-- source-boundary probe')" "app,app-lib,source,schema,deployment"
assert_effects "migration edit" "$(snapshot_probe Application/Migration/1783512600.sql '-- source-boundary probe')" "app,app-lib,source,deployment"
assert_effects "static edit" "$(snapshot_probe static/manifest.json ' ')" "app,app-lib,source,static,deployment"
assert_effects "deployment module edit" "$(snapshot_deployment_module_probe)" "app,app-lib,source,deployment"
assert_effects "package inventory edit" "$(snapshot_probe Config/nix/production-package-dependency-inventory.tsv '# source-boundary probe')" "app,app-lib,source,deployment"

echo "production-source-boundary: excluded edits stable; runtime, database, static, deployment and package inputs invalidated exact owners"
