#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
budget="$repo_root/Config/nix/baselines/production-build/final-regression-budget.json"
profile="${1:-}"
temporary=""
cleanup() {
    if [ -n "$temporary" ]; then rm -rf "$temporary"; fi
}
trap cleanup EXIT

if [ -z "$profile" ]; then
    temporary="$(mktemp -d)"
    if ! production-build-profile --output-dir "$temporary" --no-rebuild; then
        echo "production-build-budget-check: current app-lib output is absent; run production-package-smoke first" >&2
        exit 1
    fi
    profile="$temporary/profile.json"
fi

node "$repo_root/scripts/production-build-budget.mjs" \
    --budget "$budget" \
    --profile "$profile"
