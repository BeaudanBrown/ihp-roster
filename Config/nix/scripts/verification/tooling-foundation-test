#!/usr/bin/env bash
set -euo pipefail

program="tooling-foundation-test"
repo_root="$(git rev-parse --show-toplevel)"
fixture_root="$(mktemp -d)"
cleanup() {
    rm -rf "$fixture_root"
}
trap cleanup EXIT

fail() {
    echo "$program: $*" >&2
    exit 1
}

cabal test --project-dir="$repo_root" --project-file=tooling/cabal.project \
    --builddir="$repo_root/tooling/dist-newstyle" all >/dev/null
core_test="$(cabal list-bin --project-dir="$repo_root" --project-file=tooling/cabal.project \
    --builddir="$repo_root/tooling/dist-newstyle" bepis-tooling-core:test:bepis-tooling-core-test)"

lock="$fixture_root/interop.lock"
ready="$fixture_root/holder-ready"
"$core_test" --hold-lock "$lock" "$ready" 10000000 &
holder=$!
for _ in $(seq 1 100); do
    [ -f "$ready" ] && break
    sleep 0.01
done
[ -f "$ready" ] || fail "Haskell lock holder did not become ready"
if flock -n "$lock" true; then
    fail "Bash flock entered while Haskell held the lock"
fi
kill -TERM "$holder"
wait "$holder" 2>/dev/null || true
flock -n "$lock" true || fail "terminated Haskell holder retained the lock"

rm -f "$ready"
"$core_test" --spawn-child "$lock" "$ready"
[ -f "$ready" ] || fail "close-on-exec lock probe did not run"
flock -w 0.5 "$lock" true || fail "executed child inherited the Haskell lock descriptor"

fixture_repo="$fixture_root/repo"
mkdir -p "$fixture_repo"
(
    cd "$repo_root"
    git ls-files --cached --others --exclude-standard -z \
        | tar --null --files-from=- --create
) | tar --extract --directory="$fixture_repo"
chmod +x "$fixture_repo/bin/tooling-run"

cold="$fixture_root/cold.out"
warm="$fixture_root/warm.out"
BEPIS_TOOLING_ENV=1 "$fixture_repo/bin/tooling-run" workspace contract >"$cold"
BEPIS_TOOLING_ENV=1 "$fixture_repo/bin/tooling-run" workspace contract >"$warm"
grep -q '"identityVersion":1' "$cold" || fail "cold launcher omitted workspace contract"
cmp -s "$cold" "$warm" || fail "warm launcher changed command output"

printf '\nthis is not Haskell\n' >>"$fixture_repo/tooling/workspace-state/app/Main.hs"
if BEPIS_TOOLING_ENV=1 "$fixture_repo/bin/tooling-run" workspace contract >"$fixture_root/dirty.out" 2>"$fixture_root/dirty.err"; then
    fail "dirty compile failure executed successfully"
fi
if grep -q '"identityVersion":1' "$fixture_root/dirty.out"; then
    fail "dirty compile failure fell back to the old executable"
fi

git -C "$repo_root" show HEAD:tooling/workspace-state/app/Main.hs >"$fixture_repo/tooling/workspace-state/app/Main.hs" 2>/dev/null \
    || cp "$repo_root/tooling/workspace-state/app/Main.hs" "$fixture_repo/tooling/workspace-state/app/Main.hs"
mkdir -p "$fixture_repo/tooling/workspace-state/app/Fixture"
printf 'module Fixture.Untracked where\ninvalid =\n' >"$fixture_repo/tooling/workspace-state/app/Fixture/Untracked.hs"
awk '{ print; if ($0 == "module Main (main) where") print "\nimport Fixture.Untracked ()" }' \
    "$fixture_repo/tooling/workspace-state/app/Main.hs" >"$fixture_root/Main.hs"
mv "$fixture_root/Main.hs" "$fixture_repo/tooling/workspace-state/app/Main.hs"
if BEPIS_TOOLING_ENV=1 "$fixture_repo/bin/tooling-run" workspace contract >"$fixture_root/untracked.out" 2>"$fixture_root/untracked.err"; then
    fail "untracked compile failure executed successfully"
fi
if grep -q '"identityVersion":1' "$fixture_root/untracked.out"; then
    fail "untracked compile failure fell back to the old executable"
fi

nix_value() {
    nix eval --raw --impure --expr "$1"
}
flake_ref="path:$repo_root"
packages_expr="let f = builtins.getFlake \"$flake_ref\"; p = f.inputs.nixpkgs.legacyPackages.\${builtins.currentSystem}; in import $repo_root/Config/nix/flake/tooling-packages.nix { pkgs = p; root = $fixture_repo; }"
core_before="$(nix_value "((${packages_expr}).core).drvPath")"
workspace_before="$(nix_value "((${packages_expr}).workspaceState).drvPath")"
postgres_before="$(nix_value "((${packages_expr}).postgres).drvPath")"
runtime_before="$(nix_value "((${packages_expr}).runtime).drvPath")"
epic_before="$(nix_value "((${packages_expr}).epicLifecycle).drvPath")"
artifacts_before="$(nix_value "((${packages_expr}).artifacts).drvPath")"
production_before="$(nix_value "let f = builtins.getFlake \"$flake_ref\"; p = f.inputs.nixpkgs.legacyPackages.\${builtins.currentSystem}; in toString (import $repo_root/Config/nix/flake/project-source.nix { pkgs = p; root = $fixture_repo; })")"

mkdir -p "$fixture_repo/tooling/unrelated-family"
printf 'unrelated\n' >"$fixture_repo/tooling/unrelated-family/source"
[ "$(nix_value "((${packages_expr}).core).drvPath")" = "$core_before" ] || fail "unrelated family invalidated core"
[ "$(nix_value "((${packages_expr}).workspaceState).drvPath")" = "$workspace_before" ] || fail "unrelated family invalidated workspace"
[ "$(nix_value "((${packages_expr}).postgres).drvPath")" = "$postgres_before" ] || fail "unrelated family invalidated postgres"
[ "$(nix_value "((${packages_expr}).runtime).drvPath")" = "$runtime_before" ] || fail "unrelated family invalidated runtime"
[ "$(nix_value "((${packages_expr}).epicLifecycle).drvPath")" = "$epic_before" ] || fail "unrelated family invalidated epic lifecycle"
[ "$(nix_value "((${packages_expr}).artifacts).drvPath")" = "$artifacts_before" ] || fail "unrelated family invalidated artifacts"
[ "$(nix_value "let f = builtins.getFlake \"$flake_ref\"; p = f.inputs.nixpkgs.legacyPackages.\${builtins.currentSystem}; in toString (import $repo_root/Config/nix/flake/project-source.nix { pkgs = p; root = $fixture_repo; })")" = "$production_before" ] \
    || fail "tooling-only input changed production source"

printf '\n-- workspace-only invalidation probe\n' >>"$fixture_repo/tooling/workspace-state/src/Bepis/Tooling/Workspace/State.hs"
workspace_edited="$(nix_value "((${packages_expr}).workspaceState).drvPath")"
[ "$(nix_value "((${packages_expr}).core).drvPath")" = "$core_before" ] || fail "workspace edit invalidated core"
[ "$workspace_edited" != "$workspace_before" ] || fail "workspace source edit did not invalidate workspace"
workspace_dependent_postgres="$(nix_value "((${packages_expr}).postgres).drvPath")"
workspace_dependent_runtime="$(nix_value "((${packages_expr}).runtime).drvPath")"
workspace_dependent_epic="$(nix_value "((${packages_expr}).epicLifecycle).drvPath")"
[ "$workspace_dependent_postgres" != "$postgres_before" ] || fail "workspace source edit did not invalidate postgres dependent"
[ "$workspace_dependent_runtime" != "$runtime_before" ] || fail "workspace source edit did not invalidate runtime dependent"
[ "$workspace_dependent_epic" != "$epic_before" ] || fail "workspace source edit did not invalidate epic dependent"
[ "$(nix_value "((${packages_expr}).artifacts).drvPath")" = "$artifacts_before" ] || fail "workspace edit invalidated artifacts"

printf '\n-- postgres-only invalidation probe\n' >>"$fixture_repo/tooling/postgres/src/Bepis/Tooling/Postgres.hs"
postgres_edited="$(nix_value "((${packages_expr}).postgres).drvPath")"
[ "$postgres_edited" != "$workspace_dependent_postgres" ] || fail "postgres source edit did not invalidate postgres"
[ "$(nix_value "((${packages_expr}).core).drvPath")" = "$core_before" ] || fail "postgres edit invalidated core"
[ "$(nix_value "((${packages_expr}).workspaceState).drvPath")" = "$workspace_edited" ] || fail "postgres edit invalidated workspace"
[ "$(nix_value "((${packages_expr}).runtime).drvPath")" = "$workspace_dependent_runtime" ] || fail "postgres edit invalidated runtime"
[ "$(nix_value "((${packages_expr}).epicLifecycle).drvPath")" = "$workspace_dependent_epic" ] || fail "postgres edit invalidated epic lifecycle"
[ "$(nix_value "((${packages_expr}).artifacts).drvPath")" = "$artifacts_before" ] || fail "postgres edit invalidated artifacts"

printf '\n-- runtime-only invalidation probe\n' >>"$fixture_repo/tooling/runtime/src/Bepis/Tooling/Runtime.hs"
runtime_edited="$(nix_value "((${packages_expr}).runtime).drvPath")"
runtime_dependent_epic="$(nix_value "((${packages_expr}).epicLifecycle).drvPath")"
[ "$runtime_edited" != "$workspace_dependent_runtime" ] || fail "runtime source edit did not invalidate runtime"
[ "$(nix_value "((${packages_expr}).core).drvPath")" = "$core_before" ] || fail "runtime edit invalidated core"
[ "$(nix_value "((${packages_expr}).workspaceState).drvPath")" = "$workspace_edited" ] || fail "runtime edit invalidated workspace"
[ "$(nix_value "((${packages_expr}).postgres).drvPath")" = "$postgres_edited" ] || fail "runtime edit invalidated postgres"
[ "$runtime_dependent_epic" != "$workspace_dependent_epic" ] || fail "runtime source edit did not invalidate epic dependent"
[ "$(nix_value "((${packages_expr}).artifacts).drvPath")" = "$artifacts_before" ] || fail "runtime edit invalidated artifacts"

printf '\n-- epic-only invalidation probe\n' >>"$fixture_repo/tooling/epic-lifecycle/src/Bepis/Tooling/Epic.hs"
epic_edited="$(nix_value "((${packages_expr}).epicLifecycle).drvPath")"
[ "$epic_edited" != "$runtime_dependent_epic" ] || fail "epic source edit did not invalidate epic lifecycle"
[ "$(nix_value "((${packages_expr}).core).drvPath")" = "$core_before" ] || fail "epic edit invalidated core"
[ "$(nix_value "((${packages_expr}).workspaceState).drvPath")" = "$workspace_edited" ] || fail "epic edit invalidated workspace"
[ "$(nix_value "((${packages_expr}).runtime).drvPath")" = "$runtime_edited" ] || fail "epic edit invalidated runtime"
[ "$(nix_value "((${packages_expr}).postgres).drvPath")" = "$postgres_edited" ] || fail "epic edit invalidated postgres"
[ "$(nix_value "((${packages_expr}).artifacts).drvPath")" = "$artifacts_before" ] || fail "epic edit invalidated artifacts"

printf '\n-- artifacts-only invalidation probe\n' >>"$fixture_repo/tooling/artifacts/src/Bepis/Tooling/Artifacts.hs"
artifacts_edited="$(nix_value "((${packages_expr}).artifacts).drvPath")"
[ "$artifacts_edited" != "$artifacts_before" ] || fail "artifacts source edit did not invalidate artifacts"
[ "$(nix_value "((${packages_expr}).core).drvPath")" = "$core_before" ] || fail "artifacts edit invalidated core"
[ "$(nix_value "((${packages_expr}).workspaceState).drvPath")" = "$workspace_edited" ] || fail "artifacts edit invalidated workspace"
[ "$(nix_value "((${packages_expr}).runtime).drvPath")" = "$runtime_edited" ] || fail "artifacts edit invalidated runtime"
[ "$(nix_value "((${packages_expr}).postgres).drvPath")" = "$postgres_edited" ] || fail "artifacts edit invalidated postgres"
[ "$(nix_value "((${packages_expr}).epicLifecycle).drvPath")" = "$epic_edited" ] || fail "artifacts edit invalidated epic lifecycle"

printf '\n-- dependency invalidation probe\n' >>"$fixture_repo/tooling/core/src/Bepis/Tooling/Core/OwnedFile.hs"
core_after="$(nix_value "((${packages_expr}).core).drvPath")"
workspace_after="$(nix_value "((${packages_expr}).workspaceState).drvPath")"
postgres_after="$(nix_value "((${packages_expr}).postgres).drvPath")"
runtime_after="$(nix_value "((${packages_expr}).runtime).drvPath")"
epic_after="$(nix_value "((${packages_expr}).epicLifecycle).drvPath")"
artifacts_after="$(nix_value "((${packages_expr}).artifacts).drvPath")"
[ "$core_after" != "$core_before" ] || fail "core source edit did not invalidate core"
[ "$workspace_after" != "$workspace_edited" ] || fail "core source edit did not invalidate its workspace dependent"
[ "$postgres_after" != "$postgres_edited" ] || fail "core source edit did not invalidate its postgres dependent"
[ "$runtime_after" != "$runtime_edited" ] || fail "core source edit did not invalidate its runtime dependent"
[ "$epic_after" != "$epic_edited" ] || fail "core source edit did not invalidate its epic dependent"
[ "$artifacts_after" != "$artifacts_edited" ] || fail "core source edit did not invalidate its artifacts dependent"

echo "$program: ok"
