#!/usr/bin/env bash
set -euo pipefail

production-inventory-check

output="$(nix build --no-link --print-out-paths .#optimized-prod-server --accept-flake-config)"
actual="$(find "$output/bin" -maxdepth 1 -type f -printf '%f\n' | sort)"
expected="$(awk -F '\t' 'NR > 1 { print $1 }' Config/nix/production-executable-inventory.tsv | sort)"
if [ "$actual" != "$expected" ]; then
    echo "production-package-smoke: packaged bin inventory mismatch" >&2
    diff -u <(printf '%s\n' "$expected") <(printf '%s\n' "$actual") >&2 || true
    exit 1
fi

production_derivation="$(nix-store --query --deriver "$output")"
mapfile -t app_lib_src_derivations < <(nix-store --query --requisites "$production_derivation" | grep -- '-app-lib-src\.drv$')
if [ "${#app_lib_src_derivations[@]}" -ne 1 ]; then
    echo "production-package-smoke: expected one generated app-lib source derivation, found ${#app_lib_src_derivations[@]}" >&2
    printf '%s\n' "${app_lib_src_derivations[@]}" >&2
    exit 1
fi
app_lib_src="$(nix-store --query --outputs "${app_lib_src_derivations[0]}")"
app_lib_cabal="$app_lib_src/app-lib.cabal"
if [ ! -r "$app_lib_cabal" ]; then
    echo "production-package-smoke: generated app-lib Cabal file is unreadable: $app_lib_cabal" >&2
    exit 1
fi
if test_dependency_matches="$(grep -E '^[[:space:]]*,?[[:space:]]*(QuickCheck|quickcheck-[^[:space:]]*|hspec|hspec-[^[:space:]]*|ihp-hspec)([[:space:]]|$)' "$app_lib_cabal")"; then
    echo "production-package-smoke: generated app-lib declares a test-only Hspec, QuickCheck, or IHP test dependency" >&2
    printf '%s\n' "$test_dependency_matches" >&2
    exit 1
else
    grep_status="$?"
    if [ "$grep_status" -ne 1 ]; then
        echo "production-package-smoke: could not inspect generated app-lib dependencies (grep exit $grep_status)" >&2
        exit 1
    fi
fi

# Enter each wrapped executable only through the RTS boundary. This proves the
# packaged binary launches without running database- or network-mutating main.
while IFS= read -r executable; do
    "$output/bin/$executable" +RTS --info >/dev/null
done <<< "$expected"

# Focused deployed service evaluations retain the migration/recovery and Stripe
# reconciliation consumers. Remaining executable consumers are checked against
# their exact NixOS source markers by production-inventory-check.
nix eval --impure --json --file Config/nix/tests/wage-cutover-module.nix >/dev/null
nix eval --impure --json --file Config/nix/tests/billing-stripe-module.nix >/dev/null

echo "production-package-smoke: ok ($(printf '%s\n' "$expected" | wc -l) packaged executables)"
