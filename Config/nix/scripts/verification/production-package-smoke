#!/usr/bin/env bash
set -euo pipefail

production-inventory-check

output="$(nix build --no-link --print-out-paths .#optimized-prod-server --accept-flake-config)"
actual="$(find "$output/bin" -maxdepth 1 -type f -printf '%f\n' | sort)"
expected="$(awk -F '\t' 'NR > 1 { print $1 }' Config/nix/production-executable-inventory.tsv | sort)"
if [ "$actual" != "$expected" ]; then
    echo "production-package-smoke: packaged bin inventory mismatch" >&2
    diff -u <(printf '%s\n' "$expected") <(printf '%s\n' "$actual") >&2 || true
    exit 1
fi

production_derivation="$(nix-store --query --deriver "$output")"
mapfile -t app_lib_src_derivations < <(nix-store --query --requisites "$production_derivation" | grep -- '-app-lib-src\.drv$')
if [ "${#app_lib_src_derivations[@]}" -ne 1 ]; then
    echo "production-package-smoke: expected one generated app-lib source derivation, found ${#app_lib_src_derivations[@]}" >&2
    printf '%s\n' "${app_lib_src_derivations[@]}" >&2
    exit 1
fi
app_lib_src="$(nix-store --query --outputs "${app_lib_src_derivations[0]}")"
app_lib_cabal="$app_lib_src/app-lib.cabal"
if [ ! -r "$app_lib_cabal" ]; then
    echo "production-package-smoke: generated app-lib Cabal file is unreadable: $app_lib_cabal" >&2
    exit 1
fi
if test_dependency_matches="$(grep -E '^[[:space:]]*,?[[:space:]]*(QuickCheck|QuickCheck-[^,[:space:]]*|quickcheck-[^,[:space:]]*|hspec|hspec-[^,[:space:]]*|ihp-hspec|ihp-hspec-[^,[:space:]]*)([,[:space:]]|$)' "$app_lib_cabal")"; then
    echo "production-package-smoke: generated app-lib declares a test-only Hspec, QuickCheck, or IHP test dependency" >&2
    printf '%s\n' "$test_dependency_matches" >&2
    exit 1
else
    grep_status="$?"
    if [ "$grep_status" -ne 1 ]; then
        echo "production-package-smoke: could not inspect generated app-lib dependencies (grep exit $grep_status)" >&2
        exit 1
    fi
fi
actual_cabal_dependencies="$(
    awk '/^    build-depends:/{in_dependencies=1; next} in_dependencies && /^    exposed-modules:/{exit} in_dependencies {gsub(/^[[:space:]]*,?[[:space:]]*/, ""); if ($0 != "") print}' "$app_lib_cabal" \
        | LC_ALL=C sort
)"
expected_cabal_dependencies="$(
    awk -F '\t' 'NR > 1 { print $2 }' Config/nix/production-package-dependency-inventory.tsv \
        | LC_ALL=C sort -u
)"
if [ "$actual_cabal_dependencies" != "$expected_cabal_dependencies" ]; then
    echo "production-package-smoke: generated app-lib dependencies differ from the reviewed production import authority" >&2
    diff -u <(printf '%s\n' "$expected_cabal_dependencies") <(printf '%s\n' "$actual_cabal_dependencies") >&2 || true
    exit 1
fi

mapfile -t app_lib_derivations < <(nix-store --query --requisites "$production_derivation" | grep -- '-app-lib-0\.1\.0\.drv$')
if [ "${#app_lib_derivations[@]}" -ne 1 ]; then
    echo "production-package-smoke: expected one app-lib derivation, found ${#app_lib_derivations[@]}" >&2
    printf '%s\n' "${app_lib_derivations[@]}" >&2
    exit 1
fi
app_lib_output="$(nix-store --query --outputs "${app_lib_derivations[0]}")"
if find "$app_lib_output" \( -type f -o -type l \) \( -name '*.dyn_hi' -o -name '*.so' -o -name '*.so.*' \) -print -quit | grep -q .; then
    echo "production-package-smoke: static-only app-lib contains a dynamic interface or shared object" >&2
    find "$app_lib_output" \( -type f -o -type l \) \( -name '*.dyn_hi' -o -name '*.so' -o -name '*.so.*' \) -print >&2
    exit 1
fi
static_library_count="$(find "$app_lib_output" -type f -name '*.a' | wc -l)"
interface_count="$(find "$app_lib_output" -type f -name '*.hi' | wc -l)"
if [ "$static_library_count" -ne 1 ] || [ "$interface_count" -eq 0 ]; then
    echo "production-package-smoke: static app-lib must retain one archive and its interfaces; found $static_library_count archives and $interface_count interfaces" >&2
    exit 1
fi
if runtime_app_lib_paths="$(nix-store --query --requisites "$output" | grep -- '-app-lib-' || true)" && [ -n "$runtime_app_lib_paths" ]; then
    echo "production-package-smoke: packaged runtime closure retains app-lib" >&2
    printf '%s\n' "$runtime_app_lib_paths" >&2
    exit 1
fi

# Enter each wrapped executable only through the RTS boundary. This proves the
# packaged binary launches without running database- or network-mutating main.
while IFS= read -r executable; do
    wrapper="$output/bin/$executable"
    real_binary="$(sed -n 's/^exec \(-a "\$0" \)\?"\([^"]*\)".*$/\2/p' "$wrapper")"
    if [ -z "$real_binary" ]; then
        real_binary="$wrapper"
    fi
    if [ ! -x "$real_binary" ]; then
        echo "production-package-smoke: cannot resolve wrapped binary for $executable" >&2
        exit 1
    fi
    if dynamic_links="$(ldd "$real_binary")"; then
        if grep -E 'app-lib|not found' <<< "$dynamic_links" >/dev/null; then
            echo "production-package-smoke: $executable has an invalid app-lib runtime link" >&2
            printf '%s\n' "$dynamic_links" >&2
            exit 1
        fi
    else
        echo "production-package-smoke: ldd failed for $real_binary" >&2
        printf '%s\n' "$dynamic_links" >&2
        exit 1
    fi
    "$wrapper" +RTS --info >/dev/null
done <<< "$expected"

# Focused deployed service evaluations retain migration/recovery, Stripe
# reconciliation, and reference-refresh cadence consumers. Remaining executable
# consumers are checked against their exact NixOS source markers by
# production-inventory-check.
nix eval --impure --json --file Config/nix/tests/wage-cutover-module.nix >/dev/null
nix eval --impure --json --file Config/nix/tests/billing-stripe-module.nix >/dev/null
nix eval --impure --json --file Config/nix/tests/fwc-mapd-refresh-module.nix >/dev/null

echo "production-package-smoke: ok ($(printf '%s\n' "$expected" | wc -l) packaged executables)"
