#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
fixture_root="$(mktemp -d)"
cleanup() { rm -rf "$fixture_root"; }
trap cleanup EXIT

cat >"$fixture_root/modules.tsv" <<'EOF'
path	classification	root	category	reason
Main.hs	production	Main	runtime	fixture
Application/Helper.hs	production	Main	runtime	fixture
Test/Helper.hs	development	-	test	fixture
EOF
cat >"$fixture_root/dependencies.tsv" <<'EOF'
module	package	source	root	reason
Data.Aeson	aeson	Application/Helper.hs	Main	fixture
Prelude	base	Main.hs	Main	fixture
EOF
cat >"$fixture_root/executables.tsv" <<'EOF'
executable	root	consumer	reason
RunProdServer	Main	service	fixture
EOF
cat >"$fixture_root/budget.json" <<EOF
{
  "schema_version": 1,
  "app_library": {
    "self_size_bytes_max": 1073741824,
    "module_count_max": 2,
    "default_interface_bytes_max": 16777216,
    "interface_exceptions": [
      { "path": "Application/Large.hi", "bytes_max": 33554432, "reason": "fixture compiler limitation" }
    ],
    "required_artifacts": {
      ".hi": { "count_max": 2 },
      ".a": { "count_max": 1 }
    },
    "forbidden_artifacts": [".dyn_hi", ".so"],
    "allowed_artifacts": [".hi", ".a"]
  },
  "production_inventory": {
    "module_rows_max": 2,
    "dependency_packages_max": 2,
    "executable_rows_max": 1,
    "module_inventory": "$fixture_root/modules.tsv",
    "dependency_inventory": "$fixture_root/dependencies.tsv",
    "executable_inventory": "$fixture_root/executables.tsv"
  },
  "measured_build": {
    "builder": "nas",
    "cores": 8,
    "builder_process_peak_rss_bytes_max": 8589934592
  }
}
EOF

profile() {
  local output="$1"
  local self_size="${2:-900000000}"
  local large_size="${3:-30000000}"
  local peak_rss="${4:-8000000000}"
  cat >"$output" <<EOF
{
  "schema_version": 1,
  "status": "succeeded",
  "builder": { "hostname": "nas" },
  "revision": { "commit": "fixture", "dirty": false },
  "configuration": { "effective_ghc_cores": 8, "shared": false, "static": true },
  "build": { "forced_clean": true, "cores": 8 },
  "memory": { "builder_process_peak_rss_bytes": $peak_rss },
  "app_library": {
    "module_count": 2,
    "self_size_bytes": $self_size,
    "artifacts": { ".hi": { "count": 2, "bytes": 31000000 }, ".a": { "count": 1, "bytes": 1000 } },
    "largest_interfaces": [
      { "path": "lib/pkg/Application/Large.hi", "bytes": $large_size, "kind": ".hi" },
      { "path": "lib/pkg/Application/Small.hi", "bytes": 1000000, "kind": ".hi" }
    ]
  }
}
EOF
}

profile "$fixture_root/pass.json"
node "$repo_root/scripts/production-build-budget.mjs" --budget "$fixture_root/budget.json" --profile "$fixture_root/pass.json"
node "$repo_root/scripts/production-build-budget.mjs" --budget "$fixture_root/budget.json" --profile "$fixture_root/pass.json" --enforce-measured-memory

expect_failure() {
  local expected="$1"
  shift
  if "$@" >"$fixture_root/failure.log" 2>&1; then
    echo "production-build-budget-test: expected failure containing: $expected" >&2
    exit 1
  fi
  grep -F "$expected" "$fixture_root/failure.log" >/dev/null || {
    cat "$fixture_root/failure.log" >&2
    echo "production-build-budget-test: missing diagnostic: $expected" >&2
    exit 1
  }
}

profile "$fixture_root/large-output.json" 1073741825
expect_failure 'app-library self size 1073741825 exceeds budget 1073741824' \
  node "$repo_root/scripts/production-build-budget.mjs" --budget "$fixture_root/budget.json" --profile "$fixture_root/large-output.json"

profile "$fixture_root/large-interface.json" 900000000 33554433
expect_failure 'Application/Large.hi is 33554433 bytes; exception budget is 33554432' \
  node "$repo_root/scripts/production-build-budget.mjs" --budget "$fixture_root/budget.json" --profile "$fixture_root/large-interface.json"

profile "$fixture_root/high-memory.json" 900000000 30000000 8589934593
expect_failure 'builder peak RSS 8589934593 exceeds measured-build budget 8589934592' \
  node "$repo_root/scripts/production-build-budget.mjs" --budget "$fixture_root/budget.json" --profile "$fixture_root/high-memory.json" --enforce-measured-memory

jq '.app_library.artifacts[".p_hi"] = {"count": 2, "bytes": 100}' "$fixture_root/pass.json" >"$fixture_root/unexpected-artifact.json"
expect_failure 'unexpected app-library artifact kind: .p_hi' \
  node "$repo_root/scripts/production-build-budget.mjs" --budget "$fixture_root/budget.json" --profile "$fixture_root/unexpected-artifact.json"

printf '%s\n' 'Other/Unexpected.hi' >"$fixture_root/unexpected-path"
sed 's#Application/Large.hi#Other/Unexpected.hi#' "$fixture_root/pass.json" >"$fixture_root/unexpected-interface.json"
expect_failure 'Other/Unexpected.hi is 30000000 bytes; default budget is 16777216' \
  node "$repo_root/scripts/production-build-budget.mjs" --budget "$fixture_root/budget.json" --profile "$fixture_root/unexpected-interface.json"

printf '%s\n' 'production-build-budget-test: ok'
