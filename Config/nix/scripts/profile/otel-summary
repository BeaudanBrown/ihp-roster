#!/usr/bin/env bash
set -euo pipefail

TEMPO_URL="${TEMPO_URL:-http://127.0.0.1:3200}"
SERVICE_NAME="${OTEL_SERVICE_NAME:-ihp-roster-dev}"
OUTPUT_DIR=""
ARGS=()

while [ "$#" -gt 0 ]; do
    case "$1" in
        --output-dir=*)
            OUTPUT_DIR="${1#--output-dir=}"
            ARGS+=("$1")
            shift
            ;;
        --output-dir)
            OUTPUT_DIR="$2"
            ARGS+=("$1" "$2")
            shift 2
            ;;
        *)
            ARGS+=("$1")
            shift
            ;;
    esac
done

if [ -z "$OUTPUT_DIR" ]; then
    OUTPUT_DIR="$PWD/output/otel-summary/$(date +%Y%m%d-%H%M%S)"
    ARGS+=("--output-dir" "$OUTPUT_DIR")
fi

node ./e2e/otel-trace-summary.mjs \
    --tempo-url "$TEMPO_URL" \
    --service "$SERVICE_NAME" \
    "${ARGS[@]}"

mkdir -p "$PWD/output/otel-summary"
ln -sfn "$OUTPUT_DIR" "$PWD/output/otel-summary/latest"
echo "OTel summary artifacts: $OUTPUT_DIR"
