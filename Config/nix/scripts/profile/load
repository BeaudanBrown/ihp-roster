#!/usr/bin/env bash
set -euo pipefail

export PROFILE_DB_SOCKET="${PROFILE_DB_SOCKET:-${PGHOST:-$PWD/build/db}}"
PROFILE_RUN_ID="${PROFILE_RUN_ID:-$(date +%s)-$$-$RANDOM}"
PROFILE_LOAD_OUTPUT_DIR="${PROFILE_LOAD_OUTPUT_DIR:-$PWD/output/profile-load/$PROFILE_RUN_ID}"
PROFILE_DATABASE_NAME="${PROFILE_DATABASE_NAME:-app_profile_load_$PROFILE_RUN_ID}"
PROFILE_SHOULD_SEED=1
PROFILE_SEED_ARGS=()
PROFILE_LOAD_SCENARIO="${PROFILE_LOAD_SCENARIO:-roster-hot}"
PROFILE_LOAD_RATE="${PROFILE_LOAD_RATE:-10}"
PROFILE_LOAD_DURATION="${PROFILE_LOAD_DURATION:-30s}"
PROFILE_LOAD_VUS="${PROFILE_LOAD_VUS:-10}"
PROFILE_LOAD_MAX_VUS="${PROFILE_LOAD_MAX_VUS:-}"
PROFILE_LOAD_OTEL="${PROFILE_LOAD_OTEL:-0}"
PROFILE_LOAD_PROFILING="${PROFILE_LOAD_PROFILING:-1}"
PROFILE_LOAD_OTEL_SAMPLER="${PROFILE_LOAD_OTEL_SAMPLER:-always_on}"
PROFILE_LOAD_OTEL_SAMPLER_ARG="${PROFILE_LOAD_OTEL_SAMPLER_ARG:-}"
PROFILE_LOAD_REQUIRE_OTEL_TRACES="${PROFILE_LOAD_REQUIRE_OTEL_TRACES:-1}"
PROFILE_LOAD_STARTUP_TIMEOUT_SECONDS="${PROFILE_LOAD_STARTUP_TIMEOUT_SECONDS:-300}"
PROFILE_K6_ARGS=()

while [ "$#" -gt 0 ]; do
    case "$1" in
        --help|-h)
            cat <<'EOF'
Usage: profile-load [options] [-- k6-args...]

Options:
  --seed                         Seed the profile database before running (default)
  --reuse-db                     Reuse the selected profile database
  --db=app_profile_*             Profile database name
  --output-dir=path              Artifact directory
  --seed-arg=arg                 Forward an option to seed-profile
  --scenario=name                roster-hot|roster-wide|roster-overview|roster-projections|fragments|timesheets|leave|admin|profile|staff|support|billing|auth|mixed-app
  --rate=N                       Target iterations per second (default: 10)
  --duration=30s                 k6 scenario duration (default: 30s)
  --vus=N                        Preallocated k6 virtual users (default: 10)
  --max-vus=N                    Maximum k6 virtual users
  --email=email                  Override manifest login email
  --password=password            Override manifest login password
  --otel                         Run local OTel collector and emit otel-summary artifacts
  --no-otel                      Disable local OTel collector (default)
  --profiling                    Enable diagnostic profiling (default)
  --no-profiling                 Disable diagnostic profiling for lightweight/runtime baselines
  --otel-sampler=name            OTEL_TRACES_SAMPLER for this run (default: always_on)
  --otel-sampler-arg=value       Optional OTEL_TRACES_SAMPLER_ARG for this run
  --startup-timeout=N            App startup timeout in seconds (default: 300)
EOF
            exit 0
            ;;
        --seed)
            PROFILE_SHOULD_SEED=1
            shift
            ;;
        --reuse-db)
            PROFILE_SHOULD_SEED=0
            shift
            ;;
        --db=*)
            PROFILE_DATABASE_NAME="${1#--db=}"
            shift
            ;;
        --output-dir=*)
            PROFILE_LOAD_OUTPUT_DIR="${1#--output-dir=}"
            shift
            ;;
        --seed-arg=*)
            PROFILE_SEED_ARGS+=("${1#--seed-arg=}")
            shift
            ;;
        --scenario=*)
            PROFILE_LOAD_SCENARIO="${1#--scenario=}"
            shift
            ;;
        --rate=*)
            PROFILE_LOAD_RATE="${1#--rate=}"
            shift
            ;;
        --duration=*)
            PROFILE_LOAD_DURATION="${1#--duration=}"
            shift
            ;;
        --vus=*)
            PROFILE_LOAD_VUS="${1#--vus=}"
            shift
            ;;
        --max-vus=*)
            PROFILE_LOAD_MAX_VUS="${1#--max-vus=}"
            shift
            ;;
        --email=*)
            export PROFILE_EMAIL="${1#--email=}"
            shift
            ;;
        --password=*)
            export PROFILE_PASSWORD="${1#--password=}"
            shift
            ;;
        --otel)
            PROFILE_LOAD_OTEL=1
            shift
            ;;
        --no-otel)
            PROFILE_LOAD_OTEL=0
            shift
            ;;
        --profiling)
            PROFILE_LOAD_PROFILING=1
            shift
            ;;
        --no-profiling)
            PROFILE_LOAD_PROFILING=0
            shift
            ;;
        --otel-sampler=*)
            PROFILE_LOAD_OTEL_SAMPLER="${1#--otel-sampler=}"
            shift
            ;;
        --otel-sampler-arg=*)
            PROFILE_LOAD_OTEL_SAMPLER_ARG="${1#--otel-sampler-arg=}"
            shift
            ;;
        --startup-timeout=*)
            PROFILE_LOAD_STARTUP_TIMEOUT_SECONDS="${1#--startup-timeout=}"
            shift
            ;;
        --)
            shift
            PROFILE_K6_ARGS+=("$@")
            break
            ;;
        *)
            PROFILE_K6_ARGS+=("$1")
            shift
            ;;
    esac
done

[[ "$PROFILE_LOAD_STARTUP_TIMEOUT_SECONDS" =~ ^[1-9][0-9]*$ ]] || {
    echo "Profile load startup timeout must be a positive integer" >&2
    exit 64
}

case "$PROFILE_DATABASE_NAME" in
    app_profile|app_profile_*)
        ;;
    *)
        echo "Unsupported profiling database target: $PROFILE_DATABASE_NAME" >&2
        echo "Use app_profile or an app_profile_* database name." >&2
        exit 1
        ;;
esac

case "$PROFILE_LOAD_SCENARIO" in
    roster-hot|roster-wide|roster-overview|roster-projections|fragments|timesheets|leave|admin|profile|staff|support|billing|auth|mixed-app)
        ;;
    *)
        echo "Unsupported load profiling scenario: $PROFILE_LOAD_SCENARIO" >&2
        echo "Use roster-hot, roster-wide, roster-overview, roster-projections, fragments, timesheets, leave, admin, profile, staff, support, billing, auth, or mixed-app." >&2
        exit 1
        ;;
esac

if ! psql -h "$PROFILE_DB_SOCKET" -d postgres -c "select 1" >/dev/null 2>&1; then
    echo "Load profiling requires the local postgres socket at $PROFILE_DB_SOCKET" >&2
    echo "Start the local environment first (e.g. dev-start or devenv up)." >&2
    exit 1
fi

PROFILE_LOAD_OUTPUT_DIR="$(realpath -m "$PROFILE_LOAD_OUTPUT_DIR")"
mkdir -p "$PROFILE_LOAD_OUTPUT_DIR"
PROFILE_SEED_OUTPUT_DIR="$PROFILE_LOAD_OUTPUT_DIR/seed"
PROFILE_LOG="$PROFILE_LOAD_OUTPUT_DIR/server.log"
PROFILE_PID_FILE="$PROFILE_LOAD_OUTPUT_DIR/server.pid"
: > "$PROFILE_LOG"
PROFILE_K6_METRICS="$PROFILE_LOAD_OUTPUT_DIR/k6-metrics.ndjson"
PROFILE_K6_STDOUT="$PROFILE_LOAD_OUTPUT_DIR/k6.stdout"
PROFILE_LOAD_METADATA="$PROFILE_LOAD_OUTPUT_DIR/metadata.json"
PROFILE_RUNTIME_SAMPLES="$PROFILE_LOAD_OUTPUT_DIR/runtime-resources.tsv"
PROFILE_RUNTIME_SUMMARY="$PROFILE_LOAD_OUTPUT_DIR/runtime-resources.json"
PROFILE_RUNTIME_SAMPLER_PID_FILE="$PROFILE_LOAD_OUTPUT_DIR/runtime-resources.pid"
PROFILE_OTEL_TRACE_FILE="$PROFILE_LOAD_OUTPUT_DIR/otel-traces.json"
PROFILE_OTEL_LOG="$PROFILE_LOAD_OUTPUT_DIR/otel-collector.log"
PROFILE_OTEL_PID_FILE="$PROFILE_LOAD_OUTPUT_DIR/otel-collector.pid"

if [ "$PROFILE_SHOULD_SEED" = "1" ]; then
    seed-profile "$PROFILE_DATABASE_NAME" --output-dir="$PROFILE_SEED_OUTPUT_DIR" "${PROFILE_SEED_ARGS[@]}"
elif [ ! -f "$PROFILE_SEED_OUTPUT_DIR/manifest.json" ] && [ -f "$PWD/build/profile-seed/latest/manifest.json" ]; then
    mkdir -p "$PROFILE_SEED_OUTPUT_DIR"
    cp "$PWD/build/profile-seed/latest/manifest.json" "$PROFILE_SEED_OUTPUT_DIR/manifest.json"
fi

if [ ! -f "$PROFILE_SEED_OUTPUT_DIR/manifest.json" ]; then
    echo "Missing profile seed manifest: $PROFILE_SEED_OUTPUT_DIR/manifest.json" >&2
    echo "Run with --seed, or provide PROFILE_LOAD_OUTPUT_DIR that already contains seed/manifest.json." >&2
    exit 1
fi

# shellcheck source=../lib/profile-server.sh
. "${BEPIS_SCRIPTS_ROOT:?}/lib/profile-server.sh"

cleanup_profile_load() {
    stop_profile_runtime_sampler "$PROFILE_RUNTIME_SAMPLER_PID_FILE"
    cleanup_profile_server
    if [ -f "$PROFILE_OTEL_PID_FILE" ]; then
        local otel_pid
        otel_pid=$(cat "$PROFILE_OTEL_PID_FILE")
        kill -TERM "$otel_pid" 2>/dev/null || true
        wait "$otel_pid" 2>/dev/null || true
        rm -f "$PROFILE_OTEL_PID_FILE"
    fi
}

trap cleanup_profile_load EXIT INT TERM

if [ "$PROFILE_LOAD_OTEL" = "1" ]; then
    if ! command -v otelcol-contrib >/dev/null 2>&1; then
        echo "profile-load --otel requires otelcol-contrib in the Nix shell" >&2
        echo "Run via: bash ./bin/in-env profile-load --otel ..." >&2
        exit 1
    fi
    mkdir -p "$(dirname "$PROFILE_OTEL_TRACE_FILE")"
    rm -f "$PROFILE_OTEL_TRACE_FILE"
    (
        export OTEL_FILE_EXPORTER_PATH="$PROFILE_OTEL_TRACE_FILE"
        exec otelcol-contrib --config ./Config/otel/profile-file-collector.yaml
    ) >>"$PROFILE_OTEL_LOG" 2>&1 &
    echo "$!" > "$PROFILE_OTEL_PID_FILE"
    sleep 1
    if ! kill -0 "$(cat "$PROFILE_OTEL_PID_FILE")" 2>/dev/null; then
        echo "OpenTelemetry collector failed to start" >&2
        cat "$PROFILE_OTEL_LOG" >&2 || true
        exit 1
    fi
fi

finalize_profile_otel() {
    if [ "$PROFILE_LOAD_OTEL" != "1" ]; then
        return 0
    fi
    sleep 1
    if [ -f "$PROFILE_OTEL_PID_FILE" ]; then
        local otel_pid
        otel_pid=$(cat "$PROFILE_OTEL_PID_FILE")
        kill -TERM "$otel_pid" 2>/dev/null || true
        wait "$otel_pid" 2>/dev/null || true
        rm -f "$PROFILE_OTEL_PID_FILE"
    fi
    if [ ! -s "$PROFILE_OTEL_TRACE_FILE" ]; then
        if [ "$PROFILE_LOAD_REQUIRE_OTEL_TRACES" = "0" ]; then
            echo "OpenTelemetry sampler produced no spans; continuing bounded sampled-mode benchmark."
            return 0
        fi
        echo "OpenTelemetry collector did not produce $PROFILE_OTEL_TRACE_FILE" >&2
        echo "Collector log: $PROFILE_OTEL_LOG" >&2
        return 1
    fi
    node ./e2e/otel-profile-summary.mjs \
        "$PROFILE_OTEL_TRACE_FILE" \
        "$PROFILE_LOAD_OUTPUT_DIR" \
        "$PROFILE_LOAD_OUTPUT_DIR/load-profile.json"
}

otel_env=()
if [ "$PROFILE_LOAD_OTEL" = "1" ]; then
    otel_env=(
        IHP_ROSTER_OTEL=1
        OTEL_SERVICE_NAME=ihp-roster-profile
        OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:24318
        OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:24318/v1/traces
        OTEL_TRACES_SAMPLER="$PROFILE_LOAD_OTEL_SAMPLER"
        IHP_ROSTER_OTEL_SHUTDOWN_TIMEOUT_MS=2000
        OTEL_BSP_MAX_QUEUE_SIZE=512
        OTEL_BSP_MAX_EXPORT_BATCH_SIZE=128
        OTEL_BSP_SCHEDULE_DELAY=200
        OTEL_BSP_EXPORT_TIMEOUT=1000
        OTEL_ATTRIBUTE_VALUE_LENGTH_LIMIT=256
        OTEL_ATTRIBUTE_COUNT_LIMIT=64
        OTEL_SPAN_ATTRIBUTE_VALUE_LENGTH_LIMIT=256
        OTEL_SPAN_ATTRIBUTE_COUNT_LIMIT=64
        OTEL_SPAN_EVENT_COUNT_LIMIT=64
        OTEL_SPAN_LINK_COUNT_LIMIT=16
    )
    if [ -n "$PROFILE_LOAD_OTEL_SAMPLER_ARG" ]; then
        otel_env+=(OTEL_TRACES_SAMPLER_ARG="$PROFILE_LOAD_OTEL_SAMPLER_ARG")
    fi
fi

(
    export PROFILE_DATABASE_NAME
    export PROFILE_DB_SOCKET
    if [ "$PROFILE_LOAD_PROFILING" = "1" ]; then
        export IHP_ROSTER_PROFILING=1
        export GHCRTS="${GHCRTS:+$GHCRTS }-T"
    else
        unset IHP_ROSTER_PROFILING
    fi
    if [ "${#otel_env[@]}" -gt 0 ]; then
        export "${otel_env[@]}"
    fi
    setsid profile-test-server </dev/null >>"$PROFILE_LOG" 2>&1 &
    echo "$!" > "$PROFILE_PID_FILE"
    wait "$!"
) &
PROFILE_WRAPPER_PID="$!"

PROFILE_SERVER_PID=""
for _ in $(seq 1 "$PROFILE_LOAD_STARTUP_TIMEOUT_SECONDS"); do
    if [ -f "$PROFILE_PID_FILE" ]; then
        PROFILE_SERVER_PID="$(cat "$PROFILE_PID_FILE")"
    fi
    if [ -n "$PROFILE_SERVER_PID" ] && PROFILE_BASE_URL=$(detect_profile_base_url "$PROFILE_SERVER_PID"); then
        export PROFILE_BASE_URL
        export PROFILE_MANIFEST="$PROFILE_SEED_OUTPUT_DIR/manifest.json"
        export PROFILE_LOAD_SCENARIO
        export PROFILE_LOAD_RATE
        export PROFILE_LOAD_DURATION
        export PROFILE_LOAD_VUS
        if [ -n "$PROFILE_LOAD_MAX_VUS" ]; then
            export PROFILE_LOAD_MAX_VUS
        fi

        jq -n \
            --arg runId "$PROFILE_RUN_ID" \
            --arg scenario "$PROFILE_LOAD_SCENARIO" \
            --arg rate "$PROFILE_LOAD_RATE" \
            --arg duration "$PROFILE_LOAD_DURATION" \
            --arg vus "$PROFILE_LOAD_VUS" \
            --arg maxVus "${PROFILE_LOAD_MAX_VUS:-}" \
            --arg database "$PROFILE_DATABASE_NAME" \
            --arg baseUrl "$PROFILE_BASE_URL" \
            --arg otel "$PROFILE_LOAD_OTEL" \
            --arg profiling "$PROFILE_LOAD_PROFILING" \
            --arg otelSampler "$PROFILE_LOAD_OTEL_SAMPLER" \
            --arg otelSamplerArg "$PROFILE_LOAD_OTEL_SAMPLER_ARG" \
            --slurpfile manifest "$PROFILE_SEED_OUTPUT_DIR/manifest.json" \
            '{runId:$runId, scenario:$scenario, rate:$rate, duration:$duration, vus:$vus, maxVus:$maxVus, database:$database, baseUrl:$baseUrl, telemetry:{otel:($otel == "1"), profiling:($profiling == "1"), sampler:$otelSampler, samplerArg:$otelSamplerArg}, seed:$manifest[0].options}' \
            > "$PROFILE_LOAD_METADATA"

        echo "Profile load server ready at $PROFILE_BASE_URL"
        echo "Profile load database: $PROFILE_DATABASE_NAME"
        echo "Profile load scenario: $PROFILE_LOAD_SCENARIO rate=$PROFILE_LOAD_RATE duration=$PROFILE_LOAD_DURATION vus=$PROFILE_LOAD_VUS"

        sample_profile_runtime_resources "$PROFILE_SERVER_PID" "$PROFILE_RUNTIME_SAMPLES" "$PROFILE_LOAD_PROFILING" "$PROFILE_DB_SOCKET" "$PROFILE_DATABASE_NAME" &
        echo "$!" > "$PROFILE_RUNTIME_SAMPLER_PID_FILE"

        k6 run \
            --out "json=$PROFILE_K6_METRICS" \
            "${PROFILE_K6_ARGS[@]}" \
            ./e2e/profile-load.js \
            | tee "$PROFILE_K6_STDOUT"

        stop_profile_runtime_sampler "$PROFILE_RUNTIME_SAMPLER_PID_FILE"
        finalize_profile_runtime_resources "$PROFILE_RUNTIME_SAMPLES" "$PROFILE_RUNTIME_SUMMARY"

        node ./e2e/profile-load-report.mjs \
            "$PROFILE_K6_METRICS" \
            "$PROFILE_LOAD_OUTPUT_DIR" \
            "$PROFILE_LOAD_METADATA"
        finalize_profile_otel
        if [ "$PROFILE_LOAD_PROFILING" = "1" ]; then
            node ./e2e/diagnostic-profile-report.mjs \
                "$PROFILE_LOAD_OUTPUT_DIR" \
                "${HASQL_POOL_SIZE:-20}"
        fi
        mkdir -p "$PWD/output/profile-load"
        ln -sfn "$PROFILE_LOAD_OUTPUT_DIR" "$PWD/output/profile-load/latest"
        echo "Profile load artifacts: $PROFILE_LOAD_OUTPUT_DIR"
        exit 0
    fi

    if [ -n "$PROFILE_SERVER_PID" ] && ! kill -0 "$PROFILE_SERVER_PID" 2>/dev/null; then
        echo "Profile load app server failed to start" >&2
        tail -n 120 "$PROFILE_LOG" >&2 || true
        exit 1
    fi

    sleep 1
done

echo "Timed out waiting for profile load app server" >&2
tail -n 120 "$PROFILE_LOG" >&2 || true
kill "$PROFILE_WRAPPER_PID" 2>/dev/null || true
exit 1
