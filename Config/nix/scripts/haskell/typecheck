#!/usr/bin/env bash
set -euo pipefail
# shellcheck source=../lib/ghc.sh
. "${BEPIS_SCRIPTS_ROOT:?}/lib/ghc.sh"
ihp_roster_configure_compiler_tmpdir
bash "${BEPIS_SCRIPTS_ROOT:?}/haskell/generated-ensure"
TARGET="${1:-Main.hs}"
GHC_OPTS="$(ihp_roster_ghc_opts) -iTest"
TYPECHECK_DIR="${TYPECHECK_BUILD_DIR:-$(ihp_roster_verification_build_dir)}"
# Development compilation sees the unfiltered working tree, while production
# compiles only inventoried modules. Keep the production closure fresh whenever
# the canonical Main target is checked so a new reachable module cannot pass
# locally and disappear from the Nix production source.
TARGETS=("$TARGET")
if [ "$TARGET" = "Main.hs" ]; then
    node scripts/production-inventory.mjs --check
    TARGETS+=(WorkerMain.hs)
fi
bash "${BEPIS_SCRIPTS_ROOT:?}/haskell/module-name-check"
ihp_roster_prepare_ghc_build_dir "$TYPECHECK_DIR" "$GHC_OPTS"
exec ghc -no-link $GHC_OPTS "${TARGETS[@]}" \
    -odir "$TYPECHECK_DIR/obj" \
    -hidir "$TYPECHECK_DIR/hi"
