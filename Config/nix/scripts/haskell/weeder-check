#!/usr/bin/env bash
set -euo pipefail
# shellcheck source=../lib/ghc.sh
. "@scriptsRoot@/lib/ghc.sh"
bash "@scriptsRoot@/haskell/generated-ensure"

weeder_build_dir="${WEEDER_BUILD_DIR:-$(ihp_roster_verification_build_dir)/weeder}"
hie_dir="${WEEDER_HIE_DIR:-$weeder_build_dir/hie}"
ghc_opts="$(ihp_roster_ghc_opts) -iTest -fwrite-ide-info -fwrite-interface"

# Keep a dedicated incremental graph: changed modules refresh through GHC's
# recompilation checker, while this sweep removes HIE files for deleted modules.
# Compile the complete app/test/script source inventory, not only one main's
# transitive closure. Compile-failure fixtures are intentionally invalid and
# have their own complete gate. Root-level Setup.hs is Cabal's packaging
# bootstrap (an implicit Main module), not an application runtime module; adding
# it here would collide with the real Main.hs HIE identity.
ihp_roster_prepare_ghc_build_dir "$weeder_build_dir" "$ghc_opts"
mkdir -p "$hie_dir"
source_inventory="$weeder_build_dir/weeder-sources.txt"
{
    printf '%s\n' Main.hs
    find Application Web Test Config build/Generated \
        -type f -name '*.hs' \
        ! -path 'Test/CompileFail/*' \
        -print \
        | LC_ALL=C sort
} > "$source_inventory"
mapfile -t source_files < "$source_inventory"
for required_source in \
    Main.hs \
    Web/FrontController.hs \
    Test/HspecMain.hs \
    Application/Script/SeedProfile.hs \
    Application/Script/XeroPayItemProbe.hs \
    build/Generated/Statements/FetchAppJob.hs
do
    grep -Fxq "$required_source" "$source_inventory" || {
        echo "weeder-check: complete source inventory is missing $required_source" >&2
        exit 1
    }
done
if grep -Fq 'Test/CompileFail/' "$source_inventory"; then
    echo "weeder-check: intentionally invalid compile-failure fixture entered the source inventory" >&2
    exit 1
fi

declare -A current_modules=()
while IFS= read -r module_name; do
    [ -z "$module_name" ] || current_modules["$module_name"]=1
done < <(
    # shellcheck disable=SC2016 # This is an awk program, not shell interpolation.
    xargs -r awk '/^module [A-Z]/ { print $2; nextfile }' < "$source_inventory"
)
while IFS= read -r -d '' hie_file; do
    module_name="${hie_file#"$hie_dir"/}"
    module_name="${module_name%.hie}"
    module_name="${module_name//\//.}"
    if [ -z "${current_modules[$module_name]:-}" ]; then
        rm -f "$hie_file"
    fi
done < <(find "$hie_dir" -type f -name '*.hie' -print0)
# shellcheck disable=SC2086 # ghc_opts is an intentional argument vector.
ghc -fno-code $ghc_opts "${source_files[@]}" \
    -hidir "$weeder_build_dir/hi" \
    -hiedir "$hie_dir"

output_file="$weeder_build_dir/weeder-output.txt"
set +e
weeder \
    --config weeder.toml \
    --hie-directory "$hie_dir" \
    --require-hs-files \
    >"$output_file" 2>&1
status=$?
set -e

if [[ "$status" -ne 0 && "$status" -ne 228 ]]; then
    cat "$output_file" >&2
    exit "$status"
fi

if [[ "${WEEDER_PRINT_CANDIDATES:-0}" == "1" ]]; then
    grep '^main: ' "$output_file" || true
fi

"@scriptsRoot@/haskell/weeder-policy" \
    "$output_file" \
    "Config/nix/weeder-baseline.tsv"
echo "weeder-check: ok (fresh HIE graph; evidence: $output_file)"
