#!/usr/bin/env bash
set -euo pipefail
# shellcheck source=../lib/ghc.sh
. "@scriptsRoot@/lib/ghc.sh"

weeder_build_dir="${WEEDER_BUILD_DIR:-$(ihp_roster_verification_build_dir)/weeder}"
hie_dir="${WEEDER_HIE_DIR:-$weeder_build_dir/hie}"
ghc_opts="$(ihp_roster_ghc_opts) -iTest -fwrite-ide-info -fwrite-interface"

# Keep a dedicated incremental graph: changed modules refresh through GHC's
# recompilation checker, while this sweep removes HIE files for deleted modules.
# This preserves reachability authority without rebuilding ~1,100 modules on
# every agent iteration.
ihp_roster_prepare_ghc_build_dir "$weeder_build_dir" "$ghc_opts"
mkdir -p "$hie_dir"
declare -A current_modules=()
while IFS= read -r module_name; do
    [ -z "$module_name" ] || current_modules["$module_name"]=1
done < <(
    find Application Web Test Config build/Generated -type f -name '*.hs' -print0 \
        | xargs -0 -r awk '/^module [A-Z]/ { print $2; nextfile }'
    awk '/^module [A-Z]/ { print $2; exit }' Main.hs
)
while IFS= read -r -d '' hie_file; do
    module_name="${hie_file#"$hie_dir"/}"
    module_name="${module_name%.hie}"
    module_name="${module_name//\//.}"
    if [ -z "${current_modules[$module_name]:-}" ]; then
        rm -f "$hie_file"
    fi
done < <(find "$hie_dir" -type f -name '*.hie' -print0)
# shellcheck disable=SC2086 # ghc_opts is an intentional argument vector.
ghc -fno-code $ghc_opts -main-is Test.HspecMain Test/HspecMain.hs \
    -hidir "$weeder_build_dir/hi" \
    -hiedir "$hie_dir"

set +e
output="$(weeder \
    --config weeder.toml \
    --hie-directory "$hie_dir" \
    --require-hs-files \
    -N 2>&1)"
status=$?
set -e

if [[ "$status" -ne 0 && "$status" -ne 228 ]]; then
    printf '%s\n' "$output" >&2
    exit "$status"
fi

# IHP controllers, views, scripts, and shared helpers expose framework/test entry
# points that are intentionally broader than Main's static call graph. The
# closeout gate is deliberately scoped to the deep FrontendContract module,
# whose public runtime interface should contain no unreachable value helpers.
curated="$(printf '%s\n' "$output" | grep '^main: \./Application/Helper/FrontendContract/' || true)"
if [[ -n "$curated" ]]; then
    echo "weeder-check: unreachable FrontendContract declarations" >&2
    printf '%s\n' "$curated" >&2
    exit 1
fi

ignored_count="$(printf '%s\n' "$output" | grep -c '^main: \./' || true)"
if [[ "${WEEDER_PRINT_CANDIDATES:-0}" == "1" ]]; then
    printf '%s\n' "$output" | grep '^main: \./' || true
fi
echo "weeder-check: ok (FrontendContract clean; $ignored_count framework/application candidates outside the curated gate)"
