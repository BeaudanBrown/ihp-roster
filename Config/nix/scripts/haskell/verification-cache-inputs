#!/usr/bin/env bash
set -euo pipefail
printf 'path\t%s\n' App.cabal flake.lock Makefile Config/nix/scripts/lib/ghc.sh Config/nix/scripts/haskell/verification-cache-inputs
# Include the ignored generated schema modules and Config imports as well as
# authored/untracked application dependencies. This is dependency invalidation,
# never evidence that the newly generated subjects or private proofs passed.
for root in Application Web Config build/Generated; do
    [ -d "$root" ] || continue
    find "$root" -type f \( -name '*.hs' -o -name '*.sql' \) -print
done | LC_ALL=C sort -u | while IFS= read -r path; do printf 'path\t%s\n' "$path"; done
printf 'value\tghc-version\t%s\n' "$(ghc --numeric-version)"
compiler="$(realpath "$(command -v ghc)")"
printf 'value\tghc-executable\t%s\n' "$compiler"
printf 'value\tghc-executable-bytes\t%s\n' "$(sha256sum "$compiler" | cut -d ' ' -f 1)"
printf 'value\tghc-info\t%s\n' "$(ghc --info | sha256sum | cut -d ' ' -f 1)"
printf 'value\tghc-package-state\t%s\n' "$(ghc-pkg dump | sha256sum | cut -d ' ' -f 1)"
