#!/usr/bin/env bash
set -euo pipefail
# shellcheck source=../lib/ghc.sh
. "@scriptsRoot@/lib/ghc.sh"

build_dir="${FRONTEND_CONTRACT_WARNINGS_BUILD_DIR:-$(ihp_roster_verification_build_dir)/frontend-contract-warnings}"
ghc_opts="$(ihp_roster_ghc_opts) -Werror=unused-imports -Werror=unused-local-binds -Werror=unused-matches -Werror=incomplete-patterns -Werror=missing-methods -fwrite-interface"

# Compile the complete reflected contract registry with its own warning-policy
# cache. GHC refreshes changed dependencies; persistent interfaces avoid paying
# for the unchanged contract graph on every agent iteration.
# Deliberately omit unused-top-binds: closed DSL marker types are consumed at the
# type level and are reported as unused value declarations by that warning.
ihp_roster_prepare_ghc_build_dir "$build_dir" "$ghc_opts"
# shellcheck disable=SC2086 # ghc_opts is an intentional argument vector.
ghc -fno-code $ghc_opts Application/Helper/FrontendContract/Contracts.hs \
    -odir "$build_dir/obj" \
    -hidir "$build_dir/hi"

echo "frontend-contract-warnings: ok"
