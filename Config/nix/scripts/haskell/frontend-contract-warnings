#!/usr/bin/env bash
set -euo pipefail
# shellcheck source=../lib/ghc.sh
. "@scriptsRoot@/lib/ghc.sh"

build_dir="${FRONTEND_CONTRACT_WARNINGS_BUILD_DIR:-$(ihp_roster_verification_build_dir)/frontend-contract-warnings}"
base_ghc_opts="$(ihp_roster_ghc_opts)"
warning_ghc_opts="$base_ghc_opts -Werror=unused-imports -Werror=unused-local-binds -Werror=unused-matches -Werror=incomplete-patterns -Werror=missing-methods"
root="Application/Helper/FrontendContract/Contracts.hs"

# Discover and precompile the complete reflected graph first. Generated IHP
# modules are dependencies rather than app-owned warning authorities; their
# generated source currently contains warnings that application code cannot fix.
# The second invocation compiles only the reachable app-owned FrontendContract
# sources against those interfaces with the curated warnings as errors.
# Deliberately omit unused-top-binds: closed DSL marker types are consumed at the
# type level and are reported as unused value declarations by that warning.
ihp_roster_prepare_ghc_build_dir "$build_dir" "$base_ghc_opts | $warning_ghc_opts | -fwrite-interface"
dependencies="$build_dir/dependencies.mk"
ghc $base_ghc_opts -M "$root" -dep-makefile "$dependencies"
mapfile -t app_sources < <(
    grep -o 'Application/Helper/FrontendContract/[^[:space:]\\]*\.hs' "$dependencies" \
        | sort -u
)
if ((${#app_sources[@]} == 0)); then
    echo "frontend-contract-warnings: no app-owned FrontendContract sources discovered" >&2
    exit 1
fi

# shellcheck disable=SC2086 # GHC option strings are intentional argument vectors.
ghc -fno-code -fwrite-interface $base_ghc_opts "$root" \
    -odir "$build_dir/obj" \
    -hidir "$build_dir/hi"
# shellcheck disable=SC2086 # GHC option strings are intentional argument vectors.
ghc -fno-code -c $warning_ghc_opts -i"$build_dir/hi" "${app_sources[@]}" \
    -odir "$build_dir/obj" \
    -hidir "$build_dir/hi"

echo "frontend-contract-warnings: ok (${#app_sources[@]} app-owned modules)"
