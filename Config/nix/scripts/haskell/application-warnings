#!/usr/bin/env bash
set -euo pipefail
# shellcheck source=../lib/ghc.sh
. "${BEPIS_SCRIPTS_ROOT:?}/lib/ghc.sh"

build_dir="${APPLICATION_WARNINGS_BUILD_DIR:-$(ihp_roster_verification_build_dir)/application-warnings}"
base_ghc_opts="$(ihp_roster_ghc_opts)"
# IHP routes and wire sums require constructor-local record labels. Reject
# partial accesses (including getField/record-dot), not those declarations.
warning_ghc_opts="-w -Wincomplete-patterns -Wincomplete-uni-patterns -Wincomplete-record-updates -Wincomplete-record-selectors -Wunused-imports"

production_text="$(awk -F '\t' 'NR > 1 && $2 == "production" && $1 ~ /\.hs$/ { print $1 }' Config/nix/production-module-inventory.tsv)"
mapfile -t production_sources <<< "$production_text"
app_text="$(printf '%s\n' "${production_sources[@]}" \
    | awk 'NF && $0 !~ /(^|\/)Generated(\/|\.|$)/' | sort -u)"
if [[ -z "$app_text" ]]; then
    echo "application-warnings: no app-owned production sources discovered" >&2
    exit 1
fi
mapfile -t app_sources <<< "$app_text"

ihp_roster_prepare_ghc_build_dir "$build_dir" "$base_ghc_opts | $warning_ghc_opts | structured-owned-pass-v1"
# One forced --make graph emits fresh warnings even with warm interfaces, without
# the duplicate-instance hazard of multi-file -c. Ownership filters diagnostics,
# not compiler dependencies: generated warnings never gain application authority.
diagnostics="$build_dir/diagnostics.jsonl"
# shellcheck disable=SC2086 # GHC option strings are intentional argument vectors.
# -ddump-json uses GHC's synchronized logger; 9.10's -fdiagnostics-as-json
# interleaves bytes when -j compiles independent modules concurrently.
if ! ghc -v0 -fno-code -fforce-recomp -ddump-json $base_ghc_opts $warning_ghc_opts \
    "${production_sources[@]}" -odir "$build_dir/obj" -hidir "$build_dir/hi" >"$diagnostics"; then
    cat "$diagnostics" >&2
    exit 1
fi
owned="$(printf '%s\n' "${app_sources[@]}" | jq -R . | jq -s .)"
warnings="$(jq -rs --argjson owned "$owned" '
    .[] | if (.messageClass | type) != "string" or (.doc | type) != "string" then error("unsupported GHC diagnostic") else . end
    | select(.messageClass | startswith("MCDiagnostic SevWarning"))
    | select(.span.file as $file | $owned | index($file))
    | "\(.span.file):\(.span.startLine):\(.span.startCol): \(.messageClass)\n\(.doc)"
' "$diagnostics")"
if [ -n "$warnings" ]; then
    printf '%s\n' "$warnings" >&2
    exit 1
fi

echo "application-warnings: ok (${#app_sources[@]} app-owned production modules)"
