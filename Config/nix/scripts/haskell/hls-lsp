#!/usr/bin/env bash
set -euo pipefail
umask 077
workspace="$(git rev-parse --show-toplevel 2>/dev/null)" || {
    echo "hls-lsp: cannot resolve Git worktree" >&2
    exit 66
}
workspace="$(realpath "$workspace")"
cache_parent="${BEPIS_HLS_CACHE_PARENT:-/var/tmp/bepis-hls-$(id -u)}"
repo_root="${BEPIS_REPO_ROOT:-$workspace}"
tooling_launcher="${BEPIS_TOOLING_LAUNCHER:-$repo_root/bin/tooling-run}"
server_command="${BEPIS_HLS_SERVER_COMMAND:-haskell-language-server-wrapper}"
command -v "$server_command" >/dev/null 2>&1 || {
    echo "hls-lsp: HLS command is unavailable: $server_command" >&2
    exit 69
}
exec "$tooling_launcher" artifacts cache exec --workspace "$workspace" --parent "$cache_parent" -- \
    "$server_command" "$@"
