#!/usr/bin/env bash
# Generated PostgreSQL enums stay nominal through application decisions.
# Rendering with inputValue remains valid at persistence, telemetry, HTML, and
# external wire seams; this gate rejects only rendered literals and rendered
# values used as branch inputs for the migrated domains.
set -euo pipefail

repo_root="${ENUM_AUTHORITY_REPO_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
cd "$repo_root"

failures=0
reject() {
    local reason="$1"
    local pattern="$2"
    shift 2
    local matches
    matches="$(mktemp)"
    local -a paths=("${@:-Application}" )
    if (( $# == 0 )); then
        paths=(Application Web)
    fi
    if rg --line-number --glob '*.hs' --glob '!**/Generated/**' "$pattern" "${paths[@]}" >"$matches" 2>/dev/null; then
        echo "enum-authority-check: $reason" >&2
        cat "$matches" >&2
        failures=$((failures + 1))
    fi
    rm -f "$matches"
}

# These schema wire literals are forbidden only in branch-shaped expressions;
# static HTML/wire rendering remains valid.
reject \
    "a roster-layout or app-job wire literal is used as a branch result" \
    '"(day_rows|day_columns|job_status_(not_started|running|retry|succeeded|failed|timed_out))"[[:space:]]*(->|==|/=|`elem`)'
reject \
    "a roster-layout or app-job decision compares against a wire literal" \
    '(==|/=|`elem`)[^\n]*"(day_rows|day_columns|job_status_(not_started|running|retry|succeeded|failed|timed_out))"'

# Invitation literals are not globally unique, so constrain their guard to
# branch-shaped expressions over status values. Boundary-only inputValue calls
# (JSON, HTML, telemetry, persistence) do not match.
reject \
    "a rendered generated status is used in a semantic comparison" \
    'inputValue[^\n]*(\.status|[[:space:]]+status)[^\n]*(==|/=|`elem`)'
reject \
    "a semantic case branches on a rendered generated status" \
    'case[[:space:]]+inputValue[[:space:]]+[^[:space:]]*(status|Status)[[:space:]]+of'
reject \
    "a semantic decision branches on rendered roster-layout text" \
    'rosterLayoutModeValue[^\n]*(==|/=|`elem`|[[:space:]]+of)'
reject \
    "a semantic decision branches on rendered roster-template scale text" \
    '(rosterTemplateScaleValue|inputValue[^\n]*\.scale)[^\n]*(==|/=|`elem`|[[:space:]]+of)'
reject \
    "a venue-role or employment-basis decision branches on rendered enum text" \
    '(case[[:space:]]+)?inputValue[^\n]*(role|Role|basis|Basis)[^\n]*(==|/=|`elem`|[[:space:]]+of)'
reject \
    "a feedback-type or shift-colour decision branches on rendered enum text" \
    '(case[[:space:]]+)?inputValue[^\n]*(feedbackType|FeedbackType|colourKey|ColourKey)[^\n]*(==|/=|`elem`|[[:space:]]+of)'

# #334 tombstones only the migrated app-owned Xero fields. Provider-owned
# employee/account/pay-run/timesheet statuses deliberately remain open Text.
reject \
    "a migrated Xero workflow field uses a raw text literal" \
    '(set[[:space:]]+#(syncStatus|syncKind|mappingStatus|selectionStatus|requirementStatus|decisionKind|decisionStatus)|filterWhere(In)?[^\n]*#(syncStatus|syncKind|mappingStatus|selectionStatus|requirementStatus|decisionKind|decisionStatus)|\.(syncStatus|syncKind|mappingStatus|selectionStatus|requirementStatus|decisionKind|decisionStatus)[[:space:]]*(==|/=|`elem`))[^\n]*"(running|succeeded|failed|payroll_reference_data|verified|not_applicable|stale|unmapped|none|proposed|matched|created|ignored|rate_changed|pending|applied|blocked|resolved|dismissed|staff_auto_match|staff_manual_mapping|staff_not_paid|staff_step_approved|pay_item_create|account_code|calendar_selection)"' \
    Application/Xero Application/Helper/XeroAdminTypes.hs Application/Helper/XeroPayItems.hs Application/Helper/XeroTimesheetReadiness.hs Web/View/Admin/Xero Web/Controller/Admin/Xero
reject \
    "a migrated Xero preparation or submission status write uses raw text" \
    'set[[:space:]]+#status[^\n]*"(started|preparing|needs_reconnect|needs_approval|blocked|resolved|ready_for_preview|previewed|pending|submitted|partially_failed|failed|cancelled|superseded|skipped)"' \
    Application/Xero/Timesheets Web/Controller/Admin/Xero

if (( failures > 0 )); then
    echo "enum-authority-check: ${failures} authority violation(s)" >&2
    exit 1
fi

echo "enum-authority-check: typed enum decisions clean"
