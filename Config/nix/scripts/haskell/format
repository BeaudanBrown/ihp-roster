#!/usr/bin/env bash
set -euo pipefail
if [ $# -gt 0 ]; then
    exec stylish-haskell -i "$@"
fi
find . -name '*.hs' \
    -not -path './IHP/*' \
    -not -path './build/*' \
    -not -path './.devenv/*' \
    -not -path './.direnv/*' \
    -print0 \
    | xargs -0 -r -n 100 -P "${FORMAT_JOBS:-4}" stylish-haskell -i
echo "Formatted all app sources."
