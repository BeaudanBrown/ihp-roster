#!/usr/bin/env bash
set -euo pipefail
umask 077

program="hls-cache"
scripts_root="${BEPIS_SCRIPTS_ROOT:?}"
. "$scripts_root/lib/hls-cache.sh"
usage() {
    cat <<'EOF'
Usage:
  hls-cache status [--json]
  hls-cache clear [--registered-path PATH] [--apply] [--json]
  hls-cache stale --all [--apply] [--json]
  hls-cache legacy [--apply] [--json]
EOF
}
die() { local status="$1"; shift; echo "$program: $*" >&2; exit "$status"; }
command_name="${1:-}"
case "$command_name" in status|clear|stale|legacy) shift ;; help|-h|--help) usage; exit 0 ;; *) usage >&2; exit 64 ;; esac
apply=false; json=false; all=false; registered_path=""
while [ "$#" -gt 0 ]; do
    case "$1" in
        --apply) apply=true; shift ;;
        --json) json=true; shift ;;
        --all) all=true; shift ;;
        --registered-path) [ "$#" -ge 2 ] || die 64 "missing value for --registered-path"; registered_path="$2"; shift 2 ;;
        -h|--help) usage; exit 0 ;;
        *) die 64 "unknown option: $1" ;;
    esac
done
[ "$command_name" = stale ] || [ "$all" = false ] || die 64 "--all is valid only with stale"
[ "$command_name" != stale ] || [ "$all" = true ] || die 64 "stale requires --all"
[ -z "$registered_path" ] || [ "$command_name" = clear ] || die 64 "--registered-path is valid only with clear"
[ "$command_name" != status ] || [ "$apply" = false ] || die 64 "--apply is not valid with status"
workspace="${registered_path:-${BEPIS_HLS_CACHE_REPO_ROOT:-}}"
if [ "$command_name" != stale ] && [ "$command_name" != legacy ] && [ -z "$workspace" ]; then
    workspace="$(git rev-parse --show-toplevel 2>/dev/null)" || die 66 "cannot resolve Git worktree"
    workspace="$(realpath "$workspace")"
fi
cache_parent="${BEPIS_HLS_CACHE_PARENT:-/var/tmp/bepis-hls-$(id -u)}"
repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
tooling_launcher="${BEPIS_TOOLING_LAUNCHER:-$repo_root/bin/tooling-run}"
if [ "$command_name" = legacy ]; then
    legacy_root="${BEPIS_HLS_LEGACY_ROOT:-${XDG_CACHE_HOME:-/tmp/nix-cache}/ghcide}"
    [ "$legacy_root" != / ] && [ "${legacy_root##*/}" = ghcide ] \
        || die 65 "legacy cache root must name a ghcide directory"
    [ "$(realpath -m "$legacy_root")" = "$legacy_root" ] \
        || die 65 "legacy cache root must be canonical and must not traverse symlinks: $legacy_root"
    legacy_state="absent"
    legacy_bytes=0
    if [ -e "$legacy_root" ] || [ -L "$legacy_root" ]; then
        bepis_hls_cache_validate_owned_directory "$legacy_root" "legacy cache root"
        legacy_state="present"
        legacy_bytes="$(bepis_hls_cache_bytes "$legacy_root")"
    fi

    legacy_processes='[]'
    legacy_clients='[]'
    for proc in /proc/[0-9]*; do
        pid="${proc##*/}"
        [ -r "$proc/status" ] || continue
        [ "$(awk '/^Uid:/ {print $2; exit}' "$proc/status" 2>/dev/null)" = "$(id -u)" ] || continue
        process_command="$(head -c 8192 "$proc/cmdline" 2>/dev/null | tr '\0' ' ' || true)"
        process_executable="$(readlink "$proc/exe" 2>/dev/null || true)"
        process_cache=""
        process_protocol=""
        process_cwd="$(readlink "$proc/cwd" 2>/dev/null || true)"
        is_hls=false
        is_pi=false
        references_legacy=false
        if [[ "$process_command" == *haskell-language-server* ]] \
            || [[ "$process_executable" == *haskell-language-server* ]]; then
            is_hls=true
        fi
        first_command="${process_command%% *}"
        if { [ "${first_command##*/}" = pi ] || [[ "$process_command" == "pi "* ]]; } \
            && [ -f "$process_cwd/Config/nix/flake/scripts.nix" ]; then
            is_pi=true
        fi
        for fd in "$proc"/fd/*; do
            target="$(readlink "$fd" 2>/dev/null || true)"
            if [[ "$target" == *.hiedb || "$target" == *.hiedb-wal || "$target" == *.hiedb-shm ]]; then
                is_hls=true
            fi
            if [ "$target" = "$legacy_root" ] || [[ "$target" == "$legacy_root/"* ]]; then
                references_legacy=true
            fi
        done
        if [ "$is_hls" = true ] || [ "$is_pi" = true ]; then
            process_environment="$({ tr '\0' '\n' <"$proc/environ"; } 2>/dev/null || true)"
            process_cache="$(awk -F= '$1 == "XDG_CACHE_HOME" {sub(/^[^=]*=/, ""); print; exit}' <<<"$process_environment")"
            process_protocol="$(awk -F= '$1 == "BEPIS_HLS_CACHE_PROTOCOL" {sub(/^[^=]*=/, ""); print; exit}' <<<"$process_environment")"
            if [ "$is_hls" = true ] && [ -n "$process_cache" ] \
                && [ "$(realpath -m "$process_cache/ghcide")" = "$legacy_root" ]; then
                references_legacy=true
            fi
            if [ "$is_pi" = true ] && [ "$process_protocol" != worktree-v1 ] \
                && [ -n "$process_cache" ] \
                && [ "$(realpath -m "$process_cache/ghcide")" = "$legacy_root" ]; then
                legacy_clients="$(jq -c --argjson pid "$pid" --arg command "$process_command" \
                    --arg cwd "$process_cwd" '. + [{pid: $pid, command: $command, cwd: $cwd}]' <<<"$legacy_clients")"
            fi
        fi
        [ "$references_legacy" = true ] || continue
        legacy_processes="$(jq -c --argjson pid "$pid" --arg command "$process_command" \
            --arg executable "$process_executable" \
            '. + [{pid: $pid, command: $command, executable: $executable}]' <<<"$legacy_processes")"
    done

    if [ "$apply" = true ] \
        && { [ "$(jq 'length' <<<"$legacy_processes")" -gt 0 ] \
            || [ "$(jq 'length' <<<"$legacy_clients")" -gt 0 ]; }; then
        die 75 "legacy cache still has old clients: HLS=$(jq -r '[.[].pid | tostring] | join(",")' <<<"$legacy_processes") Pi=$(jq -r '[.[].pid | tostring] | join(",")' <<<"$legacy_clients")"
    fi
    if [ "$apply" = true ] && [ "$legacy_state" = present ]; then
        rm -rf --one-file-system "$legacy_root"
    fi
    result="$(jq -cn \
        --arg state "$legacy_state" --arg root "$legacy_root" \
        --argjson bytes "$legacy_bytes" --argjson processes "$legacy_processes" \
        --argjson clients "$legacy_clients" --argjson applied "$apply" \
        '{action: "legacy", applied: ($applied and $state == "present"), state: $state,
          root: $root, bytes: $bytes, processes: $processes, oldPiClients: $clients}')"
    if [ "$json" = true ]; then
        jq . <<<"$result"
    elif [ "$apply" = true ]; then
        jq -r 'if .state == "present" then "cleared legacy cache (\(.bytes) bytes): \(.root)" else "legacy cache absent: \(.root)" end' <<<"$result"
    else
        jq -r 'if .state == "present" then "dry run: would clear legacy cache (\(.bytes) bytes): \(.root); live HLS=\(.processes | length), old Pi=\(.oldPiClients | length); repeat with --apply" else "legacy cache absent: \(.root)" end' <<<"$result"
    fi
    exit 0
fi

if [ "$command_name" = legacy ]; then exit 0; fi
args=(cache "$command_name" --parent "$cache_parent")
[ "$command_name" = stale ] || args+=(--workspace "$workspace")
[ "$apply" = false ] || args+=(--apply)
result="$("$tooling_launcher" artifacts "${args[@]}")"
if [ "$command_name" = stale ]; then
    result="$(jq -c '{action:"stale", applied:.applied, caches:.caches, bytes:([.caches[].bytes] | add // 0)}' <<<"$result")"
elif [ "$command_name" = clear ]; then
    result="$(jq -c --argjson applied "$apply" '{action:"clear", applied:($applied and .state == "present"), cache:.}' <<<"$result")"
fi
if [ "$json" = true ]; then jq . <<<"$result"; exit 0; fi
case "$command_name" in
    status) jq -r '"state=\(.state) active=\(.active) bytes=\(.bytes) filesystem=\(.filesystem) root=\(.root)"' <<<"$result" ;;
    clear) if [ "$apply" = true ]; then jq -r 'if .cache.state == "present" then "cleared \(.cache.bytes) bytes from \(.cache.root)" else "cache absent: \(.cache.root)" end' <<<"$result"; else jq -r 'if .cache.state == "present" then "dry run: would clear \(.cache.bytes) bytes from \(.cache.root); repeat with --apply" else "cache absent: \(.cache.root)" end' <<<"$result"; fi ;;
    stale) if [ "$apply" = true ]; then jq -r '"cleared \(.caches | length) stale caches (\(.bytes) bytes)"' <<<"$result"; else jq -r '"dry run: would clear \(.caches | length) stale caches (\(.bytes) bytes); repeat with --apply"' <<<"$result"; fi ;;
esac
