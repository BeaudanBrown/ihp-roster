#!/usr/bin/env bash
set -euo pipefail
repo_root="${HASKELL_GENERATED_REPO_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
cd "$repo_root"
scripts_root="${BEPIS_SCRIPTS_ROOT:?}"
tooling_launcher="${BEPIS_TOOLING_LAUNCHER:-$repo_root/bin/tooling-run}"
state_dir="$(dev-agent-state-dir)/generated-code"
generator="${HASKELL_REGEN_TYPES_COMMAND:-$scripts_root/haskell/regen-types-raw}"
mkdir -p "$state_dir"
result="$("$tooling_launcher" artifacts generate --mode ensure --root "$repo_root" \
    --lock "$state_dir/haskell-generation.lock" --manifest "$state_dir/haskell-types.manifest" \
    --input-command "$scripts_root/haskell/generated-input-inventory" \
    --output-command "$scripts_root/haskell/generated-output-inventory" -- "$generator")"
if [ "$result" = current ]; then
    echo "haskell-generated-ensure: generated types are current"
else
    echo "haskell-generated-ensure: regenerated types"
fi
