#!/usr/bin/env bash
set -euo pipefail
# shellcheck source=../lib/ghc.sh
. "@scriptsRoot@/lib/ghc.sh"
ihp_roster_configure_compiler_tmpdir
# shellcheck source=../lib/common.sh
. "@scriptsRoot@/lib/common.sh"
BASE_TEST_DATABASE_NAME="${TEST_DATABASE_NAME:-app_test}"
TEST_LANE="${TEST_LANE:-all}"
TEST_FEEDBACK_LANE="${TEST_FEEDBACK_LANE:-all}"
export TEST_LANE TEST_FEEDBACK_LANE

HSPEC_METRICS_DIR="${HSPEC_METRICS_DIR:-}"
HSPEC_PHASE_METRICS_FILE=""
if [ -n "$HSPEC_METRICS_DIR" ]; then
    mkdir -p "$HSPEC_METRICS_DIR"
    HSPEC_PHASE_METRICS_FILE="$HSPEC_METRICS_DIR/phases.jsonl"
    : > "$HSPEC_PHASE_METRICS_FILE"
fi

metrics_now() {
    if [ -n "$HSPEC_PHASE_METRICS_FILE" ]; then
        date +%s.%N
    else
        printf '0\n'
    fi
}

record_phase() {
    local phase="$1"
    local shard="$2"
    local started_at="$3"
    local finished_at="$4"

    if [ -z "$HSPEC_PHASE_METRICS_FILE" ]; then
        return 0
    fi

    local duration
    duration="$(awk -v started_at="$started_at" -v finished_at="$finished_at" 'BEGIN { printf "%.9f", finished_at - started_at }')"
    printf '{"phase":"%s","shard":%s,"startedAt":%s,"finishedAt":%s,"durationSeconds":%s}\n' \
        "$phase" "$shard" "$started_at" "$finished_at" "$duration" >> "$HSPEC_PHASE_METRICS_FILE"
}

script_started_at="$(metrics_now)"

case "$TEST_LANE" in
    all|pure|db)
        ;;
    *)
        echo "TEST_LANE must be one of all, pure, or db; got: $TEST_LANE" >&2
        exit 1
        ;;
esac

case "$TEST_FEEDBACK_LANE" in
    all|routine|acceptance)
        ;;
    *)
        echo "TEST_FEEDBACK_LANE must be one of all, routine, or acceptance; got: $TEST_FEEDBACK_LANE" >&2
        exit 1
        ;;
esac

if [ "$TEST_LANE" != "pure" ]; then
    ihp_roster_configure_test_postgres
    ihp_roster_report_test_postgres
else
    export TEST_DB_SOCKET="${TEST_DB_SOCKET:-${PGHOST:-$PWD/build/db}}"
fi

TEST_DB_SHARDS_MAX="${TEST_DB_SHARDS_MAX:-6}"
case "$TEST_DB_SHARDS_MAX" in
    ""|*[!0-9]*)
        echo "TEST_DB_SHARDS_MAX must be a positive integer, got: $TEST_DB_SHARDS_MAX" >&2
        exit 1
        ;;
esac
if [ "$TEST_DB_SHARDS_MAX" -lt 1 ]; then
    echo "TEST_DB_SHARDS_MAX must be at least 1" >&2
    exit 1
fi

detect_test_shards() {
    if [ -n "${TEST_SHARDS:-}" ]; then
        printf '%s\n' "$TEST_SHARDS"
        return 0
    fi

    if [ "$TEST_LANE" = "pure" ] || [ "$#" -gt 0 ]; then
        printf '1\n'
        return 0
    fi

    local detected_shards
    detected_shards="$(ihp_roster_detect_cpu_count)"
    if [ "$TEST_LANE" != "pure" ] && [ "$detected_shards" -gt "${TEST_DB_SHARDS_MAX:-6}" ]; then
        printf '%s\n' "${TEST_DB_SHARDS_MAX:-6}"
    else
        printf '%s\n' "$detected_shards"
    fi
}

TEST_SHARDS="$(detect_test_shards "$@")"
case "$TEST_SHARDS" in
    ""|*[!0-9]*)
        echo "TEST_SHARDS must be a positive integer, got: $TEST_SHARDS" >&2
        exit 1
        ;;
esac
if [ "$TEST_SHARDS" -lt 1 ]; then
    echo "TEST_SHARDS must be at least 1" >&2
    exit 1
fi

GHC_OPTS="$(ihp_roster_ghc_opts) -iTest"
VERIFICATION_DIR="$(ihp_roster_verification_build_dir)"
ihp_roster_prepare_ghc_build_dir "$VERIFICATION_DIR" "$GHC_OPTS"
mkdir -p build/Test
compile_started_at="$(metrics_now)"
ghc $GHC_OPTS -main-is Test.HspecMain Test/HspecMain.hs -o build/Test/Main \
    -odir "$VERIFICATION_DIR/obj" \
    -hidir "$VERIFICATION_DIR/hi"
compile_finished_at="$(metrics_now)"
record_phase "compile" 0 "$compile_started_at" "$compile_finished_at"

if [ "$TEST_SHARDS" -eq 1 ]; then
    if [ -n "$HSPEC_METRICS_DIR" ]; then
        export HSPEC_RESET_METRICS_FILE="$HSPEC_METRICS_DIR/reset-shard-1-ns.txt"
        export HSPEC_FIXTURE_METRICS_FILE="$HSPEC_METRICS_DIR/fixture-shard-1-ns.txt"
        export HSPEC_APPLICATION_METRICS_FILE="$HSPEC_METRICS_DIR/application-shard-1-ns.txt"
        : > "$HSPEC_RESET_METRICS_FILE"
        : > "$HSPEC_FIXTURE_METRICS_FILE"
        : > "$HSPEC_APPLICATION_METRICS_FILE"
    fi

    if [ "$TEST_LANE" != "pure" ]; then
        export TEST_DATABASE_NAME="$BASE_TEST_DATABASE_NAME"
        export DATABASE_URL="postgresql:///$TEST_DATABASE_NAME?host=$TEST_DB_SOCKET"
        database_started_at="$(metrics_now)"
        test-db-reset
        database_finished_at="$(metrics_now)"
        record_phase "shard_database_create" 1 "$database_started_at" "$database_finished_at"
    fi

    if [ -z "$HSPEC_PHASE_METRICS_FILE" ]; then
        exec build/Test/Main "$@"
    fi

    execution_started_at="$(metrics_now)"
    if build/Test/Main "$@"; then
        status=0
    else
        status=$?
    fi
    execution_finished_at="$(metrics_now)"
    record_phase "hspec_execution" 1 "$execution_started_at" "$execution_finished_at"
    script_finished_at="$(metrics_now)"
    record_phase "command_total" 0 "$script_started_at" "$script_finished_at"
    exit "$status"
fi

RUN_ID="${TEST_RUN_ID:-$(date +%s)-$$-$RANDOM}"
STATE_ROOT="$PWD/.devenv/test"
STATE_DIR="$STATE_ROOT/$RUN_ID"
mkdir -p "$STATE_DIR"
ln -sfn "$STATE_DIR" "$STATE_ROOT/latest"

shard_pids=()
shard_statuses=()

run_test_shard() {
    local shard_index="$1"
    shift
    local shard_db_name="${BASE_TEST_DATABASE_NAME}_${RUN_ID}_shard_${shard_index}"
    local shard_log="$STATE_DIR/shard-$shard_index.log"

    (
        export TEST_SHARD_INDEX="$shard_index"
        export TEST_SHARD_TOTAL="$TEST_SHARDS"
        export TEST_DATABASE_NAME="$shard_db_name"
        export DATABASE_URL="postgresql:///$TEST_DATABASE_NAME?host=$TEST_DB_SOCKET"

        if [ -n "$HSPEC_METRICS_DIR" ]; then
            export HSPEC_RESET_METRICS_FILE="$HSPEC_METRICS_DIR/reset-shard-$shard_index-ns.txt"
            export HSPEC_FIXTURE_METRICS_FILE="$HSPEC_METRICS_DIR/fixture-shard-$shard_index-ns.txt"
            export HSPEC_APPLICATION_METRICS_FILE="$HSPEC_METRICS_DIR/application-shard-$shard_index-ns.txt"
            : > "$HSPEC_RESET_METRICS_FILE"
            : > "$HSPEC_FIXTURE_METRICS_FILE"
            : > "$HSPEC_APPLICATION_METRICS_FILE"
        fi

        cleanup() {
            if [ "$TEST_LANE" = "pure" ] || [ "${TEST_KEEP_DATABASES:-0}" = "1" ]; then
                return 0
            fi

            local cleanup_started_at cleanup_finished_at
            cleanup_started_at="$(metrics_now)"
            psql -h "$TEST_DB_SOCKET" -d postgres -v ON_ERROR_STOP=1 <<SQL >/dev/null 2>&1 || true
DROP DATABASE IF EXISTS "$TEST_DATABASE_NAME" WITH (FORCE);
SQL
            cleanup_finished_at="$(metrics_now)"
            record_phase "shard_database_drop" "$shard_index" "$cleanup_started_at" "$cleanup_finished_at"
        }
        trap cleanup EXIT INT TERM

        if [ "$TEST_LANE" != "pure" ]; then
            database_started_at="$(metrics_now)"
            test-db-reset
            database_finished_at="$(metrics_now)"
            record_phase "shard_database_create" "$shard_index" "$database_started_at" "$database_finished_at"
        fi

        execution_started_at="$(metrics_now)"
        if build/Test/Main "$@"; then
            status=0
        else
            status=$?
        fi
        execution_finished_at="$(metrics_now)"
        record_phase "hspec_execution" "$shard_index" "$execution_started_at" "$execution_finished_at"
        exit "$status"
    ) >"$shard_log" 2>&1 &

    shard_pids+=("$!")
}

parallel_started_at="$(metrics_now)"
for shard_index in $(seq 1 "$TEST_SHARDS"); do
    run_test_shard "$shard_index" "$@"
done

failed=0
for shard_offset in "${!shard_pids[@]}"; do
    if wait "${shard_pids[$shard_offset]}"; then
        shard_statuses[$shard_offset]=0
    else
        shard_statuses[$shard_offset]=$?
        failed=1
    fi
done

parallel_finished_at="$(metrics_now)"
record_phase "parallel_run" 0 "$parallel_started_at" "$parallel_finished_at"

if [ "$failed" -ne 0 ]; then
    echo "Parallel hspec run failed; shard logs are under $STATE_DIR" >&2
    for shard_index in $(seq 1 "$TEST_SHARDS"); do
        status="${shard_statuses[$((shard_index - 1))]:-1}"
        if [ "$status" -ne 0 ]; then
            echo >&2
            echo "===== hspec shard $shard_index/$TEST_SHARDS failed (exit $status) =====" >&2
            tail -n 120 "$STATE_DIR/shard-$shard_index.log" >&2 || true
        fi
    done
    script_finished_at="$(metrics_now)"
    record_phase "command_total" 0 "$script_started_at" "$script_finished_at"
    exit 1
fi

echo "Parallel hspec run completed across $TEST_SHARDS shards"
echo "Shard logs: $STATE_DIR"
script_finished_at="$(metrics_now)"
record_phase "command_total" 0 "$script_started_at" "$script_finished_at"
