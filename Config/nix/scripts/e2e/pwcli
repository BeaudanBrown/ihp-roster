#!/usr/bin/env bash
set -euo pipefail
STATE_DIR="$PWD/.devenv/playwright-cli"
CONFIG_FILE="$STATE_DIR/cli.config.json"
mkdir -p "$STATE_DIR"
mkdir -p "$PWD/.playwright"

PWCLI_BROWSER=""
for candidate in "$PLAYWRIGHT_BROWSERS_PATH"/chromium-*/chrome-linux*/chrome; do
    if [ -x "$candidate" ]; then
        PWCLI_BROWSER="$candidate"
        break
    fi
done

if [ -z "$PWCLI_BROWSER" ]; then
    echo "Could not locate Chromium inside PLAYWRIGHT_BROWSERS_PATH=$PLAYWRIGHT_BROWSERS_PATH" >&2
    exit 1
fi

cat >"$CONFIG_FILE" <<EOF
{
  "browser": {
    "browserName": "chromium",
    "launchOptions": {
      "executablePath": "$PWCLI_BROWSER"
    }
  }
}
EOF

HAS_CONFIG=false
for arg in "$@"; do
    if [ "$arg" = "--config" ] || [ "${arg#--config=}" != "$arg" ]; then
        HAS_CONFIG=true
        break
    fi
done

if [ "$HAS_CONFIG" = true ]; then
    exec npx --no-install playwright-cli "$@"
fi

exec npx --no-install playwright-cli --config "$CONFIG_FILE" "$@"
