#!/usr/bin/env bash
set -euo pipefail
umask 077

scripts_root="${BEPIS_SCRIPTS_ROOT:-@scriptsRoot@}"
if [ ! -d "$scripts_root/lib" ]; then
    scripts_root="$(realpath "$(dirname "$0")/..")"
fi
export BEPIS_HLS_CACHE_COMMAND="${BEPIS_HLS_CACHE_COMMAND:-$scripts_root/haskell/hls-cache}"
tooling_launcher="${BEPIS_TOOLING_LAUNCHER:-$(realpath "$scripts_root/../../../bin/tooling-run")}"
exec "$tooling_launcher" epic manage "$@"
