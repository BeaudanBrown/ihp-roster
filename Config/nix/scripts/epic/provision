#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
[ -n "$repo_root" ] || { echo "epic-worktree-provision: run from the primary Git checkout" >&2; exit 66; }
tooling_launcher="${BEPIS_TOOLING_LAUNCHER:-$(realpath "$(dirname "$0")/../../../../bin/tooling-run")}"
exec "$tooling_launcher" workspace provision "$@"
