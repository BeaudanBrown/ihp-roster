#!/usr/bin/env bash
set -euo pipefail
umask 077

program="epic-worktree"
case "${1:-}" in
    register|resolve)
        lookup_path="."
        previous=""
        for argument in "$@"; do
            if [ "$previous" = --path ]; then lookup_path="$argument"; break; fi
            previous="$argument"
        done
        repo_root="$(git -C "$lookup_path" rev-parse --show-toplevel 2>/dev/null || true)"
        [ -n "$repo_root" ] || { echo "$program: run from a Git worktree or pass --path" >&2; exit 66; }
        tooling_launcher="${BEPIS_TOOLING_LAUNCHER:-$(realpath "$(dirname "$0")/../../../../bin/tooling-run")}"
        exec "$tooling_launcher" workspace "$@"
        ;;
esac
scripts_root="${BEPIS_SCRIPTS_ROOT:?}"
# shellcheck source=../lib/hls-cache.sh
# shellcheck disable=SC1091
. "$scripts_root/lib/hls-cache.sh"
# shellcheck source=../lib/workspace-resources.sh
# shellcheck disable=SC1091
. "$scripts_root/lib/workspace-resources.sh"

usage() {
    cat <<'EOF'
Usage:
  epic-worktree register --epic NUMBER --target BRANCH [--branch BRANCH] [--path PATH] [--kind epic]
  epic-worktree inspect [--epic NUMBER | --branch BRANCH | --path PATH | --all] [--json]
  epic-worktree resolve [--epic NUMBER | --branch BRANCH | --path PATH | --all] [--json]
  epic-worktree orient [--json]

Registers, inspects, resolves, and orients local epic worktrees. The shared
registry is stored beneath Git's common directory; the compact identity is
stored in the worktree root. Resolve validates registry, Git, and identity state
without the process, resource, or HLS diagnostics gathered by inspect.
Orientation reads live parent/sub-issue/blocker state from GitHub and never
selects, starts, or closes work.
EOF
}

die() {
    local status="$1"
    shift
    echo "$program: $*" >&2
    exit "$status"
}

require_command() {
    command -v "$1" >/dev/null 2>&1 || die 69 "required command is unavailable: $1"
}

for required in flock git jq realpath; do
    require_command "$required"
done

reject_line_breaks() {
    local label="$1"
    local value="$2"
    if [[ "$value" == *$'\n'* || "$value" == *$'\r'* ]]; then
        die 64 "$label may not contain line breaks"
    fi
}

validate_epic() {
    [[ "$1" =~ ^[1-9][0-9]*$ ]] || die 64 "epic must be a positive integer: $1"
}

validate_branch() {
    local label="$1"
    local value="$2"
    reject_line_breaks "$label" "$value"
    git check-ref-format --branch "$value" >/dev/null 2>&1 || die 64 "invalid $label: $value"
}

record_with_status() {
    local record="$1"
    local resources path common_dir uncontained uncontained_work hls
    path="$(jq -r '.path' <<<"$record")"
    common_dir="$(git -C "$path" rev-parse --path-format=absolute --git-common-dir)"
    resources="$(bepis_workspace_resource_status "$common_dir" epic "$(jq -r '.slot' <<<"$record")")"
    uncontained="$(bepis_workspace_uncontained_processes_in_path "$path" "$(jq -r '.slice' <<<"$resources")")"
    uncontained_work="$(jq -c '
        [.[] | select(
            .cpuPercent >= 1
            or .rssKiB >= 262144
            or (.command | test("haskell-language-server|(^|[/ ])ghc([ -]|$)|cabal|playwright|RunE2EApp")))]
    ' <<<"$uncontained")"
    hls="$(bepis_workspace_hls_status "$path")"
    resources="$(jq -c \
        --argjson uncontained "$uncontained" \
        --argjson uncontainedWork "$uncontained_work" \
        --argjson hls "$hls" \
        '. + {hls: $hls, uncontainedPathProcesses: $uncontained,
              uncontainedWorkProcesses: $uncontainedWork,
              warning: (if ($uncontainedWork | length) > 0 then "resource-consuming processes in worktree are outside expected slice" else null end)}' \
        <<<"$resources")"
    jq -c --argjson resources "$resources" '. + {resources: $resources}' <<<"$record"
}

print_record() {
    local record="$1"
    local json="$2"
    if [ "$json" = true ]; then
        jq . <<<"$record"
    else
        jq -r '
            "epic #\(.epic) | \(.kind) | slot \(.slot) | \(.branch) -> \(.targetBranch) | \(.status) | cpu weight \(.resources.cpuWeight), processes \(.resources.processes), uncontained \(.resources.uncontainedPathProcesses | length) (work \(.resources.uncontainedWorkProcesses | length)), HLS \(.resources.hls.processes | length), HLS RSS \(.resources.hls.totalRssKiB) KiB, HLS cache \(.resources.hls.cacheTotalBytes) bytes, cache root \(.resources.hls.cacheRoot), indexing \(.resources.hls.indexingActive) | \(.path)",
            (.resources.hls.processes[] | "  HLS pid \(.pid) | CPU \(.cpuPercent)% | RSS \(.rssKiB) KiB | elapsed \(.elapsedSeconds)s | cache \(.cacheBytes) bytes | indexing \(.indexingActive)"),
            (if .resources.warning == null then empty else "WARNING: \(.resources.warning)" end)
        ' <<<"$record"
    fi
}

print_resolved_record() {
    local record="$1"
    local json="$2"
    if [ "$json" = true ]; then
        jq . <<<"$record"
    else
        jq -r '"epic #\(.epic) | \(.kind) | slot \(.slot) | \(.branch) -> \(.targetBranch) | \(.status) | \(.path)"' <<<"$record"
    fi
}

command_name="${1:-}"
case "$command_name" in
    register|inspect|resolve|orient)
        shift
        ;;
    help|-h|--help)
        usage
        exit 0
        ;;
    *)
        usage >&2
        die 64 "expected register, inspect, resolve, or orient"
        ;;
esac

if [ "$command_name" = orient ]; then
    json=false
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --json)
                json=true
                shift
                ;;
            -h|--help)
                usage
                exit 0
                ;;
            *) die 64 "unknown orient option: $1" ;;
        esac
    done

    require_command gh
    current_path="$(git rev-parse --show-toplevel 2>/dev/null || true)"
    [ -n "$current_path" ] || die 66 "orient must run from a registered epic worktree"
    RESOLVED_PATH="$(realpath "$current_path")"
    tooling_launcher="${BEPIS_TOOLING_LAUNCHER:-$(realpath "$(dirname "$0")/../../../../bin/tooling-run")}"
    orientation_record="$("$tooling_launcher" workspace resolve --path "$RESOLVED_PATH" --json)" \
        || die 66 "current worktree is not registered as an epic workspace"
    [ "$(jq -r '.status' <<<"$orientation_record")" = active ] \
        || die 65 "current epic worktree identity is stale or inconsistent"

    epic_number="$(jq -r '.epic' <<<"$orientation_record")"
    target_branch="$(jq -r '.targetBranch' <<<"$orientation_record")"
    repository="$(gh repo view --json nameWithOwner --jq .nameWithOwner 2>/dev/null)" \
        || die 69 "cannot resolve the GitHub repository; authenticate gh and retry"
    [[ "$repository" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] \
        || die 65 "GitHub returned an invalid repository name"

    github_api() {
        local endpoint="$1"
        gh api -H "Accept: application/vnd.github+json" \
            -H "X-GitHub-Api-Version: 2022-11-28" "$endpoint" 2>/dev/null \
            || die 69 "cannot read live GitHub issue state: $endpoint"
    }

    github_api_collection() {
        local endpoint="$1"
        local response
        response="$(gh api --paginate --slurp \
            -H "Accept: application/vnd.github+json" \
            -H "X-GitHub-Api-Version: 2022-11-28" "$endpoint" 2>/dev/null)" \
            || die 69 "cannot read live GitHub issue state: $endpoint"
        jq -c 'if length == 0 then [] elif (.[0] | type) == "array" then add else . end' <<<"$response" \
            || die 65 "GitHub returned malformed paginated issue state"
    }

    parent="$(github_api "repos/$repository/issues/$epic_number")"
    jq -e --argjson epic "$epic_number" \
        '.number == $epic and (.title | type == "string") and (.state | type == "string") and (.html_url | type == "string")' \
        <<<"$parent" >/dev/null || die 65 "GitHub returned malformed parent issue state"
    children="$(github_api_collection "repos/$repository/issues/$epic_number/sub_issues?per_page=100")"
    jq -e 'type == "array" and all(.[]; (.number | type == "number") and (.title | type == "string") and (.state | type == "string") and (.assignees | type == "array"))' \
        <<<"$children" >/dev/null || die 65 "GitHub returned malformed sub-issue state"

    mapfile -d '' -t staged_paths < <(git -C "$RESOLVED_PATH" diff --cached --name-only -z)
    mapfile -d '' -t unstaged_paths < <(git -C "$RESOLVED_PATH" diff --name-only -z)
    mapfile -d '' -t untracked_paths < <(git -C "$RESOLVED_PATH" ls-files --others --exclude-standard -z)
    mapfile -d '' -t conflicted_paths < <(git -C "$RESOLVED_PATH" diff --name-only --diff-filter=U -z)
    staged_json="$(printf '%s\0' "${staged_paths[@]}" | jq -Rs 'split("\u0000") | map(select(length > 0))')"
    unstaged_json="$(printf '%s\0' "${unstaged_paths[@]}" | jq -Rs 'split("\u0000") | map(select(length > 0))')"
    untracked_json="$(printf '%s\0' "${untracked_paths[@]}" | jq -Rs 'split("\u0000") | map(select(length > 0))')"
    conflicted_json="$(printf '%s\0' "${conflicted_paths[@]}" | jq -Rs 'split("\u0000") | map(select(length > 0))')"
    changes_json="$(jq -cn \
        --argjson staged "$staged_json" --argjson unstaged "$unstaged_json" \
        --argjson untracked "$untracked_json" --argjson conflicted "$conflicted_json" \
        '{staged: $staged, unstaged: $unstaged, untracked: $untracked, conflicted: $conflicted}')"
    local_interrupted="$(jq 'any(.[]; length > 0)' <<<"$changes_json")"

    target_ref="$target_branch"
    if ! git -C "$RESOLVED_PATH" rev-parse --verify --quiet "$target_ref^{commit}" >/dev/null; then
        die 65 "recorded target branch is unavailable: $target_branch"
    fi
    ahead_count="$(git -C "$RESOLVED_PATH" rev-list --count "$target_ref..HEAD")"
    commit_text="$(git -C "$RESOLVED_PATH" log --format='%s%n%b' "$target_ref..HEAD")"
    committed_numbers="$({ grep -Eo '#[1-9][0-9]*' <<<"$commit_text" 2>/dev/null || true; } \
        | tr -d '#' | sort -nu | jq -Rsc 'split("\n") | map(select(length > 0) | tonumber)')"

    ready='[]'
    active='[]'
    blocked='[]'
    while IFS= read -r child; do
        [ "$(jq -r '.state' <<<"$child")" = open ] || continue
        child_number="$(jq -r '.number' <<<"$child")"
        blockers="$(github_api_collection "repos/$repository/issues/$child_number/dependencies/blocked_by?per_page=100")"
        jq -e 'type == "array" and all(.[]; (.number | type == "number") and (.state | type == "string"))' \
            <<<"$blockers" >/dev/null || die 65 "GitHub returned malformed blocker state for issue #$child_number"
        open_blockers="$(jq '[.[] | select(.state == "open") | {number, title, url: .html_url}]' <<<"$blockers")"
        issue="$(jq '{number, title, url: .html_url, assignees: [.assignees[].login]}' <<<"$child")"
        if [ "$(jq 'length' <<<"$open_blockers")" -gt 0 ]; then
            blocked="$(jq -c --argjson issue "$issue" --argjson blockers "$open_blockers" '. + [$issue + {blockedBy: $blockers}]' <<<"$blocked")"
        elif [ "$(jq '.assignees | length' <<<"$child")" -gt 0 ] || jq -e --argjson number "$child_number" 'index($number) != null' <<<"$committed_numbers" >/dev/null; then
            reasons='[]'
            if [ "$(jq '.assignees | length' <<<"$child")" -gt 0 ]; then
                reasons="$(jq -c '. + ["assigned"]' <<<"$reasons")"
            fi
            if jq -e --argjson number "$child_number" 'index($number) != null' <<<"$committed_numbers" >/dev/null; then
                reasons="$(jq -c '. + ["committed-work-awaiting-resolution"]' <<<"$reasons")"
            fi
            active="$(jq -c --argjson issue "$issue" --argjson reasons "$reasons" '. + [$issue + {reasons: $reasons}]' <<<"$active")"
        else
            ready="$(jq -c --argjson issue "$issue" '. + [$issue]' <<<"$ready")"
        fi
    done < <(jq -c '.[]' <<<"$children")

    pending_committed_issues="$(jq -c --argjson committed "$committed_numbers" \
        '[.[] | select(.state == "open" and (.number as $number | $committed | index($number) != null)) | .number]' \
        <<<"$children")"
    interrupted="$local_interrupted"
    if [ "$(jq 'length' <<<"$pending_committed_issues")" -gt 0 ]; then
        interrupted=true
    fi
    selection_allowed="$([ "$interrupted" = false ] && printf true || printf false)"
    result="$(jq -cn \
        --argjson parent "$parent" --argjson workspace "$orientation_record" \
        --argjson changes "$changes_json" --argjson interrupted "$interrupted" \
        --argjson pending "$pending_committed_issues" --argjson ahead "$ahead_count" \
        --argjson ready "$ready" --argjson active "$active" \
        --argjson blocked "$blocked" --argjson allowed "$selection_allowed" '
        {
            epic: {number: $parent.number, title: $parent.title, state: $parent.state, url: $parent.html_url},
            workspace: ($workspace + {interrupted: $interrupted, pendingCommittedIssues: $pending, aheadOfTarget: $ahead, changes: $changes}),
            issues: {ready: $ready, activeInterrupted: $active, blocked: $blocked},
            selection: {allowed: $allowed, requiresUserChoice: true},
            approvalRules: [
                "Wait for the user to choose an issue before beginning work.",
                "Commit and present verification evidence before requesting approval to close.",
                "Close only after approval, then refresh orientation; proceed with an explicitly selected next issue, otherwise request selection."
            ]
        }')"

    if [ "$json" = true ]; then
        jq . <<<"$result"
        exit 0
    fi

    jq -r '"EPIC #\(.epic.number): \(.epic.title) [\(.epic.state)]\nWORKSPACE: slot \(.workspace.slot), \(.workspace.branch) -> \(.workspace.targetBranch), ahead \(.workspace.aheadOfTarget)"' <<<"$result"
    if [ "$interrupted" = true ]; then
        echo "STOP: interrupted workspace work must be resumed or resolved before choosing new work."
        echo "READY — unavailable until interruption resolved"
    else
        echo "READY — choose explicitly"
    fi
    jq -r '.issues.ready[] | "  #\(.number) \(.title)"' <<<"$result"
    echo "ACTIVE / INTERRUPTED"
    jq -r '.issues.activeInterrupted[] | "  #\(.number) \(.title) [\(.reasons | join(", "))]"' <<<"$result"
    echo "BLOCKED"
    jq -r '.issues.blocked[] | "  #\(.number) \(.title) [blocked by \([.blockedBy[].number | "#\(.)"] | join(", "))]"' <<<"$result"
    echo "Wait for the user; do not begin, close, or move issues automatically."
    echo "After implementation: commit, present verification evidence, and request approval before closure."
    echo "After approved closure: refresh orientation; proceed with an explicitly selected next issue, otherwise request selection."
    exit 0
fi

selector_count=0
selector_kind="path"
selector_value=""
json=false
all=false
while [ "$#" -gt 0 ]; do
    case "$1" in
        --epic|--branch|--path)
            option="$1"
            [ "$#" -ge 2 ] || die 64 "missing value for $option"
            selector_count=$((selector_count + 1))
            selector_kind="${option#--}"
            selector_value="$2"
            shift 2
            ;;
        --all)
            selector_count=$((selector_count + 1))
            all=true
            shift
            ;;
        --json)
            json=true
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *) die 64 "unknown $command_name option: $1" ;;
    esac
done
[ "$selector_count" -le 1 ] || die 64 "$command_name accepts only one selector"

if [ "$selector_kind" = epic ] && [ -n "$selector_value" ]; then
    validate_epic "$selector_value"
elif [ "$selector_kind" = branch ] && [ -n "$selector_value" ]; then
    validate_branch "workspace branch" "$selector_value"
fi

tooling_launcher="${BEPIS_TOOLING_LAUNCHER:-$(realpath "$(dirname "$0")/../../../../bin/tooling-run")}"
resolve_arguments=(workspace resolve --json)
if [ "$all" = true ]; then
    resolve_arguments+=(--all)
elif [ -n "$selector_value" ]; then
    resolve_arguments+=("--$selector_kind" "$selector_value")
fi
resolved="$("$tooling_launcher" "${resolve_arguments[@]}")" || exit $?
if [ "$all" = true ]; then
    mapfile -t records < <(jq -c '.[]' <<<"$resolved")
else
    records=("$(jq -c . <<<"$resolved")")
fi

if [ "$json" = true ] && [ "$all" = true ]; then
    statuses='[]'
    for record in "${records[@]}"; do
        statuses="$(jq -c --argjson record "$(record_with_status "$record")" '. + [$record]' <<<"$statuses")"
    done
    jq . <<<"$statuses"
else
    for record in "${records[@]}"; do
        print_record "$(record_with_status "$record")" "$json"
    done
fi
