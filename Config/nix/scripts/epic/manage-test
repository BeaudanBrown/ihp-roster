#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
manage_source="$repo_root/Config/nix/scripts/epic/manage"
registry_command="$repo_root/Config/nix/scripts/epic/worktree"
fixture_root="$(mktemp -d)"
manage_command="$fixture_root/manage"
scripts_root_replacement="$(printf '%s' "$repo_root/Config/nix/scripts" | sed 's/[\&|]/\\&/g')"
scripts_root_token="@scripts""Root@"
sed "s|$scripts_root_token|$scripts_root_replacement|g" "$manage_source" >"$manage_command"
cleanup() {
    if [ -n "${runtime_pid:-}" ]; then
        kill "$runtime_pid" 2>/dev/null || true
        wait "$runtime_pid" 2>/dev/null || true
    fi
    rm -rf "$fixture_root"
}
trap cleanup EXIT

fail() {
    echo "epic-worktree-manage-test: $*" >&2
    exit 1
}

assert_contains() {
    local haystack="$1"
    local needle="$2"
    [[ "$haystack" == *"$needle"* ]] || fail "expected marker was absent: $needle"
}

run_manage() {
    (
        cd "$primary_repo"
        PATH="$fake_bin:$PATH" \
        EPIC_WORKTREE_COMMAND="$registry_command" bash "$manage_command" "$@"
    )
}

run_manage_from_configured_caller() {
    (
        cd "$primary_repo"
        BEPIS_WORKSPACE_STATE_CONFIGURED=1 \
        BEPIS_WORKSPACE_REPO_ROOT="$primary_repo" \
        BEPIS_WORKSPACE_STATE_ROOT="$fixture_root/caller-state" \
        DEVENV_AGENT_STATE_DIR="$fixture_root/caller-state/workspace-primary" \
        PATH="$fake_bin:$PATH" \
        EPIC_WORKTREE_COMMAND="$registry_command" \
            bash "$manage_command" "$@"
    )
}

fake_bin="$fixture_root/bin"
mkdir -p "$fake_bin"
cat >"$fake_bin/gh" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
if [ "$1" = repo ] && [ "$2" = view ]; then
    echo 'BeaudanBrown/ihp-roster'
elif [ "$1" = api ]; then
    echo '{"state":"closed"}'
else
    exit 64
fi
EOF
chmod +x "$fake_bin/gh"

primary_repo="$fixture_root/repo"
epic_path="$fixture_root/repo-epic-270"
git init --quiet --initial-branch=roster "$primary_repo"
git -C "$primary_repo" config user.name "Epic Management Test"
git -C "$primary_repo" config user.email "epic-management-test@example.invalid"
printf 'base\n' >"$primary_repo/README"
printf '.bepis-epic-worktree.json\n.devenv/\nbuild/\n' >"$primary_repo/.gitignore"
git -C "$primary_repo" add README .gitignore
git -C "$primary_repo" commit --quiet -m base
git -C "$primary_repo" branch epic-270
git -C "$primary_repo" worktree add --quiet "$epic_path" epic-270
(
    cd "$epic_path"
    bash "$registry_command" register --epic 270 --target roster >/dev/null
)

mkdir -p "$epic_path/Application/Migration" "$epic_path/Application/Example/Generated"
printf '%s\n' '-- migration' >"$epic_path/Application/Migration/1700000000-example.sql"
printf '%s\n' '-- @generated by fixture' >"$epic_path/Application/Example/Generated/Action.hs"
git -C "$epic_path" add Application
git -C "$epic_path" commit --quiet -m 'Epic implementation (#270)'
remote_repo="$fixture_root/remote.git"
git init --quiet --bare "$remote_repo"
git -C "$primary_repo" remote add origin "$remote_repo"
git -C "$primary_repo" push --quiet origin roster epic-270
printf 'target update\n' >>"$primary_repo/README"
git -C "$primary_repo" add README
git -C "$primary_repo" commit --quiet -m 'Target update'

epic_before="$(git -C "$epic_path" rev-parse HEAD)"
target_before="$(git -C "$primary_repo" rev-parse HEAD)"
status_before="$(git -C "$epic_path" status --porcelain=v1)"
common_objects="$primary_repo/.git/objects"
objects_before="$(find "$common_objects" -type f -printf '%P\n' | sort)"
preflight_json="$(run_manage preflight --epic 270 --json)"
[ "$(jq -r '.workspace.clean' <<<"$preflight_json")" = true ] || fail "clean epic was reported dirty"
[ "$(jq -r '.divergence.epicAhead' <<<"$preflight_json")" = 1 ] || fail "epic-ahead count is wrong"
[ "$(jq -r '.divergence.targetAhead' <<<"$preflight_json")" = 1 ] || fail "target-ahead count is wrong"
[ "$(jq -r '.conflicts.detected' <<<"$preflight_json")" = false ] || fail "non-conflicting branches reported conflicts"
[ "$(jq -r '.impact.migrations' <<<"$preflight_json")" = true ] || fail "migration impact was omitted"
[ "$(jq -r '.impact.generatedFiles' <<<"$preflight_json")" = true ] || fail "generated-file impact was omitted"
[ "$(jq -r '.requiredChecks | index("regen-types") != null' <<<"$preflight_json")" = true ] || fail "schema check guidance was omitted"
[ "$(git -C "$epic_path" rev-parse HEAD)" = "$epic_before" ] || fail "preflight moved epic HEAD"
[ "$(git -C "$primary_repo" rev-parse HEAD)" = "$target_before" ] || fail "preflight moved target HEAD"
[ "$(git -C "$epic_path" status --porcelain=v1)" = "$status_before" ] || fail "preflight changed the worktree"
human_preflight="$(run_manage preflight --epic 270)"
assert_contains "$human_preflight" "runtime: active=0 stale=0"
objects_after="$(find "$common_objects" -type f -printf '%P\n' | sort)"
[ "$objects_after" = "$objects_before" ] || fail "preflight wrote into the repository object database"

printf 'dirty\n' >>"$epic_path/README"
dirty_preflight="$(run_manage preflight --epic 270 --json)"
[ "$(jq -r '.workspace.clean' <<<"$dirty_preflight")" = false ] || fail "dirty epic was reported clean"
set +e
dirty_sync="$(run_manage sync --epic 270 --apply --json 2>&1)"
dirty_sync_status=$?
set -e
[ "$dirty_sync_status" -eq 65 ] || fail "sync accepted uncommitted work"
assert_contains "$dirty_sync" "uncommitted epic work"
git -C "$epic_path" checkout -- README

sync_plan="$(run_manage sync --epic 270 --json)"
[ "$(jq -r '.action' <<<"$sync_plan")" = sync ] || fail "sync plan action missing"
[ "$(jq -r '.strategy' <<<"$sync_plan")" = merge ] || fail "default sync strategy changed"
[ "$(jq -r '.applied' <<<"$sync_plan")" = false ] || fail "sync mutated without --apply"
[ "$(git -C "$epic_path" rev-parse HEAD)" = "$epic_before" ] || fail "dry-run sync moved epic HEAD"

set +e
pushed_rebase="$(run_manage sync --epic 270 --strategy rebase --json 2>&1)"
pushed_rebase_status=$?
set -e
[ "$pushed_rebase_status" -eq 65 ] || fail "rebase plan accepted a pushed epic branch"
assert_contains "$pushed_rebase" "refusing to rebase pushed epic branch"
git -C "$primary_repo" push --quiet origin :epic-270
git -C "$primary_repo" branch --set-upstream-to=origin/roster epic-270 >/dev/null
[ "$(git -C "$primary_repo" for-each-ref --format='%(upstream:short)' refs/heads/epic-270)" = origin/roster ] \
    || fail "fixture did not configure target-branch upstream"

backup_repo="$fixture_root/backup.git"
backup_push_repo="$fixture_root/backup-push.git"
git init --quiet --bare "$backup_repo"
git init --quiet --bare "$backup_push_repo"
git -C "$primary_repo" remote add backup "$backup_repo"
git -C "$primary_repo" remote set-url --add --push backup "$backup_push_repo"
git -C "$primary_repo" push --quiet backup epic-270
set +e
backup_rebase="$(run_manage sync --epic 270 --strategy rebase --json 2>&1)"
backup_rebase_status=$?
set -e
[ "$backup_rebase_status" -eq 65 ] || fail "rebase plan ignored a non-origin pushed epic branch"
assert_contains "$backup_rebase" "backup:refs/heads/epic-270"
git -C "$primary_repo" push --quiet backup :epic-270

rebase_plan="$(run_manage sync --epic 270 --strategy rebase --json)"
[ "$(jq -r '.strategy' <<<"$rebase_plan")" = rebase ] || fail "rebase plan strategy missing"
[ "$(jq -r '.rebaseSafety.eligible' <<<"$rebase_plan")" = true ] \
    || fail "target-tracking unpushed epic was not eligible"
[ "$(jq -r '.rebaseSafety.checked | length' <<<"$rebase_plan")" -eq 3 ] \
    || fail "rebase plan did not inspect all fetch and push endpoints"

run_manage sync --epic 270 --strategy rebase --apply --json >/dev/null
git -C "$epic_path" merge-base --is-ancestor roster HEAD || fail "rebase sync did not place epic on target"
[ "$(git -C "$epic_path" rev-list --parents -n1 HEAD | awk '{print NF}')" -eq 2 ] \
    || fail "rebase sync did not preserve linear epic history"
subissue_commit="$(git -C "$epic_path" rev-parse HEAD)"

set +e
cleanup_before_integration="$(run_manage cleanup --epic 270 --approve --json 2>&1)"
cleanup_before_status=$?
set -e
[ "$cleanup_before_status" -eq 65 ] || fail "cleanup accepted unintegrated commits"
assert_contains "$cleanup_before_integration" "unintegrated"

integrate_plan="$(run_manage integrate --epic 270 --mode ff-only --json)"
[ "$(jq -r '.action' <<<"$integrate_plan")" = integrate ] || fail "integration plan action missing"
[ "$(jq -r '.mergeMode' <<<"$integrate_plan")" = --ff-only ] || fail "integration plan mode missing"
[ "$(jq -r '.applied' <<<"$integrate_plan")" = false ] || fail "integration mutated without approval"
target_before_integration="$(git -C "$primary_repo" rev-parse HEAD)"
run_manage integrate --epic 270 --mode ff-only --approve --json >/dev/null
integration_commit="$(git -C "$primary_repo" rev-parse HEAD)"
[ "$integration_commit" != "$target_before_integration" ] || fail "approved integration did not move target"
[ "$integration_commit" = "$(git -C "$epic_path" rev-parse HEAD)" ] || fail "integration was not a fast-forward"
git -C "$primary_repo" merge-base --is-ancestor "$subissue_commit" HEAD || fail "integration lost sub-issue commit"
set +e
worktree_cleanup="$(cd "$epic_path" && PATH="$fake_bin:$PATH" EPIC_WORKTREE_COMMAND="$registry_command" bash "$manage_command" cleanup --epic 270 --json 2>&1)"
worktree_cleanup_status=$?
set -e
[ "$worktree_cleanup_status" -eq 65 ] || fail "cleanup ran outside the coordinator target checkout"
assert_contains "$worktree_cleanup" "cleanup must run from the recorded target checkout"

state_dir="$epic_path/.devenv/agent"
mkdir -p "$state_dir"
(cd "$epic_path" && exec sleep 300) &
runtime_pid=$!
printf '%s\n' "$runtime_pid" >"$state_dir/devenv.pid"
active_cleanup="$(run_manage cleanup --epic 270 --json)"
[ "$(jq '.runtime.active | length' <<<"$active_cleanup")" -eq 1 ] || fail "cleanup dry-run omitted active runtime"
kill -0 "$runtime_pid" 2>/dev/null || fail "cleanup dry-run terminated active runtime"
kill "$runtime_pid"
wait "$runtime_pid" 2>/dev/null || true
runtime_pid=""
rm -f "$state_dir/devenv.pid"

workspace_id="$(printf '%s' "$epic_path" | sha256sum | cut -c1-12)"
explicit_epic_state="$fixture_root/caller-state/workspace-$workspace_id"
mkdir -p "$explicit_epic_state"
(cd "$epic_path" && exec sleep 300) &
runtime_pid=$!
printf '%s\n' "$runtime_pid" >"$explicit_epic_state/devenv.pid"
configured_cleanup="$(run_manage_from_configured_caller cleanup --epic 270 --json)"
[ "$(jq '.runtime.active | length' <<<"$configured_cleanup")" -eq 1 ] || fail "cleanup missed caller-configured active runtime"
kill -0 "$runtime_pid" 2>/dev/null || fail "configured cleanup dry-run terminated active runtime"
kill "$runtime_pid"
wait "$runtime_pid" 2>/dev/null || true
runtime_pid=""
rm -f "$explicit_epic_state/devenv.pid"

cleanup_plan="$(run_manage cleanup --epic 270 --json)"
[ "$(jq -r '.action' <<<"$cleanup_plan")" = cleanup ] || fail "cleanup plan action missing"
[ "$(jq -r '.applied' <<<"$cleanup_plan")" = false ] || fail "cleanup mutated without approval"
[ -d "$epic_path" ] || fail "dry-run cleanup removed worktree"

(cd "$epic_path" && exec sleep 300) &
runtime_pid=$!
printf '%s\n' "$runtime_pid" >"$state_dir/devenv.pid"
git -C "$primary_repo" update-ref -d refs/remotes/origin/epic-270
git -C "$primary_repo" show-ref --verify --quiet refs/remotes/origin/epic-270 \
    && fail "fixture retained the remote-tracking ref"
run_manage cleanup --epic 270 --approve --json >/dev/null
if kill -0 "$runtime_pid" 2>/dev/null; then
    fail "approved cleanup left tracked runtime alive"
fi
wait "$runtime_pid" 2>/dev/null || true
runtime_pid=""
[ ! -e "$epic_path" ] || fail "approved cleanup left worktree behind"
if git -C "$primary_repo" show-ref --verify --quiet refs/heads/epic-270; then
    fail "approved cleanup left epic branch behind"
fi
registry_file="$(git -C "$primary_repo" rev-parse --path-format=absolute --git-common-dir)/bepis/epic-worktrees/registry.json"
[ "$(jq '.workspaces | length' "$registry_file")" = 0 ] || fail "approved cleanup left registry entry"
[ -z "$(git -C "$primary_repo" ls-remote --heads origin epic-270)" ] || fail "approved cleanup left integrated remote branch"
[ "$(git -C "$primary_repo" symbolic-ref --short HEAD)" = roster ] || fail "cleanup changed target branch"

# Conflict preflight must be non-mutating and failed sync must explain canonical regeneration.
conflict_path="$fixture_root/repo-epic-271"
git -C "$primary_repo" branch epic-271
git -C "$primary_repo" worktree add --quiet "$conflict_path" epic-271
(
    cd "$conflict_path"
    bash "$registry_command" register --epic 271 --target roster >/dev/null
)
printf 'epic conflict\n' >"$conflict_path/README"
git -C "$conflict_path" add README
git -C "$conflict_path" commit --quiet -m 'Epic conflict (#271)'
printf 'target conflict\n' >"$primary_repo/README"
git -C "$primary_repo" add README
git -C "$primary_repo" commit --quiet -m 'Target conflict'
conflict_epic_before="$(git -C "$conflict_path" rev-parse HEAD)"
conflict_target_before="$(git -C "$primary_repo" rev-parse HEAD)"
conflict_preflight="$(run_manage preflight --epic 271 --json)"
[ "$(jq -r '.conflicts.detected' <<<"$conflict_preflight")" = true ] || fail "preflight missed merge conflict"
[ "$(git -C "$conflict_path" rev-parse HEAD)" = "$conflict_epic_before" ] || fail "conflict preflight moved epic HEAD"
[ "$(git -C "$primary_repo" rev-parse HEAD)" = "$conflict_target_before" ] || fail "conflict preflight moved target HEAD"
set +e
conflict_output="$(run_manage sync --epic 271 --apply --json 2>&1)"
conflict_status=$?
set -e
[ "$conflict_status" -ne 0 ] || fail "conflicting sync unexpectedly succeeded"
assert_contains "$conflict_output" "canonical-source resolution followed by regeneration"
git -C "$conflict_path" merge --abort

# An absent stale worktree can be safely recovered after ancestry proves integration.
stale_path="$fixture_root/repo-epic-272"
git -C "$primary_repo" branch epic-272
git -C "$primary_repo" worktree add --quiet "$stale_path" epic-272
(
    cd "$stale_path"
    bash "$registry_command" register --epic 272 --target roster >/dev/null
)
git -C "$primary_repo" worktree remove "$stale_path"
run_manage cleanup --epic 272 --approve --json >/dev/null
if git -C "$primary_repo" show-ref --verify --quiet refs/heads/epic-272; then
    fail "stale cleanup left integrated branch behind"
fi
[ "$(jq '[.workspaces[].epic] | index(272)' "$registry_file")" = null ] || fail "stale cleanup left registry entry"

# Missing branch means integration can no longer be proven; retain recovery metadata.
missing_branch_path="$fixture_root/repo-epic-273"
git -C "$primary_repo" branch epic-273
git -C "$primary_repo" worktree add --quiet "$missing_branch_path" epic-273
(
    cd "$missing_branch_path"
    bash "$registry_command" register --epic 273 --target roster >/dev/null
)
git -C "$primary_repo" worktree remove "$missing_branch_path"
git -C "$primary_repo" branch -D epic-273 >/dev/null
set +e
missing_branch_cleanup="$(run_manage cleanup --epic 273 --approve --json 2>&1)"
missing_branch_status=$?
set -e
[ "$missing_branch_status" -eq 65 ] || fail "cleanup discarded registry without integration evidence"
assert_contains "$missing_branch_cleanup" "cannot prove integration"
[ "$(jq '[.workspaces[].epic] | index(273) != null' "$registry_file")" = true ] || fail "failed cleanup discarded recovery metadata"

echo "epic-worktree-manage-test: ok"
