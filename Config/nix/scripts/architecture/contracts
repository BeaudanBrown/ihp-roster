#!/usr/bin/env bash
set -euo pipefail
repo_root="${ARCHITECTURE_REPO_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
cd "$repo_root"

# shellcheck source=../lib/ghc.sh
. "${BEPIS_SCRIPTS_ROOT:?}/lib/ghc.sh"
# shellcheck source=../frontend/tool-package-lib
. "${BEPIS_SCRIPTS_ROOT:?}/frontend/tool-package-lib"

output_path="${1:-output/architecture/bepis-contracts.json}"

build_dir="${ARCHITECTURE_CONTRACTS_BUILD_DIR:-$(ihp_roster_verification_build_dir)}"

# Match typecheck/Hspec options so this generator reuses their application
# artifacts instead of recompiling the graph into a disposable directory.
mkdir -p "$(dirname "$output_path")"
snapshot_dir=""
tmp_output=""
trap 'rm -f -- "$tmp_output"; if [ -n "$snapshot_dir" ]; then rm -rf -- "$snapshot_dir"; fi' EXIT
if generator="$(frontend_contract_tool_binary generate-bepis-architecture-contracts)"; then
    echo "architecture-contracts: using isolated tooling package" >&2
else
    GHC_OPTS="$(ihp_roster_ghc_opts) -iTest"
    snapshot_dir="$(mktemp -d)"
    generator="$snapshot_dir/generate-bepis-architecture-contracts"
    bash "$BEPIS_SCRIPTS_ROOT/haskell/ghc-build-run" "$build_dir" "$GHC_OPTS" architecture-build-lock -- \
        bash "$BEPIS_SCRIPTS_ROOT/architecture/build-image" "$build_dir" "$GHC_OPTS" "$generator"
fi

tmp_output="$(mktemp "$(dirname "$output_path")/.bepis-contracts.json.XXXXXX")"
"$generator" "$tmp_output"

if [ -f "$output_path" ] && cmp -s "$tmp_output" "$output_path"; then
    rm -f "$tmp_output"
else
    mv "$tmp_output" "$output_path"
fi
