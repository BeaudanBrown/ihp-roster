#!/usr/bin/env bash
set -euo pipefail
bash ./Config/nix/scripts/architecture/contracts >/dev/null
node scripts/architecture/facts.mjs >/dev/null
node scripts/architecture/schema.mjs >/dev/null
node scripts/architecture/web-map.mjs >/dev/null
node scripts/architecture/module-graph.mjs >/dev/null
node scripts/architecture/gate.mjs >/dev/null
printf '%s\n' '{"name":"conventions","args":{"failOnViolations":true,"requireAllControllers":true}}' | node scripts/architecture/query.mjs >/dev/null
echo "Architecture generation and strict Bepis convention checks succeeded. Outputs are under output/architecture/."
