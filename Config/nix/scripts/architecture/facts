#!/usr/bin/env bash
set -euo pipefail

if [ "${ARCHITECTURE_CONTRACTS_CURRENT:-0}" != "1" ]; then
    if [ -f "@scriptsRoot@/architecture/contracts" ]; then
        bash "@scriptsRoot@/architecture/contracts" >/dev/null
    else
        bash "Config/nix/scripts/architecture/contracts" >/dev/null
    fi
fi

node scripts/architecture/facts.mjs "$@"
