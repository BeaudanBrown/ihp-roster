#!/usr/bin/env bash
set -euo pipefail

node scripts/architecture/email-transport.mjs >/dev/null
node scripts/architecture/fixture-reset-manifest.mjs >/dev/null
node scripts/production-inventory.mjs --check >/dev/null
bash "${BEPIS_SCRIPTS_ROOT:?}/architecture/facts" >/dev/null
# Real generated-contract query wiring belongs beside fresh facts, not pure query fixtures.
printf '%s\n' '{"name":"generated-contracts","args":{"target":"roster"}}' \
    | node scripts/architecture/query.mjs \
    | node -e 'const r=JSON.parse(require("fs").readFileSync(0,"utf8")); require("assert").equal(r.metrics.selectedSurfaces,1)'
node scripts/architecture/surface-request-closure.mjs >/dev/null
# Blocking checks validate deterministic DOT without paying for ignored SVGs.
ARCHITECTURE_FACTS_CURRENT=1 ARCHITECTURE_RENDER_SVG=0 ARCHITECTURE_VERIFY_DOT_DETERMINISM=1 node scripts/architecture/schema.mjs >/dev/null
ARCHITECTURE_FACTS_CURRENT=1 ARCHITECTURE_RENDER_SVG=0 ARCHITECTURE_VERIFY_DOT_DETERMINISM=1 node scripts/architecture/web-map.mjs >/dev/null
ARCHITECTURE_FACTS_CURRENT=1 ARCHITECTURE_RENDER_SVG=0 ARCHITECTURE_VERIFY_DOT_DETERMINISM=1 node scripts/architecture/module-graph.mjs >/dev/null
node scripts/architecture/gate.mjs >/dev/null
printf '%s\n' '{"name":"conventions","args":{"failOnViolations":true,"requireAllControllers":true}}' | node scripts/architecture/query.mjs >/dev/null
echo "Architecture repository checks succeeded. Outputs are under output/architecture/."
