#!/usr/bin/env bash
# See https://github.com/cachix/devenv/blob/main/templates/flake-parts/.envrc

if ! has nix_direnv_version || ! nix_direnv_version 3.1.0; then
    source_url "https://raw.githubusercontent.com/nix-community/nix-direnv/3.1.0/direnvrc" "sha256-yMJ2OVMzrFaDPn7q8nCBZFRYpL/f0RcHzhmw/i6btJM="
fi

export DEVENV_IN_DIRENV_SHELL=true
export IHP_TELEMETRY_DISABLED="${IHP_TELEMETRY_DISABLED:-1}"
# In restricted environments ~/.cache can be read-only; use a writable cache
# so nix/direnv evaluation doesn't fail on fetcher-cache sqlite writes.
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-/tmp/nix-cache}"
mkdir -p "$XDG_CACHE_HOME"

watch_file flake.nix
watch_file flake.lock
watch_file .env
watch_file App.cabal

# Materialized project commands delegate to Config/nix/scripts in the working
# tree, so script-body edits do not require rebuilding the shell. The Nix
# declarations that add commands or dependencies remain watched.
while IFS= read -r file; do
    watch_file "$file"
done < <(find Config/nix/flake Config/nix/modules Config/nix/hosts -type f)

mkdir -p "$PWD/.devenv"
DEVENV_ROOT_FILE="$PWD/.devenv/root"
if [ ! -f "$DEVENV_ROOT_FILE" ] || [ "$(cat "$DEVENV_ROOT_FILE")" != "$PWD" ]; then
    printf %s "$PWD" >"$DEVENV_ROOT_FILE"
fi

flake_args=(
    --override-input devenv-root "file+file://$DEVENV_ROOT_FILE"
    --accept-flake-config
)

if ! use flake . "${flake_args[@]}"; then
    echo "devenv could not be built. The devenv environment was not loaded. Make the necessary changes to devenv.nix and hit enter to try again." >&2
fi

# Include .env file if it exists locally. Use the .env file to load env vars that you don't want to commit to git.
if [ -f .env ]; then
    set -o allexport
    source .env
    set +o allexport
fi

# SMTP config for local development.
export SMTP_HOST="127.0.0.1"
export SMTP_PORT="1025"
export SMTP_ENCRYPTION="Unencrypted"

# Make generic shell tools (`psql`, IHP commands, `just dev`) use the same
# checkout-scoped managed development authority as dev-start. This runs after
# .env deliberately: inherited PGHOST/DATABASE_URL cannot silently replace the
# managed profile. Explicit external mode is resolved by workspace tooling.
if command -v dev-workspace-info >/dev/null 2>&1; then
    eval "$(dev-workspace-info --shell)"
fi
