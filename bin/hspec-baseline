    "profile-load",
    "test-db-reset",
    "/db/test-postgres ",
    "-test-postgres/bin/test-postgres",
    "/k6 ",
)
SUITE_PATTERN = re.compile(
    r'^\s*(?:\[|,)\s*(pureSuite|databaseSuite)\s+[\s\S]*?SuiteDefinition\s*\{([\s\S]*?)\}\s+([A-Za-z][A-Za-z0-9_.]+)\.(tests|pureTests|databaseTests)\s*$',
    re.MULTILINE,
)
SUITE_LABEL_PATTERN = re.compile(r'definitionLabel\s*=\s*"([^"]+)"')
SUITE_WEIGHT_PATTERN = re.compile(r"definitionEstimatedRuntimeSeconds\s*=\s*(\d+(?:\.\d+)?)")
PURE_DATABASE_CALL_PATTERN = re.compile(
    r"\b(withCleanDb|withDatabaseTestContext|withMockContext|mockContextNoDatabase|"
    r"testContext|withContext|withControllerTestContext|withCurrentControllerContext|"
    r"withUser|withUserAndCurrentVenue|callAction|callActionWithParams)\b"
)
