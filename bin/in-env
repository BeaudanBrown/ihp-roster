#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

if [ "$#" -eq 0 ]; then
    echo "usage: bash ./bin/in-env <command> [args...]" >&2
    exit 64
fi

# Keep nix/direnv fetcher cache writable in restricted environments.
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-/tmp/nix-cache}"
export IHP_TELEMETRY_DISABLED="${IHP_TELEMETRY_DISABLED:-1}"
mkdir -p "$XDG_CACHE_HOME"

if [ "${DEVENV_IN_DIRENV_SHELL:-}" = "true" ]; then
    if command -v "$1" >/dev/null 2>&1 && command -v ghc-pkg >/dev/null 2>&1 && ghc-pkg list ihp 2>/dev/null | grep -q 'ihp-'; then
        exec "$@"
    fi
fi

if command -v direnv >/dev/null 2>&1 && [ -f "$REPO_ROOT/.envrc" ]; then
    exec direnv exec "$REPO_ROOT" "$@"
fi

if command -v nix >/dev/null 2>&1 && [ -f "$REPO_ROOT/flake.nix" ]; then
    cd "$REPO_ROOT"
    exec nix develop . --accept-flake-config --command "$@"
fi

cat >&2 <<'EOF'
Unable to enter the project environment.

Expected one of:
- direnv with a repo .envrc
- nix with a repo flake.nix

From a shell with direnv enabled, run `direnv allow` in the repo root once.
EOF
exit 1
