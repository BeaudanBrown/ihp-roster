#!/usr/bin/env bash
set -euo pipefail

TIMEOUT="${AGENT_HSPEC_TIMEOUT:-20m}"
STARTED_DEV=0

cleanup() {
    local status=$?
    trap - EXIT INT TERM
    if [ "$STARTED_DEV" = "1" ]; then
        dev-stop || true
    fi
    exit "$status"
}
trap cleanup EXIT INT TERM

if ! dev-status >/dev/null 2>&1; then
    dev-start
    STARTED_DEV=1
fi
dev-wait "${DEV_WAIT_TIMEOUT:-90}"

if command -v timeout >/dev/null 2>&1; then
    timeout --kill-after="${AGENT_HSPEC_KILL_AFTER:-30s}" "$TIMEOUT" hspec-test "$@"
else
    echo "warning: timeout command not found; running hspec-test without wall-clock guard" >&2
    hspec-test "$@"
fi
