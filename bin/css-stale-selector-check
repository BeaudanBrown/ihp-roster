#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

declare -A dynamic_or_external_classes=(
  [app-region-transition-fade]='constructed from the reflected transition profile'
  [app-region-transition-fade-slide]='constructed from the reflected transition profile'
  [app-region-transition-panel]='constructed from the reflected transition profile'
  [app-week-toolbar-roster]='constructed by the typed week-toolbar variant renderer'
  [app-week-toolbar-timesheets]='constructed by the typed week-toolbar variant renderer'
  [htmx-request]='owned by the vendored HTMX request lifecycle'
)

failures=0
while IFS= read -r class_name; do
  case "$class_name" in
    app|btn|btn-*|form-*|nav-*|navbar*|breadcrumb*|table*|dropdown*|modal*|container*|row|col|col-*|d-*|text-*|bg-*|border*|badge*|alert*|card*|list-*|input-*|w-*|h-*|m-*|p-*|gap-*|align-*|justify-*|shadow*|rounded*|small|visually-hidden)
      continue
      ;;
  esac

  if [[ -n "${dynamic_or_external_classes[$class_name]:-}" ]]; then
    continue
  fi

  if rg --quiet --fixed-strings "$class_name" Web Application frontend/ts static \
      --glob '!*.css' \
      --glob '!frontend/ts/tests/**' \
      --glob '!static/vendor/**' \
      --glob '!static/prod.css'; then
    continue
  fi

  source="$(rg -n --fixed-strings ".$class_name" static --glob '*.css' --glob '!static/vendor/**' --glob '!static/prod.css' | head -n 1)"
  echo "css-stale-selector-check: .$class_name has no production owner ($source)" >&2
  failures=$((failures + 1))
done < <(
  rg --no-filename --only-matching '\.[A-Za-z_][A-Za-z0-9_-]*' static \
    --glob '*.css' \
    --glob '!static/vendor/**' \
    --glob '!static/prod.css' \
    | sed 's/^\.//' \
    | sort -u
)

if (( failures > 0 )); then
  exit 1
fi

echo "css-stale-selector-check: ok"
