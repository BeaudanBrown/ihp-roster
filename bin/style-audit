#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

line_budget="${CSS_LINE_BUDGET:-1000}"

# Raw colour definitions are only allowed in files that own tokens, persisted
# palettes, or Bootstrap variable bridging.
raw_color_allowed_files=(
  static/css/tokens.css
  static/css/palette.css
  static/css/bootstrap-bridge.css
)

# No app-owned CSS source files should be left unlinked. Keep this list empty
# unless a ticket documents a deliberate non-runtime stylesheet exception.
unlinked_app_css_allowlist=()

scan_files=(
  static
  Web
  Application/Helper
)

tmp_dir="$(mktemp -d)"
trap 'rm -rf "$tmp_dir"' EXIT

defined="$tmp_dir/defined.txt"
used="$tmp_dir/used.txt"
undefined="$tmp_dir/undefined.txt"
missing_assets="$tmp_dir/missing-assets.txt"
missing_makefile_entries="$tmp_dir/missing-makefile-entries.txt"
unlinked_app_css="$tmp_dir/unlinked-app-css.txt"
makefile_missing_app_css="$tmp_dir/makefile-missing-app-css.txt"
ihp_css_assets="$tmp_dir/ihp-css-assets.txt"
oversized_css="$tmp_dir/oversized-css.txt"
raw_colors="$tmp_dir/raw-colors.txt"
raw_color_allowed_pattern="$tmp_dir/raw-color-allowed-pattern.txt"
feature_global_selectors="$tmp_dir/feature-global-selectors.txt"
feature_global_selector_allowlist="$tmp_dir/feature-global-selector-allowlist.txt"
unexpected_feature_global_selectors="$tmp_dir/unexpected-feature-global-selectors.txt"
banned_imports="$tmp_dir/banned-imports.txt"
light_bootstrap_utilities="$tmp_dir/light-bootstrap-utilities.txt"
inline_styles="$tmp_dir/inline-styles.txt"

printf '' > "$missing_assets"
printf '' > "$missing_makefile_entries"
printf '' > "$unlinked_app_css"
printf '' > "$makefile_missing_app_css"
printf '' > "$oversized_css"
printf '' > "$raw_colors"
printf '' > "$feature_global_selectors"
printf '' > "$unexpected_feature_global_selectors"
printf '' > "$banned_imports"
printf '' > "$light_bootstrap_utilities"
printf '' > "$inline_styles"

cat > "$ihp_css_assets" <<'EOF'
/vendor/flatpickr.min.css
EOF

cat > "$feature_global_selector_allowlist" <<'EOF'
^static/css/features/leave\.css:[0-9]+:[[:space:]]+\.leave-request-row-actions \.btn \{$
^static/css/features/roster/grid-cells\.css:[0-9]+:\.roster-grid \.form-control-sm,$
^static/css/features/roster/grid-cells\.css:[0-9]+:\.roster-grid \.form-select-sm \{$
^static/css/features/roster/grid-cells\.css:[0-9]+:\.roster-layout-mode-group \.btn \{$
^static/css/features/roster/grid-frame\.css:[0-9]+:[[:space:]]+main\.app-content:has\(\.roster-grid-frame\) \{$
^static/css/features/roster/responsive\.css:[0-9]+:[[:space:]]+\.app-auth-body \{$
^static/css/features/roster/responsive\.css:[0-9]+:[[:space:]]+\.app-content \{$
^static/css/features/roster/responsive\.css:[0-9]+:[[:space:]]+\.app-page \{$
^static/css/features/roster/responsive\.css:[0-9]+:[[:space:]]+\.app-panel-body,$
^static/css/features/roster/responsive\.css:[0-9]+:[[:space:]]+\.app-panel-header,$
^static/css/features/roster/responsive\.css:[0-9]+:[[:space:]]+\.roster-grid-header \.dropdown-menu \{$
^static/css/features/roster/responsive\.css:[0-9]+:[[:space:]]+\.roster-staff-panel \.app-panel-body \{$
^static/css/features/roster/staff-panel\.css:[0-9]+:[[:space:]]+\.roster-staff-panel \.app-panel-body \{$
^static/css/features/roster/staff-panel\.css:[0-9]+:\.roster-quick-tool-panel \.app-form-width \{$
^static/css/features/roster/staff-panel\.css:[0-9]+:\.roster-staff-panel \.app-panel-body \{$
^static/css/features/timesheets\.css:[0-9]+:\.timesheet-entry-actions \.btn,$
^static/css/features/timesheets\.css:[0-9]+:\.timesheet-entry-actions \.btn \{$
EOF

array_contains() {
  local wanted="$1"
  shift
  local candidate
  for candidate in "$@"; do
    if [[ "$candidate" == "$wanted" ]]; then
      return 0
    fi
  done
  return 1
}

makefile_has_entry() {
  local wanted="$1"
  array_contains "$wanted" "${makefile_css_files[@]}"
}

linked_assets_has_entry() {
  local wanted="$1"
  array_contains "$wanted" "${linked_css_assets[@]}"
}

rg --no-heading --only-matching --replace '$2' --glob '!static/vendor/**' '(^|[;{"'\''[:space:]])(--[A-Za-z0-9_-]+)[[:space:]]*:' "${scan_files[@]}" \
  | sed 's/^.*://' \
  | sort -u > "$defined"

rg --no-heading --only-matching --replace '$1' --glob '!static/vendor/**' 'var\((--[A-Za-z0-9_-]+)' "${scan_files[@]}" \
  | sed 's/^.*://' \
  | sort -u > "$used"

comm -23 "$used" "$defined" \
  | rg -v '^--bs-' > "$undefined" || true

echo "style-audit hard gate: undefined CSS variables"
if [[ -s "$undefined" ]]; then
  sed 's/^/  /' "$undefined"
else
  echo "  none"
fi

echo
echo "style-audit hard gate: layout stylesheet assets"
mapfile -t linked_css_assets < <(
  rg --only-matching --replace '$1' 'assetPath "([^"]+\.css)"' Web/View/Layout.hs \
    | sed 's/^.*://' \
    | sort -u
)

mapfile -t makefile_css_files < <(
  rg --only-matching --replace '$1' '^CSS_FILES \+= (.+\.css)$' Makefile \
    | sed 's/^.*://' \
    | sort -u
)

mapfile -t app_css_files < <(
  find static -type f -name '*.css' \
    ! -path 'static/vendor/*' \
    ! -path 'static/vendor/**' \
    ! -path 'static/prod.css' \
    | sort
)

for asset in "${linked_css_assets[@]}"; do
  asset_file="static${asset}"
  ihp_static_asset_file="${IHP:-}/static${asset}"
  ihp_lib_asset_file="${IHP:-}/lib/IHP${asset}"
  ihp_dev_asset_file="${IHP_DEV_CHECKOUT:-}/ihp/data/static${asset}"
  is_ihp_asset=false
  if rg -qx --fixed-strings "$asset" "$ihp_css_assets"; then
    is_ihp_asset=true
  fi

  if [[ ! -f "$asset_file" && "$is_ihp_asset" != true && ! -f "$ihp_static_asset_file" && ! -f "$ihp_lib_asset_file" && ! -f "$ihp_dev_asset_file" ]]; then
    echo "$asset -> $asset_file" >> "$missing_assets"
  fi

  makefile_entry="${asset#/}"
  local_makefile_entry="static/${makefile_entry}"
  ihp_makefile_entry="\${IHP}/static/${makefile_entry}"
  if ! makefile_has_entry "$local_makefile_entry" && ! makefile_has_entry "$ihp_makefile_entry"; then
    echo "$asset -> static/${makefile_entry}" >> "$missing_makefile_entries"
  fi
done

for css_file in "${app_css_files[@]}"; do
  if array_contains "$css_file" "${unlinked_app_css_allowlist[@]}"; then
    continue
  fi

  asset="/${css_file#static/}"
  if ! linked_assets_has_entry "$asset"; then
    echo "$css_file -> assetPath \"$asset\"" >> "$unlinked_app_css"
  fi

  if ! makefile_has_entry "$css_file"; then
    echo "$css_file" >> "$makefile_missing_app_css"
  fi
done

if [[ -s "$missing_assets" ]]; then
  echo "  missing files:"
  sed 's/^/    /' "$missing_assets"
else
  echo "  all linked local stylesheets exist"
fi

if [[ -s "$missing_makefile_entries" ]]; then
  echo "  linked stylesheets missing Makefile CSS_FILES entries:"
  sed 's/^/    /' "$missing_makefile_entries"
else
  echo "  all linked local stylesheets are in CSS_FILES"
fi

if [[ -s "$unlinked_app_css" ]]; then
  echo "  app-owned CSS files not linked from Layout.hs:"
  sed 's/^/    /' "$unlinked_app_css"
else
  echo "  all non-allowlisted app-owned CSS files are linked from Layout.hs"
fi

if [[ -s "$makefile_missing_app_css" ]]; then
  echo "  app-owned CSS files missing Makefile CSS_FILES entries:"
  sed 's/^/    /' "$makefile_missing_app_css"
else
  echo "  all non-allowlisted app-owned CSS files are in CSS_FILES"
fi

echo
echo "style-audit hard gate: app-owned CSS @import usage"
rg -n '@import' static \
  --glob '*.css' \
  --glob '!static/vendor/**' \
  --glob '!static/prod.css' > "$banned_imports" \
  || true
if [[ -s "$banned_imports" ]]; then
  sed 's/^/  /' "$banned_imports"
else
  echo "  none"
fi

echo
echo "style-audit hard gate: CSS file size budget (${line_budget} lines/file)"
for css_file in "${app_css_files[@]}"; do
  lines="$(wc -l < "$css_file" | tr -d ' ')"
  if (( lines > line_budget )); then
    printf '%5d %s\n' "$lines" "$css_file" >> "$oversized_css"
  fi
done
if [[ -s "$oversized_css" ]]; then
  sed 's/^/  /' "$oversized_css"
else
  echo "  none over budget"
fi

printf '^(%s):' "$(printf '%s|' "${raw_color_allowed_files[@]}" | sed 's/|$//; s#/#\\/#g; s#\.#\\.#g')" > "$raw_color_allowed_pattern"

echo
echo "style-audit hard gate: raw colors outside token/palette/bridge files"
rg -n '#[0-9A-Fa-f]{3,8}|rgba?\(|hsla?\(' static \
  --glob '*.css' \
  --glob '!static/vendor/**' \
  --glob '!static/prod.css' \
  | rg -v -f "$raw_color_allowed_pattern" > "$raw_colors" \
  || true
if [[ -s "$raw_colors" ]]; then
  sed 's/^/  /' "$raw_colors"
else
  echo "  none"
fi

echo
echo "style-audit hard gate: unexpected app/global/Bootstrap selectors in feature CSS"
rg -n '^\s*[^{}@]*\.(app-[[:alnum:]_-]*|btn[[:alnum:]_-]*|form-[[:alnum:]_-]*|nav-[[:alnum:]_-]*|breadcrumb[[:alnum:]_-]*|table[[:alnum:]_-]*|dropdown[[:alnum:]_-]*|modal[[:alnum:]_-]*)' static/css/features \
  --glob '*.css' > "$feature_global_selectors" \
  || true
if [[ -s "$feature_global_selectors" ]]; then
  rg -v -f "$feature_global_selector_allowlist" "$feature_global_selectors" > "$unexpected_feature_global_selectors" || true
fi
if [[ -s "$unexpected_feature_global_selectors" ]]; then
  sed 's/^/  /' "$unexpected_feature_global_selectors"
else
  echo "  none"
fi

echo
echo "style-audit review only: banned light-mode Bootstrap utilities in HSX"
rg -n 'bg-white|bg-light|bg-light-subtle|text-muted|text-body-secondary' Web Application --glob '*.hs' > "$light_bootstrap_utilities" \
  || true
if [[ -s "$light_bootstrap_utilities" ]]; then
  sed 's/^/  /' "$light_bootstrap_utilities"
else
  echo "  none"
fi

echo
echo "style-audit review only: inline style attributes requiring review"
rg -n 'style=' Web Application --glob '*.hs' \
  | rg -v 'style=\{"--|style=\{\("width: var\(|timesheetMidnightStyle|segmentLeft|segmentWidth' > "$inline_styles" \
  || true
if [[ -s "$inline_styles" ]]; then
  sed 's/^/  /' "$inline_styles"
else
  echo "  none"
fi

failed_gates=()
[[ -s "$undefined" ]] && failed_gates+=("undefined CSS variables")
[[ -s "$missing_assets" ]] && failed_gates+=("missing linked stylesheet files")
[[ -s "$missing_makefile_entries" ]] && failed_gates+=("linked stylesheets missing Makefile CSS_FILES entries")
[[ -s "$unlinked_app_css" ]] && failed_gates+=("unlinked app-owned CSS files")
[[ -s "$makefile_missing_app_css" ]] && failed_gates+=("app-owned CSS files missing Makefile CSS_FILES entries")
[[ -s "$banned_imports" ]] && failed_gates+=("app-owned CSS @import usage")
[[ -s "$oversized_css" ]] && failed_gates+=("CSS files over line budget")
[[ -s "$raw_colors" ]] && failed_gates+=("raw colors outside token/palette/bridge files")
[[ -s "$unexpected_feature_global_selectors" ]] && failed_gates+=("unexpected app/global/Bootstrap selectors in feature CSS")

if (( ${#failed_gates[@]} > 0 )); then
  echo
  echo "style-audit failed hard gates:"
  printf '  %s\n' "${failed_gates[@]}"
  exit 1
fi

echo
echo "style-audit hard gates passed"
