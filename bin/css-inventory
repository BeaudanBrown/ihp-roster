#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

line_budget="${CSS_LINE_BUDGET:-1000}"
warning_limit="${CSS_INVENTORY_LIMIT:-80}"

tmp_dir="$(mktemp -d)"
trap 'rm -rf "$tmp_dir"' EXIT

line_counts="$tmp_dir/line-counts.txt"
raw_colors="$tmp_dir/raw-colors.txt"
global_selectors="$tmp_dir/global-selectors.txt"
stale_candidates="$tmp_dir/stale-candidates.txt"
missing_assets="$tmp_dir/missing-assets.txt"
missing_makefile_entries="$tmp_dir/missing-makefile-entries.txt"

printf '' > "$line_counts"
printf '' > "$missing_assets"
printf '' > "$missing_makefile_entries"

mapfile -t app_css_files < <(
  find static -type f -name '*.css' \
    ! -path 'static/vendor/*' \
    ! -path 'static/vendor/**' \
    ! -path 'static/prod.css' \
    | sort
)

total_lines=0
for css_file in "${app_css_files[@]}"; do
  lines="$(wc -l < "$css_file" | tr -d ' ')"
  total_lines=$((total_lines + lines))
  printf '%s %s\n' "$lines" "$css_file" >> "$line_counts"
done

echo "css-inventory: app-owned CSS line counts (budget: ${line_budget} lines/file)"
echo "  total: ${total_lines} lines across ${#app_css_files[@]} files"
sort -nr "$line_counts" | awk -v budget="$line_budget" '
  {
    note = ($1 > budget) ? "  over budget" : ""
    printf "  %5d %s%s\n", $1, $2, note
  }
'

echo
echo "css-inventory: files over budget"
if awk -v budget="$line_budget" '$1 > budget { found = 1; printf "  %5d %s\n", $1, $2 } END { exit found ? 0 : 1 }' "$line_counts"; then
  :
else
  echo "  none"
fi

mapfile -t linked_css_assets < <(
  rg --only-matching --replace '$1' 'assetPath "([^"]+\.css)"' Web/View/Layout.hs \
    | sed 's/^.*://' \
    | sort -u
)

mapfile -t makefile_css_files < <(
  rg --only-matching --replace '$1' '^CSS_FILES \+= (.+\.css)$' Makefile \
    | sed 's/^.*://' \
    | sort -u
)

makefile_has_entry() {
  local wanted="$1"
  local entry
  for entry in "${makefile_css_files[@]}"; do
    if [[ "$entry" == "$wanted" ]]; then
      return 0
    fi
  done
  return 1
}

for asset in "${linked_css_assets[@]}"; do
  asset_file="static${asset}"
  makefile_entry="static/${asset#/}"
  ihp_makefile_entry="\${IHP}/static/${asset#/}"

  if [[ ! -f "$asset_file" && "$asset" != "/vendor/flatpickr.min.css" ]]; then
    echo "$asset -> $asset_file" >> "$missing_assets"
  fi

  if ! makefile_has_entry "$makefile_entry" && ! makefile_has_entry "$ihp_makefile_entry"; then
    echo "$asset -> $makefile_entry" >> "$missing_makefile_entries"
  fi
done

echo
echo "css-inventory: Layout/Makefile CSS asset sync"
if [[ -s "$missing_assets" ]]; then
  echo "  missing local files:"
  sed 's/^/    /' "$missing_assets"
else
  echo "  linked local stylesheets exist"
fi

if [[ -s "$missing_makefile_entries" ]]; then
  echo "  missing Makefile CSS_FILES entries:"
  sed 's/^/    /' "$missing_makefile_entries"
else
  echo "  linked stylesheets are mirrored in Makefile CSS_FILES"
fi

echo
echo "css-inventory: raw colour warnings outside token/palette/bridge modules (first ${warning_limit})"
rg -n '#[0-9A-Fa-f]{3,8}|rgba?\(|hsla?\(' static \
  --glob '*.css' \
  --glob '!static/vendor/**' \
  --glob '!static/prod.css' \
  | rg -v '^(static/css/tokens\.css|static/css/palette\.css|static/css/bootstrap-bridge\.css):' \
  | head -n "$warning_limit" > "$raw_colors" \
  || true
if [[ -s "$raw_colors" ]]; then
  sed 's/^/  /' "$raw_colors"
else
  echo "  none"
fi

echo
echo "css-inventory: app/global/Bootstrap-like selectors inside feature stylesheets (first ${warning_limit})"
rg -n '^\s*[^{}@]*\.(app-[[:alnum:]_-]*|btn[[:alnum:]_-]*|form-[[:alnum:]_-]*|nav-[[:alnum:]_-]*|breadcrumb[[:alnum:]_-]*|table[[:alnum:]_-]*|dropdown[[:alnum:]_-]*|modal[[:alnum:]_-]*)' static/css/features \
  --glob '*.css' \
  | head -n "$warning_limit" > "$global_selectors" \
  || true
if [[ -s "$global_selectors" ]]; then
  sed 's/^/  /' "$global_selectors"
else
  echo "  none"
fi

echo
echo "css-inventory: simple class selectors with no Web/Application/static JS mention (first ${warning_limit})"
rg --no-filename --only-matching '\.[A-Za-z_][A-Za-z0-9_-]*' static \
  --glob '*.css' \
  --glob '!static/vendor/**' \
  --glob '!static/prod.css' \
  | sed 's/^\.//' \
  | sort -u \
  | while IFS= read -r class_name; do
      case "$class_name" in
        app|btn|btn-*|form-*|nav-*|navbar*|breadcrumb*|table*|dropdown*|modal*|container*|row|col|col-*|d-*|text-*|bg-*|border*|badge*|alert*|card*|list-*|input-*|w-*|h-*|m-*|p-*|gap-*|align-*|justify-*|shadow*|rounded*|small|visually-hidden)
          continue
          ;;
      esac

      if rg -q --fixed-strings "$class_name" Web Application static \
        --glob '!*.css' \
        --glob '!static/vendor/**' \
        --glob '!static/prod.css'; then
        continue
      fi

      first_source="$(rg -n --fixed-strings ".$class_name" static --glob '*.css' --glob '!static/vendor/**' --glob '!static/prod.css' | head -n 1)"
      printf '  .%-42s %s\n' "$class_name" "$first_source"
    done \
  | head -n "$warning_limit" > "$stale_candidates"
if [[ -s "$stale_candidates" ]]; then
  cat "$stale_candidates"
else
  echo "  none"
fi

echo
echo "css-inventory: warning-only architecture report; run bin/style-audit for hard gates."
exit 0
