#!/usr/bin/env bash
set -euo pipefail

fail() {
    echo "doc-drift-check: $*" >&2
    exit 1
}

require_text() {
    local file="$1"
    local text="$2"
    grep -Fq "$text" "$file" || fail "$file is missing expected text: $text"
}

reject_text() {
    local file="$1"
    local text="$2"
    if grep -Fq "$text" "$file"; then
        fail "$file contains obsolete text: $text"
    fi
}

nav_labels=(roster profile timesheets unavailability xero admin support logout)

for label in "${nav_labels[@]}"; do
    require_text AGENTS.md "\`$label\`"
    require_text Web/View/AGENTS.md "\`$label\`"
done
require_text Web/View/Layout.hs 'renderDesktopNavLink "unavailability"'
require_text Web/View/Layout.hs 'renderWhenAudience XeroAudience (renderDesktopNavLink "xero"'

require_text AGENTS.md 'frontend/ts/'
require_text AGENTS.md 'static/app*.js'
require_text AGENTS.md 'frontend/ts/generated/'
require_text AGENTS.md 'static/AGENTS.md'
require_text AGENTS.md 'frontend/AGENTS.md'
require_text README.md 'bash ./bin/in-env frontend-check'
require_text README.md 'frontend/ts/generated/'
require_text README.md 'devenv-script-freshness-check'
require_text Config/nix/flake/scripts.nix 'devenv-script-freshness-check = script ../scripts/dev/script-freshness-check;'
require_text Config/nix/scripts/verification/fast 'devenv-script-freshness-check'
require_text Config/nix/scripts/verification/full 'devenv-script-freshness-check'
require_text Application/Helper/FrontendContract/Surface/README.md 'single checked `SurfaceContractIR`'
require_text Application/Helper/FrontendContract/Surface/README.md 'Architecture Facts And Diagrams'
require_text Config/nix/scripts/frontend/contracts 'Application/Script/GenerateFrontendContracts.hs'
require_text Config/nix/scripts/frontend/contracts-check 'Application/Script/GenerateFrontendContracts.hs'
require_text Config/nix/scripts/frontend/surface-adapters 'Application/Script/GenerateFrontendSurfaceAdapters.hs'
require_text Config/nix/scripts/frontend/surface-adapters-check 'Application/Script/GenerateFrontendSurfaceAdapters.hs'
require_text README.md 'bash ./bin/in-env frontend-surface-adapters-check'
require_text Application/Helper/FrontendContract/README.md 'HaskellAdapter.Core'
require_text Application/Helper/FrontendContract/README.md 'all 52 actions and five intents'
require_text Application/Helper/FrontendContract/Surface/README.md '.Generated.Intent'
require_text Application/Helper/FrontendContract/Surface/README.md 'Exactly one checked home is registered'
require_text Application/Helper/FrontendContract/Surface/README.md 'All five intents have exactly one checked production home'
reject_text Application/Helper/FrontendContract/Surface/README.md 'Their homes remain explicitly staged empty for #187.'
reject_text Application/Helper/FrontendContract/Surface/README.md 'Action homes are empty and assigned to #186.'
reject_text Application/Helper/FrontendContract/Surface/README.md 'The GHC extractor loads this registry'
reject_text Config/nix/scripts/frontend/contracts 'GenerateFrontendContractsGhc'
reject_text Config/nix/scripts/frontend/contracts-check 'GenerateFrontendContractsGhc'
require_text frontend/AGENTS.md 'Vite dev server'
require_text static/AGENTS.md 'Do not edit generated'

for script in \
    app-bootstrap.js \
    app-date-pickers.js \
    app-dialog-overlays.js \
    app-horizontal-scroll.js \
    app-passkeys.js \
    app-live-updates.js \
    app-preferences.js \
    app-pwa.js \
    app-roster.js \
    app-scrollbars.js \
    app-time-picker.js \
    app-timesheets.js \
    app-toasts.js \
    app-toggle-buttons.js \
    app-xero.js
do
    require_text Web/View/Layout.hs "assetPath \"/$script\""
done

require_text Web/View/Layout.hs 'assetPath "/vendor/htmx-1.9.12/htmx.min.js"'
require_text Web/View/Layout.hs 'assetPath "/vendor/bootstrap-icons-1.11.3/bootstrap-icons.min.css"'

reject_text AGENTS.md 'https://unpkg.com'
reject_text AGENTS.md 'https://cdn.jsdelivr.net'
reject_text Web/View/AGENTS.md 'https://unpkg.com'
reject_text Web/View/AGENTS.md 'https://cdn.jsdelivr.net'

documentation_files=()
while IFS= read -r -d '' documentation_path; do
    case "$documentation_path" in
        .pi/*)
            continue
            ;;
    esac
    if [[ -f "$documentation_path" ]]; then
        documentation_files+=("$documentation_path")
    fi
done < <(git ls-files -z --cached --others --exclude-standard -- '*.md')
retired_frontend_terms=(
    'GenerateFrontendContractsGhc'
    'FrontendSurfaceGhc'
    'Surface.Ghc'
    'Surface.Adapter'
    'TypedLiveSurfaceDefinition'
    'typed-live'
    'data-live-update-surface'
    'IHP Auto Refresh'
    'ihp-auto-refresh'
    'Morphdom'
    'morphdom'
    'SurfaceProjection'
    'Application.Helper.Frontend.'
    'omnibus registry'
    'GHC probe'
    'GHC API extraction'
    'compiler-type inspection'
)
for term in "${retired_frontend_terms[@]}"; do
    matches="$(rg -n --fixed-strings "$term" "${documentation_files[@]}" || true)"
    if [[ -n "$matches" ]]; then
        fail $'retired frontend/runtime documentation term: '"$term"$'\n'"$matches"
    fi
done

require_text Web/View/AGENTS.md 'Dialog-style modals must go through `Application.Helper.View.Overlay`'

raw_modal_matches="$(
    rg -n 'class="modal|class="[^"]+ modal|modal-backdrop' Web Application -g'*.hs' \
        | grep -v '^Application/Helper/View/Overlay.hs:' \
        | grep -v '^Application/Helper/View/TimePicker.hs:' \
        || true
)"
if [[ -n "$raw_modal_matches" ]]; then
    fail $'raw dialog modal markup outside approved overlay/picker helpers:\n'"$raw_modal_matches"
fi

wage_matrix="specs/hospitality-award-wage-compliance-matrix.md"
wage_fixture_root="Test/Fixtures/wage-sources/2026-07-24"
require_text "$wage_matrix" '`HIGA-16.2-BREAK-6H`'
require_text "$wage_matrix" '`HIGA-29.2-EVENING-PART-HOUR`'
require_text "$wage_matrix" '`HIGA-29.4-PH-MIN-PERMANENT`'
require_text "$wage_matrix" '`HIGA-EXCL-OVERTIME`'
require_text "$wage_matrix" 'issue [#240]'
require_text "$wage_matrix" 'A **rate-only** source update flows through ingestion'
require_text "$wage_matrix" 'a mandatory review gate and does not block payroll'
require_text "$wage_fixture_root/README.md" 'Retrieval date: **2026-07-24 UTC**.'
require_text "$wage_fixture_root/README.md" 'CI and Hspec read these files directly and must not call the live services.'

for fixture_path in \
    "$wage_fixture_root/fwc-mapd/award.json" \
    "$wage_fixture_root/fwc-mapd/classifications.json" \
    "$wage_fixture_root/fwc-mapd/pay-rates.json" \
    "$wage_fixture_root/fwc-mapd/penalties.json" \
    "$wage_fixture_root/fwc-mapd/wage-allowances.json" \
    "$wage_fixture_root/datavic/public-holidays.json"
do
    [[ -f "$fixture_path" ]] || fail "missing deterministic wage-source fixture: $fixture_path"
done
(
    cd "$wage_fixture_root"
    sha256sum --check --status SHA256SUMS || fail "deterministic wage-source fixture hash mismatch"
)

while IFS= read -r pay_example; do
    require_text "$wage_matrix" "$pay_example"
done < <(sed -n 's/.*it "\([^"]*\)".*/\1/p' Test/PaySpec.hs)

scenario_duplicates="$(sed -n 's/^| `\(HIGA-[^`]*\)`.*/\1/p' "$wage_matrix" | sort | uniq -d)"
if [[ -n "$scenario_duplicates" ]]; then
    fail $'duplicate primary wage matrix scenario ids:\n'"$scenario_duplicates"
fi

echo "doc-drift-check: ok"
