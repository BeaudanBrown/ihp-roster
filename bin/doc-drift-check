#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$repo_root"

# Documentation checks own document topology, resolvable local references, and
# narrow retired-vocabulary tombstones. Production wiring, generated output,
# frontend boundaries, and wage authority belong to their architecture,
# generator, frontend, and domain gates.
node --test scripts/documentation/check.test.mjs >/dev/null
node scripts/documentation/check.mjs

echo "doc-drift-check: ok"
