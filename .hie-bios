#!/bin/sh
# Custom hie-bios wrapper for HLS.
# Filters out any in-repo IHP source paths to avoid conflicts with -package ihp.
make print-ghc-options GHC_RTS_FLAGS='' \
  | tr ' ' '\n' \
  | grep -vE '^-iIHP(/|$)' \
  | grep -vE '^-fbyte-code$' \
  > "$HIE_BIOS_OUTPUT"
case "$HIE_BIOS_ARG" in
  Application/Helper/FrontendSurface/Ghc/*.hs|*/Application/Helper/FrontendSurface/Ghc/*.hs|Application/Script/*Ghc*.hs|*/Application/Script/*Ghc*.hs)
    echo "-package" >> "$HIE_BIOS_OUTPUT"
    echo "ghc" >> "$HIE_BIOS_OUTPUT"
    ;;
esac
echo "$HIE_BIOS_ARG" >> "$HIE_BIOS_OUTPUT"
for path in Main.hs Config Application Web Test build/Generated; do
  [ -e "$path" ] || continue
  find "$path" -name '*.hs' \
    -not -name '*.sync-conflict*'
done >> "$HIE_BIOS_OUTPUT"
